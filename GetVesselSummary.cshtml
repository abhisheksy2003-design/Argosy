<script>
    function onEditClick(id) {

        $.ajax({
            url: "/BookingEntry/EditVesselSummary",
            type: "POST",
            data: JSON.stringify({ vesselID: id }),
            contentType: "application/json; charset=utf-8",
            success: function (message) {


                $("#summaryList_wrapper").hide();


                $("#UpdateVessel").show();

                $("#vesselName").val(message.VesselName);
                $("#isActive").prop("checked", message.IsActive);
                $("#vesselId").val(message.VesselID);
                $("#previousValue").val(message.VesselName);
            },
            error: function (err) {
                alert(err.responseText);
            }
        });
    }

    function getBack() {
        $("#UpdateVessel").hide();
        $("#summaryList_wrapper").show();
    }

</script>


<script>
    function UpdateVessel() {

        var vesselName = document.getElementById('vesselName').value;
        var vesselID = document.getElementById('vesselId').value;
        var isActive = document.getElementById("isActive").checked;

        if (!vesselID || vesselID === "0") {
            alert("Invalid Vessel ID");
            return;
        }

        $.ajax({
            url: "/BookingEntry/UpdateVesselDetails",
            type: "POST",
            contentType: "application/json; charset=utf-8",
            data: JSON.stringify({
                vesselID: parseInt(vesselID),
                vesselName: vesselName,
                isActive: isActive
            }),
            success: function (message) {
                if (message === true) {
                    alert("Vessel updated successfully!");
                    document.getElementById("currentValue").value = vesselName;

                    getBack();
                    window.location.reload();
                } else {
                    alert("Vessel updation failed. Try again!");
                }
            },

            error: function (err) {
                alert(err.responseText);
            }
        });
    }

</script>