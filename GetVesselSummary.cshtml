@model  IEnumerable<MvcBondEntities.BusinessEntities.Vessel>
@{
    ViewBag.Title = "GetVesselSummary";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}

@if (ViewBag.Message != null)
{
    <script type="text/javascript">
        window.onload = function () {

            var message = @Html.Raw(Json.Encode(ViewBag.Message))
            alert(message);
        };

    </script>
}


<div class=" content-area overflow-hidden" id="summaryList_wrapper">

    <div class="page-header">
        <h4 class="page-title">Vessel Summary: @Model.Count()</h4>


        <div class="page-header-breadcrumb">
            <button type="button" class="btn btn-primary waves-effect waves-light f-right d-inline-block md-trigger" onclick="window.location = '@Url.Action("NewVesselDetails", "BookingEntry" )' " id="addVvessel" data-modal="modal-13">
                Add
            </button>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12 col-lg-12">
            <div class="card">
                <div class="card-body">
                    <div class="table-responsive">
                        <table id="Vessel_Details" class="table table-striped table-bordered" style="width:100%">
                            <thead>
                                <tr>
                                    @*
                                        <th class="wd-15p sorting" style="width:1px;">#</th>*@
                                    <th class="wd-10p sorting">Vessel Name</th>
                                    <th style="width:30px">Action</th>
                                </tr>
                            </thead>
                            <tbody style="box-sizing :border-box;">
                                @foreach (var d in Model)
                                {
                                    <tr>
                                        @*
                                            <td>@Html.DisplayFor(m => d.VesselID)</td>*@
                                        <td>@Html.DisplayFor(m => d.VesselName)</td>

                                        <td> <a class="btn btn-outline-secondary me-2" onclick="onEditClick(@d.VesselID)" data-toggle="tooltip" data-placement="bottom" title="" data-original-title="Edit"><i class="fa fa-edit" style="color:white;"></i> </a></td>
                                    </tr>
                                }


                            </tbody>
                        </table>

                    </div>

                </div>
                <div>
                    <label id="previousValue" class="display_none"></label>
                    <label id="currentValue" class="display_none"></label>
                </div>
                <!-- table-wrapper -->
            </div>
            <!-- section-wrapper -->
        </div>
    </div>
</div>
<div>
    <input type="hidden" id="vesselId">
    <input type="hidden" id="previousValue">

</div>
<div id="UpdateVessel" style="display:none">
    <input type="hidden" id="vesselId" />

    <div class="content-area overflow-hidden" id="vesselupdate">

        <div class="page-header">
            <h4 class="page-title">
                Update Vessel
            </h4>

            <div class="page-header-breadcrumb">
                <button type="button" class="btn btn-primary waves-effect waves-light f-right d-inline-block md-trigger" onclick="getBack();" data-modal="modal-13">
                    Summary
                </button>
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-body">
                <div class="form-horizontal">
                    <div class="row">


                        <div class="col-lg-6 col-sm-12">
                            <div class="form-group">
                                <label class="form-label mandatory">Vessel Name</label>
                                <input id="vesselName" class="form-control" type="text">
                            </div>
                        </div>

                        <div class="col-lg-6 col-sm-12" style="margin-top:40px;">
                            <label class="custom-control custom-checkbox">
                         

                                <input id="isActive"
                                       type="checkbox"
                                       class="form-check-input"
                                       onchange="getActiveState(this.checked)">
                                <span class="custom-control-label">Is Active?</span>
                            </label>
                        </div>

                    </div>

                    <div class="col d-flex gap-2">
                        <!-- Save Button -->
                        <button id="Update" class="btn btn-save px-4" onclick="return UpdateVessel();" style="background-color: #FF9F43; color:white;">
                            Save
                        </button>

                        <!-- Clear Button -->
                        <button class="btn btn-cancel px-4" type="button" onclick="window.location.reload();">
                            Clear
                        </button>
                    </div>
                </div>
            </div>
             
        </div>
    </div>
</div>


<script>
        window.onload = function () {

            $('#Vessel_Details').DataTable({
                "bLengthChange": false,
                "bInfo": false,
                "bPaginate": true,
                "bFilter": true,
                "paging": true, // Enable pagination
                "pageLength": 10, // Set the number of records per page
                "order": [],
                "aoColumnDefs": [
                    {
                        'bSortable': false,
                        'aTargets': [0]
                    }
                ]
            });
        };

        $(document).ready(function () {
            //console.log(document.getElementById("isActive").checked)
            //$('#isActive').change(function () {

            //    if (document.getElementById("isActive").checked == true) {
            //        document.getElementById("isActive").checked = false;
            //    } else {
            //        document.getElementById("isActive").checked = true;
            //    }

            //});
        });

        function getActiveState(state) {
            document.getElementById("isActive").checked = state;
        }


        function getSummary() {

            $.ajax(
                {
                    url: '/BookingEntry/GetVesselSummary',
                    type: 'GET',
                    data: "",
                    contentType: 'application/json; charset=utf-8',
                    success: function (data) {
                        window.location = '@Url.Action("GetVesselSummary", "VesselSummary")'
                    },
                    error: function () {
                        alert("error");
                    }
                });
        }
</script>
