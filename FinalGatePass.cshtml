    }
    function GatePassGen(GPNo) {
        $("#divsummary").hide()
        $("#diventrysummary").show()
        $("#txtGPNo").val(GPNo);

        try {
            var data1 = { 'GPNo': GPNo };
            data = JSON.stringify(data1);
            $.ajax({
                url: "/BookingEntry/FinalGridSummary",
                data: data,
                type: "POST",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data) {
                    data = JSON.parse(data);


                    $("#TXtGPdate").val(data[0].GPDate);
                    $("#TxtCategory").val(data[0].Category);
                    $("#TxtValidUptoDate").val(data[0].ValidUpto);
                    $("#TxtDeliverty").val(data[0].DeliveryType);

                    $("#ddloutdateandtime").val(data[0].GPDate);

                    $('#tblsavedetails').dataTable({
                        "destroy": true,
                        "bLengthChange": false,
                        "bPaginate": false,
                        "bFilter": false,
                        "paging": false,
                        "aaData": data,
                        "columns": [
                            {

                                "data": "ContainerNo",
                                "render": function (data, type, row, meta) {
                                    data = '<input type=\"checkbox\" name=\"checklist[]\" class=\"checklist\" id=\"checklist\" checked  value="' + data + '">';
                                    return data;

                                }
                            },
                            { "data": "Jono" },
                            { "data": "ContainerNo" },
                            { "data": "CargoQty" },


                            {

                                "data": "VehicleNo",

                                "render": function (data, type, row, meta) {
                                    data = '<input type=\"textbox\" name=\"TxtVehicleno\" class=\"form-control\" id=\"TxtVehicleno\" style=\"width: 150px;text-transform:uppercase\"     value="' + data + '">';
                                    return data;

                                }
                            },
                            { "data": "Size" },




                        ]

                    })
                },
                error: function (errormessage) {
                    alert("error");
                    alert(errormessage.responseText);
                }
            });

        } catch (ex) {

        }
    }

