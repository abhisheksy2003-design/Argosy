<script>
    function Savedetails() {

        $("#global-loader").fadeIn("slow");
        var barcodeno = $("#TxtBarcodeno").val();
        var Gpno = $("#txtGPNo").val();
        var GPdate = $("#TXtGPdate").val();
        var Category = $("#TxtCategory").val();
        var validdate = $("#TxtValidUptoDate").val();
        var deliverytype = $("#TxtDeliverty").val();
        var InandOutdate = $("#ddloutdateandtime").val();




        var itemcount = checkItemcount();
        if (itemcount == false) {
            alert("No details selected for saving. Cannot proceed");
        }
        else {
            var checkboxarray = [];
            $('input[type=checkbox]').each(function () {
                if (this.checked) {

                    checkboxarray.push($(this).val());
                }
            });

            var tablearray = [];
            var table = document.getElementById("tblsavedetails");
            var row;
            for (var i = 1; i < table.rows.length; i++) {

                row = table.rows[i];

                for (var k = 0; k < checkboxarray.length; k++) {
                    var InvoiceNo = row.cells[2].innerText;
                    if (InvoiceNo == checkboxarray[k]) {
                        row = table.rows[i];
                        JoNo = row.cells[1].innerText;
                        ContainerNo = row.cells[2].innerText;
                        Size = row.cells[3].innerText;
                        VehicleNo = row.cells[4].childNodes[0].value;

                        /*if (VehicleNo == "") {
                            alert("Vehicle no cannot be left blank again container no " + ContainerNo + "");
                            $("#global-loader").fadeOut("slow");
                            return false;
                        }*/

                        Cargo = row.cells[5].innerText;
                        tablearray.push({
                            'JONo': JoNo, 'ContainerNo': ContainerNo, 'SIZE': Size,
                            'VehicleNo': VehicleNo,   'CargoQty': Cargo
                        })
                    }
                }
            }
            var data1 = {
                'Containerdetails': tablearray,   'Gpno': Gpno, 'Category': Category, 'validdate': validdate, 'deliverytype': deliverytype,
                'InandOutdate': InandOutdate, 'GPdate': GPdate
            };
            var data = JSON.stringify(data1);
            $.ajax({
                url: "/BookingEntry/SaveFinalOutConformation",
                data: data,
                type: "POST",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data) {
                    alert(data);
                    $("#global-loader").fadeOut("slow");
                     @*document.location = '@Url.Action("FinalOutConfirmations", "Gate")'*@
                      document.location = '@Url.Action("FinalGatePass", "BookingEntry")';
                },

                error: function (errormessage) {
                    alert(errormessage.responseText);
                    $("#global-loader").fadeOut("slow");
                }
            });

        }
    }


    function Clear() {
       @* document.location = '@Url.Action("FinalOutConfirmations", "Gate")';*@
        document.location = '@Url.Action("FinalGatePass", "BookingEntry")';
    }

    function checkItemcount() {

        var table = $('#tblsavedetails').DataTable();

        if (table.rows().count() == 0) {

            return false;
        }
        return true;

    }
</script>