
@{
    ViewBag.Title = "Carting Allow";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}

<style>
    table.table-bordered.dataTable tbody th, table.table-bordered.dataTable tbody td {
        color: black;
        font-weight: 900 !important;
        font-size: 15px !important;
    }
    .hiderow {
        display: none;
    }
</style>
<script src="~/js/sweet-alert.js"></script>
<script src="~/js/GetTableJsonwopaging.js"></script>
<script src="~/js/GetTableJson.js"></script>
<div class=" content-area" id="DIvCompantMaster" style="display:none">
    <div class="page-header" style="margin-top:-4px;">
        <h4 class="page-title" id="New">Export Caring Allow</h4>
        <div class="form-group">
            <label class="form-label"></label>
            <div class="row gutters-xs">
                <div class="col">
                    <button type="button" class="btn btn-success" title="Summary list" onclick="ViewSummary();">Summary</button>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-12 col-lg-12" style="margin-top:-25px;">
        <div class="row">
            <div class="card">
                <div class="card-body">
                    <div class="row">
                        <div class="col-lg-2 col-sm-3 ">
                            <div class="form-group">
                                <label class="form-label mandatory">SB No</label>
                                <div class="row gutters-xs">
                                    <div class="col">
                                        <input ID="txtSBNo" type="text" placeholder="New" class="form-control" readonly/>
                                        <input ID="txtID" type="hidden" class="form-control" />
                                        <input type="hidden" class="form-control" id="hdnCartingNo" />
                                        <input type="hidden" class="form-control" id="hdnSBEntryID" name="SbEntryID"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-2 col-sm-12">
                            <div class="form-group">
                                <label class="form-label mandatory">SB Date</label>
                                <div class="row gutters-xs">
                                    <div class="col">
                                        @Html.TextBox("txtSBDate", null, new { @class = "form-control datePicker1", @id = "txtSBDate", name = "txtSBDate", autocomplete = "on", @Value = DateTime.Now.ToString("dd MMM yyyy") })

                                    </div>
                                </div>
                            </div>
                        </div>
                      
                        <div class="col-lg-2 col-sm-12">
                            <div class="form-group">
                                <label class="form-label mandatory">SB Qty</label>
                                <div class="row gutters-xs">
                                    <div class="col">
                                        <input ID="txtSBQty" type="text" placeholder="SB Qty" class="form-control" readonly/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-2 col-sm-12">
                            <div class="form-group">
                                <label class="form-label mandatory">SB Weight</label>
                                <div class="row gutters-xs">
                                    <div class="col">
                                        <input ID="txtSBWeight" type="text" placeholder="SB Weight" class="form-control" readonly/>
                                    </div>
                                </div>
                            </div>
                        </div>
                         
                    </div>

                    <div class="row">
                       
                        <div class="col-lg-2 col-sm-12">
                            <div class="form-group">
                                <label class="form-label mandatory">Vehicle No</label>
                                <div class="row gutters-xs">
                                    <div class="col">
                                        <input ID="txtVehicelNo" type="text" placeholder="Vehicel No" class="form-control" />
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-2 col-sm-12">
                            <div class="form-group">
                                <label class="form-label mandatory">Carted Qty</label>
                                <div class="row gutters-xs">
                                    <div class="col">
                                        <input ID="txtCartedQty" type="number" placeholder="Carted Qty" class="form-control" />

                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-2 col-sm-12" >
                            <div class="form-group">
                                <label class="form-label mandatory">Carting Date</label>
                                <div class="row gutters-xs">
                                    <div class="col">
                                        @Html.TextBox("txtCartingDate", null, new { @class = "form-control datePicker1", @id = "txtCartingDate", name = "txtCartingDate", autocomplete = "on", @Value = DateTime.Now.ToString("dd MMM yyyy") })

                                    </div>
                                </div>
                            </div>
                        </div>


                        <div class="col-lg-3 col-sm-12" >
                            <div class="form-group">
                                <label class="form-label mandatory">Carting Equipment</label>
                                <div class="row gutters-xs">
                                    <div class="col">
                                        @Html.DropDownList("ddlCargingEquipment", (IEnumerable<SelectListItem>)ViewBag.Equipment, "--Select--", new { @class = "form-select", @id = "ddlCargingEquipment", name = "ddlCargingEquipment", autocomplete = "off" })
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <div class="col-md-1 col-xs-4">
                            <div class="form-group">
                                <label class="form-label mandatory" style="visibility:hidden">.</label>
                                <div class="row gutters-xs">
                                    <div class="col">
                                        <button class="btn btn-primary me-2" id="btnAdd" onclick="return Add();"><i class="fa fa-plus" aria-hidden="true"></i></button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                    </div>
                    <div class="row">
                        <div class="col-md-12 col-lg-12">
                            <div>
                                @*<label class="form-label">Details </label>*@
                            </div>
                            <div class="table-responsive">
                                <table class="table table-striped table-bordered" id="example" style="width:100%">
                                    <thead>
                                        <tr>
                                            <th class="wd-5p sorting">SB No</th>
                                            @*<th class="wd-15p sorting">SB Date</th>*@
                                            <th class="wd-10p sorting">SB Qty</th>
                                            <th class="wd-10p sorting">SB Weight</th>
                                            <th class="wd-10p sorting">Vehicel No</th>
                                            <th class="wd-10p sorting">Carted Qty</th>
                                            <th class="wd-10p sorting">Carting Date</th>
                                            <th class="wd-10p sorting">Carting Equipment</th>
                                            <th class="hiderow">CartingEquipmentID</th>
                                        </tr>
                                    </thead>
                                </table>
                            </div>
                        </div>
                    </div>

                    <div class="row p-2">
                        <div class="col-md-3 col-xs-12">
                            <div class="d-flex align-items-center">

                                <button class="btn btn-save px-4" id="btnSave" onclick="return Save(); " style="margin-right:10px">
                                    Save
                                </button>

                                <button class="btn btn-cancel px-4" id="btnCancel" onclick="Cancel();">
                                    Cancel
                                </button>

                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<div id="divCartingEntrySummary" style="margin-top:-5px;">
    <div class="page-header">
        <h4 class="page-title">SB Details </h4>
        <div class="form-group">
            <label class="form-label"></label>
            <div class="row gutters-xs">
                <div class="col">
                    <button type="button" class="btn btn-success" title="Summary list" onclick="ViewSummary();">Summary</button>
                </div>
            </div>
        </div>
        <!--<div class="ibox-content text-right">-->
        @*<a onclick="Addbutton();" class="btn btn-primary me-2 text-right" style="align-content:center;color:white"><i class="fa fa-plus" data-placement="bottom" title="Back"></i> </a>*@
        <!--<button type="button" class="btn btn-blue raised me-2" onclick="ManualUploadModel()">
            Upload Manual
        </button>
        <a onclick="GateInSummary();" class="btn btn-primary me-2 text-right" style="align-content:center;color:white">Summary </a>
    </div>-->
    </div>
    <div class="row" style="margin-top:-25px;">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <div class="table-responsive">
                        <table id="example3" class="table table-bordered table-hover display nowrap" style="width:100%">
                            <thead>
                                <tr></tr>
                            </thead>
                        </table>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<div class=" content-area" id="DivSummary" style="display:none">
    <div class="page-header">
        <h4 class="page-title">Carting Entry Summary</h4>
        <div class="ibox-content  text-right">
            <a onclick="getBack();" class="btn btn-added" style="color:white;align-content:center;">   Add</a>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12 col-lg-12">
            <div class="card">
                <div class="card-body">

                    <div class="row">
                        <div class="col-lg-2 col-sm-12">
                            <div class="form-group">
                                <label class="form-label">From Date <span class="text-danger">*</span></label>
                                <div class="row gutters-xs">
                                    <div class="col">
                                        @Html.TextBox("txtFromdate", null, new
                                        {
                                            @class = "form-control form_datetime1 ",
                                       @id = "txtFromdate",
                                            autocomplete = "off",
                                            @Value = DateTime.Now.ToString("dd MMM yyyy 00:00")
                                        })
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-2 col-sm-12">
                            <div class="form-group">
                                <label class="form-label">To Date <span class="text-danger">*</span></label>
                                <div class="row gutters-xs">
                                    <div class="col">
                                        @Html.TextBox("txtTodate", null, new
                                        {
                                            @class = "form-control form_datetime1 ",
                                       @id = "txtTodate",
                                            autocomplete = "off",
                                            @Value = DateTime.Now.ToString("dd MMM yyyy 23:59")
                                        })
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-2 col-sm-12">
                            <div class="form-group">
                                <label class="form-label" style="visibility:hidden">.</label>
                                <div class="row gutters-xs">
                                    <div class="col-2">
                                        <button type="button" class="btn btn-icon btn-filters"
                                                title="Show Summary" id="btnShow" onclick="ShowSummary()">
                                            <i class="fa fa-search"></i>
                                        </button>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="table-responsive">
                            <table class="table table-bordered table-hover tbl-cart text-nowrap" id="tblCartingEntrySummary"></table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>

    function getBack() {
        $("#DIvCompantMaster").show();
        $("#divCartingEntrySummary").hide();
        $("#DivSummary").hide();

    }

    function ViewSummary() {
        $("#DIvCompantMaster").hide();
        $("#divCartingEntrySummary").hide();
        $("#DivSummary").show();
        ShowSummary();
    }


    function Cancel() {
        location.reload();
    }

    function formatDate(d) {
        return new Date(d).toISOString();  
    }

    $(document).ready(function () {

        CartingEntryList();

    });

    function CartingEntryList() {
        $("#global-loader").fadeOut("slow");

        var SearchType = $("#TXtSearchOn").val();


        var data1 = { 'SearchType': SearchType };
        var data = JSON.stringify(data1);
        $.ajax({
            type: "POST",
            url: "/Export/CartingEntryList",
            data: data,
            contentType: "application/json; charset=utf-8",
            success: function (data) {

                $("#example3").empty();
                RepTableDataJson($("#example3"), data, "Carting Entry Details", "CartingEntry_List");
                $("#global-loader").fadeOut("slow");
            },

            error: function (response) {
                alert(response.responseText);
                $("#global-loader").fadeOut("slow");
            }
        })
    }

    function SelectEntry(ID,SBNo, SBdate, SBQty, SBWeight, CartingNo, EntryType, CHA, CHAId, CustomerId, Customer) {

        $("#txtSBNo").val(SBNo);
        $("#hdnSBEntryID").val(ID);
        $("#txtSBQty").val(SBQty);
        $("#txtSBWeight").val(SBWeight);
        console.log("SBdate", SBdate);
        let d = new Date(SBdate);
        let formatted = d.toLocaleDateString("en-GB", {
            day: "2-digit",
            month: "short",
            year: "numeric"
        }).replace(/ /g, " ");
        console.log("SBdate formatted", formatted);
        $("#txtSBDate").val(formatted);
        //$("#txtSBDate").val(SBdate);

        $("#hdnCartingNo").val(CartingNo);

        $("#divCartingEntrySummary").hide();
        $("#DIvCompantMaster").show();
        //$("#hdnJoNo").val(JoNo);
        //Addbutton();
        //ContainerFetch();
        //CartingEntryDetails();
    }

    function ShowSummary() {

        try {

            // Get values from input fields
            var fromDate = $("#txtFromdate").val();
            var toDate = $("#txtTodate").val();


            // Prepare data object
            var data = {
                fromDate: fromDate,
                toDate: toDate
            };

            $.ajax({
                url: "/Export/GetCartingAllowSummary",
                data: JSON.stringify(data),
                type: "POST",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (response) {

                    RepTableDataJsonwopaging($("#tblCartingEntrySummary"), response, "CreateSearch", "CreateSearch")
                },
                error: function (errormessage) {
                    alert("error");
                    alert(errormessage.responseText);
                }
            });

        } catch (ex) {

        }
    }

    var storeAddedItem = [];
    function Add() {
        debugger;

        var element = {};
        element.SBNo = $('#txtSBNo').val();
        //element.SBDate = $('#txtSBDate').val();
        element.SBQty = $('#txtSBQty').val();
        element.SBWeight = $('#txtSBWeight').val();
        element.VehicelNo = $('#txtVehicelNo').val();
        element.CartedQty = $('#txtCartedQty').val();
        element.CartingDate = $('#txtCartingDate').val();
        element.CartingEquipment = $("#ddlCargingEquipment option:selected").text();
        element.CartingEquipmentID = $('#ddlCargingEquipment').val();

        console.log("CartingEquipmentID:", element.CartingEquipmentID);
        console.log("CartingEquipment:", element.CartingEquipment);
       
         //Vehicle No
        if (element.VehicelNo === "") {
            alert("Please enter Vehicle No.");
            $('#txtVehicelNo').focus();
            return false;
        }

        // Carted Qty
        if (element.CartedQty === "" || element.CartedQty === "0") {
            alert("Please enter Carted Qty.");
            $('#txtCartedQty').focus();
            return false;
        }

        // Carting Date
        if (element.CartingDate === "") {
            alert("Please enter Carting Date.");
            $('#txtCartingDate').focus();
            return false;
        }


        storeAddedItem.push(element);

        $('#example').DataTable({
            "destroy": true,
            "bLengthChange": false,
            "aaData": storeAddedItem,
            "bPaginate": false,
            "bInfo": false,
            "paging": false,
            "columns": [

                { "data": "SBNo" },
                //{ "data": "SBDate" },
                { "data": "SBQty" },
                { "data": "SBWeight" },
               
                { "data": "VehicelNo" },
                { "data": "CartedQty" },
                { "data": "CartingDate"},

                { "data": "CartingEquipment"},
                { "data": "CartingEquipmentID", "className": "hiderow" },

            ]
        });

    }

function Save() {

    debugger
    var CartingNo = $("#hdnCartingNo").val();
    var SbEntryID = $("#hdnSBEntryID").val();
    var table = document.getElementById("example");

    if (table.rows.length <= 1) {
        alert("At least one record is required.");
        return false;
    }

    var SelectedData = [];

    for (var i = 1; i < table.rows.length; i++) {

        var row = table.rows[i];

        SelectedData.push({
            'SBNo': row.cells[0].innerText,
            //'SBDate': row.cells[1].innerText,
            //'SBQty': row.cells[1].innerText,
            //'SBWeight': row.cells[2].innerText,
            
            'VehicelNo': row.cells[3].innerText,
            'CartedQty': row.cells[4].innerText,
            'CartingDate': row.cells[5].innerText,
            'CartingEquipmentID': row.cells[7].innerText,
            
        });
    }

    var data1 = { 'Debitdata': SelectedData, 'CartingNo': CartingNo,'SbEntryID':SbEntryID };
    var data = JSON.stringify(data1);

    $.ajax({
        url: "/Export/SaveCartingAllow",
        data: data,
        type: "POST",
        contentType: "application/json; charset=utf-8",
        dataType: "json",
        success: function (data) {

            $('#btnSave').removeAttr('disabled', 'disabled');

            var array = data.split(',');
            var message = array[0];

            alert(message);

            if (message == "Record saved successfully") {
                document.location = '@Url.Action("CartingAllow", "Export")';
            }
        },
        error: function (errormessage) {
            alert(errormessage.responseText);
        }
    });

    }
    function PrintCartingEntry(CartingNo) {


        var data1 = { 'CartingNo': CartingNo };
        data = JSON.stringify(data1);

        $.ajax({
            url: '/Export/ExportPrintCartingEntry',
            type: 'Post',
            data: data,
            async: false,
            contentType: 'application/json; charset=utf-8',
            success: function (response) {

                var myWindow = window.open("", "MsgWindow1", 'width=' + screen.availWidth + ',height=' + screen.availHeight + ',resizable=no');
                myWindow.close();
                var myWindow = window.open("", "MsgWindow1", 'width=' + screen.availWidth + ',height=' + screen.availHeight + ',resizable=no');
                myWindow.document.write(response);
            },
            error: function (error) {
                let str = error.responseText;
                var a = str.indexOf("<title>") + 7;
                var b = str.indexOf("</title>");
                str = str.substring(a, b);
                alert("Something went wrong: " + str);
            }
        });
    };
    function CancelCartingEntry(cartingNo) {

        if (confirm("Are you sure you want to cancel this entry?")) {

            $.ajax({
                type: "POST",
                url: "/Export/CancelCartingEntry",
                data: { cartingNo: cartingNo },
                success: function (response) {

                    console.log("Response from server:", response);

                    if (response.status === "success") {
                        alert(response.message);
                        location.reload();        // ✔ Now this will work
                    } else {
                        alert("Error: " + response.message);
                    }
                },
                error: function (xhr) {
                    alert("Error: " + (xhr.responseText || "Something went wrong"));
                }
            });
        }
    }


</script>