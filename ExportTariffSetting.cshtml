<script>

     var storeAddedItemDetails = [];
     function AddTraiffSettingDetails() {


        var res = validateRemakrsFunction1();
        if (res == false) {
            return false;
         }
         $("#global-loader").fadeIn("slow");
        var tablearray = []
        var tablearray1 = []
        var DeliveryType = $("#ddldelivrtytype").val();

        var Type = $("#DDltype").val();
        for (var i = 0; i < DeliveryType.length; i++) {

            tablearray.push({
                'DeliveryType': DeliveryType[i]
            })
        }
        for (var j = 0; j < Type.length; j++) {

            tablearray1.push({
                'Type': Type[j]
            })
        }



        var TariffID = $("#TxtTraiffID").val();

        var From = $("#FromDate").val();
        var TO = $("#ToDate").val();
        var Accounting = $("#ddlaccountingHead option:selected").text();
        var AccountingID = $("#ddlaccountingHead option:selected").val();
        var Size = $("#ddlsize option:selected").text();

        var ChargesBased = $("#ddlchargesBasedOn option:selected").val();
        var FixedAmt = $("#TxtFixedamount").val();
        var Days = $("#TXtdays").val();
        var rate = $("#TxtRate").val();
        var Slabid = $("#TxtslabID").val();
        var ScanType = $("#TXtscantype option:selected").text();
        var Location = $("#ddllocation option:selected").text();
         var StuffLocation = $("#ddlstufflocation option:selected").text();
        var Jotype = $("#ddljotype option:selected").text();
        var Commodity = $("#ddlcommodity option:selected").text();
        var TransType = $("#ddlTranstype option:selected").text();
        var Port = $("#ddlport option:selected").text();
        var Insurance = $("#TxtInsurance").val();
         var TaxID = $("#TxtTAxid option:selected").val();
         var InvoiceType = $("#TxtInvoiceTYpe option:selected").text();
         var IsSplit = 0;
         if ($("#chkIsSplit").is(":checked")) {
             IsSplit = "1";

         }
         else {
             IsSplit = "0";

         }
        var data1 = {
            'TariffID': TariffID, 'From': From, 'TO': TO, 'Accounting': Accounting
            , 'Size': Size, 'ChargesBased': ChargesBased, 'FixedAmt': FixedAmt, 'Days': Days, 'rate': rate
            , 'Slabid': Slabid, 'ScanType': ScanType, 'Location': Location, 'StuffLocation': StuffLocation, 'Jotype': Jotype, 'Commodity': Commodity, 'TransType': TransType,
            'Port': Port, 'Insurance': Insurance, 'AccountingID': AccountingID, 'Type1': tablearray1, 'DeliveryType1': tablearray, 'TaxID': TaxID, 'InvoiceType': InvoiceType, 'IsSplit': IsSplit
        }
        var data = JSON.stringify(data1);





        $.ajax({
            url: "/Export/AjaxGetExportTariffDetailsForaddtable",
            data: data,
            type: "POST",
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (Data) {



                $('#example1').DataTable({
                    "destroy": true,
                    "bLengthChange": false,
                    "aaData": Data,
                    "bPaginate": true,
                    "bInfo": true,
                    "paging": true,
                    "columns": [
                    {
                            "data": "Entryid",
                            "render": function (data, type, row, meta) {
                                if (type === 'display') {

                                    data = '<a   href="#" class="btn btn-sm btn-danger removebutton" name="removebutton"  title="Edit" onclick="CancelItem(' + row.TariffID + ')"><i class="fa fa-trash"></i></a>';
                                }

                                return data;
                            }


                        },
                        { "data": "TariffID" },
                        { "data": "DeliveryType" },
                        { "data": "From" },
                        { "data": "TO" },
                        { "data": "Accounting" },
                        { "data": "Size" },
                        { "data": "Type" },
                        { "data": "Ftype" },
                        { "data": "Slabid" },
                        { "data": "FixedAmt" },
                        { "data": "Insurance" },
                        { "data": "rate" },
                        { "data": "Days" },
                        { "data": "Tax" },
                        { "data": "InvoiceType" },
                        { "data": "CurrencyType" },
                        { "data": "TransType" },
                        { "data": "Port" },
                        { "data": "Freedays" },
                        { "data": "Location" },
                        { "data": "StuffLocation" },
                        { "data": "Jotype" },
                        { "data": "ScanType" },
                        { "data": "AccountingID" },
                        { "data": "IsSplit" },

                    ]
                });

                $("#TxtFixedamount").val('');
                $("#TxtslabID").val('');

                $("#global-loader").fadeOut("slow");
            },
            error: function (error) {
                let str = error.responseText;
                var a = str.indexOf("<title>") + 7;
                var b = str.indexOf("</title>");
                str = str.substring(a, b);
                alert("Something went wrong: " + str);
                $("#global-loader").fadeOut("slow");

            }
        });
    }




    function validateRemakrsFunction()

    {
        var TariffIDValidate = document.getElementById('TxtTraiffID').value;
        var DeliveryTYpe = document.getElementById('ddldelivrtytype').value;
        var Accounting = document.getElementById('ddlaccountingHead').value;
        var Location = document.getElementById('ddllocation').value;





        document.getElementById("TxtTraiffID").style.borderColor = "gainsboro";
        document.getElementById("ddldelivrtytype").style.borderColor = "gainsboro";
        document.getElementById("ddlaccountingHead").style.borderColor = "gainsboro";
        document.getElementById("ddllocation").style.borderColor = "gainsboro";

        var blResult = Boolean;
        blResult = true;

        if (TariffIDValidate == "") {
            document.getElementById("TxtTraiffID").style.borderColor = "red";
        blResult = blResult && false;
        }
        if (DeliveryTYpe == "") {
            document.getElementById("ddldelivrtytype").style.borderColor = "red";
            blResult = blResult && false;
        }
        if (Accounting == "") {
            document.getElementById("ddlaccountingHead").style.borderColor = "red";
            blResult = blResult && false;
        }
        //if (Location == "") {
        //    document.getElementById("ddllocation").style.borderColor = "red";
        //    blResult = blResult && false;
        //}

     if (blResult == false) {alert('Please fill the required fields!'); }
     return blResult;
     };


     function validateRemakrsFunction1() {
         var TariffIDValidate = document.getElementById('TxtTraiffID').value;
         var DeliveryTYpe = document.getElementById('ddldelivrtytype').value;
         var Accounting = document.getElementById('ddlaccountingHead').value;
         var Typevalidate = document.getElementById('DDltype').value;


         document.getElementById("TxtTraiffID").style.borderColor = "gainsboro";
         document.getElementById("ddldelivrtytype").style.borderColor = "gainsboro";
         document.getElementById("ddlaccountingHead").style.borderColor = "gainsboro";
         document.getElementById("DDltype").style.borderColor = "gainsboro";
         var blResult = Boolean;
         blResult = true;

         if (TariffIDValidate == "") {
             document.getElementById("TxtTraiffID").style.borderColor = "red";
             blResult = blResult && false;
         }
         if (DeliveryTYpe == "") {
             document.getElementById("ddldelivrtytype").style.borderColor = "red";
             blResult = blResult && false;
         }
         if (Accounting == "") {
             document.getElementById("ddlaccountingHead").style.borderColor = "red";
             blResult = blResult && false;
         }
         if (Typevalidate == "") {
             document.getElementById("DDltype").style.borderColor = "red";
             blResult = blResult && false;
         }
         if (blResult == false) { alert('Please fill the required fields!'); }
         return blResult;
     };





    function SaveExportTariffSetting() {

        $("#global-loader").fadeIn("slow");
        var SelectedData = [];
        var table = document.getElementById("example1");
        var commodity = $("#ddlcommodity").val();
        var Fromdate = $("#FromDate").val();
        var Todate = $("#ToDate").val();
        var row;
        for (var i = 1; i < table.rows.length; i++) {

            row = table.rows[i];
            TariffID = row.cells[1].innerText;
            DeliveryType = row.cells[2].innerText;
            From = row.cells[3].innerText;
            TO = row.cells[4].innerText;
            Accounting = row.cells[5].innerText;
            Size = row.cells[6].innerText;
            Type = row.cells[7].innerText;
            Ftype = row.cells[8].innerText;
            Slabid = row.cells[9].innerText;
            FixedAmt = row.cells[10].innerText;
            Insurance = row.cells[11].innerText;
            rate = row.cells[12].innerText;
            Days = row.cells[13].innerText;
            Tax = row.cells[14].innerText;
            InvoiceType = row.cells[15].innerText;
            CurrencyType = row.cells[16].innerText;
            TransType = row.cells[17].innerText;
            Port = row.cells[18].innerText;
            Freedays = row.cells[19].innerText;
            Location = row.cells[20].innerText;
            StuffLocation = row.cells[21].innerText;
            Jotype = row.cells[22].innerText;
            ScanType = row.cells[23].innerText;
            AccountingID = row.cells[24].innerText;
            IsSplit = row.cells[25].innerText;
            SelectedData.push({
                'TariffID': TariffID, 'DeliveryType': DeliveryType, 'From': From,
                'TO': TO, 'Accounting': Accounting, 'Size': Size, 'Type': Type, 'Ftype': Ftype, 'Slabid': Slabid, 'FixedAmt': FixedAmt, 'Insurance': Insurance,
                'rate': rate, 'Days': Days, 'Tax': Tax, 'InvoiceType': InvoiceType, 'CurrencyType': CurrencyType, 'TransType': TransType, 'Port': Port, 'Freedays': Freedays,
                'Location': Location, 'StuffLocation': StuffLocation, 'Jotype': Jotype, 'ScanType': ScanType, 'AccountingID': AccountingID, 'IsSplit': IsSplit
            })
        }

        var data1 = { 'ImportData': SelectedData, 'commodity': commodity, 'Fromdate': Fromdate, 'Todate': Todate};
        var data = JSON.stringify(data1);

        $.ajax({
            url: "/Export/SaveExportTariffSettingDetails",
            data: data,
            type: "POST",
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (Data) {



                alert(Data);
                document.location = '@Url.Action("ExportTariffSetting", "Export")';



                $("#global-loader").fadeOut("slow");
            },
            error: function (error) {
                let str = error.responseText;
                var a = str.indexOf("<title>") + 7;
                var b = str.indexOf("</title>");
                str = str.substring(a, b);
                alert("Something went wrong: " + str);
                $("#global-loader").fadeOut("slow");
            }
        });

    }

    function checkItemcount() {

        var table = $('#example1').DataTable();

        if (table.rows().count() == 0) {

            return true;
        }
        return false;

    }
</script>
