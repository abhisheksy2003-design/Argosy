                    };
                });

                let updatedJson = JSON.stringify(finalRows);

                $("#example").empty();
                RepTableDataJson($("#example"), updatedJson, "Carting Entry Details", "CartingEntry_List");
                $("#global-loader").fadeOut("slow");
            },
            error: function (response) {
                alert(response.responseText);
                $("#global-loader").fadeOut("slow");
            }
        })
    }

    // Auto Calculate Tally Weight Based on Tally Qty
    $(document).on("input", ".tallyQty", function () {

        let row = $(this).closest("tr");

        let tallyQty = parseFloat($(this).val()) || 0;

        // Get SBQty and SBWeight from table cells
        let sbQty = parseFloat(row.find("td:eq(3)").text()) || 0;
        let sbWeight = parseFloat(row.find("td:eq(4)").text()) || 0;

        // Calculate weight per unit
        let weightPerQty = sbQty > 0 ? (sbWeight / sbQty) : 0;

        // Calculate Tally Weight
        let tallyWeight = tallyQty * weightPerQty;

        // Set value in Tally Weight input
        row.find(".tallyWeight").val(tallyWeight.toFixed(2));
    });


