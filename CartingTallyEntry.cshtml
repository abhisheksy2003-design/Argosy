    function AddDetails() {
        debugger;

        var AGName = $("#ddlCustomer").val();

        // --- Customer Validation ---
        if (AGName === "" || AGName === "0" || AGName == null) {
            alert("Please select Customer.");
            $("#ddlCustomer").focus();
            return false;
        }

        // If Customer has value → CheckName call
        if (AGName !== "") {
            var Name = $("#ddlCustomer").val();
            var Type = 'Customer';
            CheckName(Type, Name);
            return false;
        }

        // --- CHA Validation ---
        var CHAName = $("#ddlCHA").val();

        if (CHAName === "" || CHAName === "0" || CHAName == null) {
            alert("Please select CHA.");
            $("#ddlCHA").focus();
            return false;
        }

        // If CHA has value → CheckName call
        if (CHAName !== "") {
            var Name = $("#ddlCHA").val();
            var Type = 'CHA';
            CheckName(Type, Name);
            return false;
        }
    }

    function CheckName(Type, Name) {


        var data1 = { 'Type': Type, 'Name': Name };
        var data = JSON.stringify(data1);

        $.ajax({
            url: "/BookingEntry/CheckName",
            data: data,
            type: "POST",
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (Data) {



                if (Data != "") {
                    alert(Data);
                    return false;
                }
                else {
                    Add()
                }


            },
            error: function (error) {
                let str = error.responseText;
                var a = str.indexOf("<title>") + 7;
                var b = str.indexOf("</title>");
                str = str.substring(a, b);
                alert("Something went wrong: " + str);
            }
        });
    }

    function Save() {

    debugger;

    // ---------------------- ENTRY TYPE VALIDATION ----------------------
    var entryType = $("#ddlEntryType").val();
    var cartingAllowID = parseInt($("#hdnCartingAllowID").val()) || 0;
    console.log(cartingAllowID);
    if (!entryType || entryType === "0") {
        alert("Please select Entry Type.");
        $("#ddlEntryType").focus();
        return false;
    }

    // ---------------------- TABLE VALIDATION ----------------------
    var table = document.getElementById("example");

    if (table.rows.length <= 1) {
        alert("At least one record is required.");
        return false;
    }

    var SelectedData = [];

    for (var i = 1; i < table.rows.length; i++) {

        var row = table.rows[i];

        // Read Input Fields Properly
        var tallyQty = $(row).find(".tallyQty").val();
        var tallyWeight = $(row).find(".tallyWeight").val();
        var tallyArea = $(row).find(".tallyArea").val();

        // If user leaves empty → set to 0
        tallyQty = tallyQty ? tallyQty : 0;
        tallyWeight = tallyWeight ? tallyWeight : 0;

        //Hidden Fields
        var chaId = $(row).find(".hdnCHAID").val();
        var customerId = $(row).find(".hdnCustomerID").val();
        

        SelectedData.push({

            'CartingNo': row.cells[0].innerText,
            'SBNo': row.cells[1].innerText,
            'SBDate': row.cells[2].innerText,
            'SBQty': row.cells[3].innerText,
            'SBWeight': row.cells[4].innerText,
            'VehicelNo': row.cells[5].innerText,
            'CartedQty': row.cells[6].innerText,
            
            // Inputs
            'TallyQty': tallyQty,       
            'TallyWeight': tallyWeight, 
            'Area': tallyArea,          

            'CartingDate': row.cells[10].innerText,
            'Customer': row.cells[11].innerText,
            'CHA': row.cells[12].innerText,

            'CHAID': chaId,           // hidden value
            'CustomerID': customerId, // hidden value
            'CartingAllowID': cartingAllowID,

            'CargoDescrition': row.cells[15].innerText,
            'CargoTypeID': row.cells[16].innerText,
            'EquipmentID': row.cells[17].innerText,
            'ContainerNo': row.cells[18].innerText,
            'Size': row.cells[19].innerText,
            'Type': row.cells[20].innerText,
            'Remarks': row.cells[21].innerText,
            'EntryType': entryType,
            'UANNo': row.cells[22].innerText,
            'Class': row.cells[23].innerText,
            'PackingGroupID': row.cells[24].innerText,
            'PackageTypeID': row.cells[25].innerText
        });

    }

    var data1 = { 'Debitdata': SelectedData, 'EntryType': entryType, 'CartingAllowID': cartingAllowID };
    var data = JSON.stringify(data1);

    $.ajax({
        url: "/Export/SaveCartingTally",
        data: data,
        type: "POST",
        contentType: "application/json; charset=utf-8",
        dataType: "json",
        success: function (data) {

            $('#btnSave').removeAttr('disabled', 'disabled');

            var array = data.split(',');
            var message = array[0];

            alert(message);

            if (message === "Record saved successfully") {
                document.location = '@Url.Action("CartingTallyEntry", "Export")';
            }
        },
        error: function (errormessage) {
            alert(errormessage.responseText);
        }
    });
}



