    function CancelCartingTallyEntry(ID) {

        if (confirm("Are you sure you want to cancel this entry?")) {

            $.ajax({
                type: "POST",
                url: "/Export/CancelCartingTallyEntry",
                data: { ID: ID },
                success: function (response) {

                    if (response.status === "success") {
                        alert(response.message);
                        location.reload();
                    } else {
                        alert("Error: " + response.message);
                    }
                },
                error: function (xhr) {
                    alert("Error: " + (xhr.responseText || "Something went wrong"));
                }
            });
        }
    }


