<script>
    function ViewSummary() {

        $("#DIvCompantMaster").hide();
        $("#divCartingEntrySummary").hide();
        $("#DivSummary").show();
        ShowSummary();
    }

    function getBack() {
        $("#divCartingEntrySummary").show();
        $("#DIvCompantMaster").hide();
        $("#DivSummary").hide();
    }

    function GateInBack() {
        $("#divCartingEntrySummary").show();
        $("#DIvCompantMaster").hide();
        $("#DivSummary").hide();

    }

    function formatDate(d) {
        return new Date(d).toISOString();  // gives yyyy-MM-ddTHH:mm:ss
    }

    function ShowSummary() {

        try {

            // Get values from input fields
            var fromDate = $("#txtFromdate").val();
            var toDate = $("#txtTodate").val();

            // Prepare data object
            var data = {
                fromDate: fromDate,
                toDate: toDate
            };

            $.ajax({
                url: "/Export/GetCartingTallyEntrySummary",
                data: JSON.stringify(data),
                type: "POST",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (response) {

                    RepTableDataJsonwopaging($("#tblCartingTallyEntrySummary"), response, "CreateSearch", "CreateSearch")
                },
                error: function (errormessage) {
                    alert("error");
                    alert(errormessage.responseText);
                }
            });

        } catch (ex) {

        }
    }

    function SelectEntry(ID,SBNo, SBdate, CartingNo, EntryType, CHA, CHAId, CustomerId, Customer) {

        $("#txtSBNo").val(SBNo);
        $("#hdnCartingAllowID").val(ID);
        console.log("SBdate", SBdate);
        let d = new Date(SBdate);
        let formatted = d.toLocaleDateString("en-GB", {
            day: "2-digit",
            month: "short",
            year: "numeric"
        }).replace(/ /g, " ");
        console.log("SBdate formatted", formatted);
        $("#txtSBDate").val(formatted);
        //$("#txtSBDate").val(SBdate);

        $("#ddlEntryType").val(EntryType);
        $("#hdnCartingNo").val(CartingNo);

        $("#ddlCHA").val(CHA);
        $("#ddlCustomer").val(Customer);
        $("#hdnCHAId").val(CHAId);
        $("#hdnCustomerId").val(CustomerId);
        $("#divCartingEntrySummary").hide();
        $("#DIvCompantMaster").show();
        //$("#hdnJoNo").val(JoNo);
        //Addbutton();
        //ContainerFetch();
        CartingEntryDetails();
    }
    $(document).ready(function () {

        CartingAllowList();

    });

    function CartingAllowList() {
        $("#global-loader").fadeOut("slow");

        var SearchType = $("#TXtSearchOn").val();


        var data1 = { 'SearchType': SearchType };
        var data = JSON.stringify(data1);
        $.ajax({
            type: "POST",
            url: "/Export/CartingAllowList",
            data: data,
            contentType: "application/json; charset=utf-8",
            success: function (data) {

                $("#example3").empty();
                RepTableDataJson($("#example3"), data, "Carting Entry Details", "CartingEntry_List");
                $("#global-loader").fadeOut("slow");
            },

            error: function (response) {
                alert(response.responseText);
                $("#global-loader").fadeOut("slow");
            }
        })
    }

    function CartingEntryDetails() {
        $("#global-loader").fadeOut("slow");

        var SearchType = $("#hdnCartingNo").val();
        console.log("CartingEntryDetails: ", SearchType);

        var data1 = { 'SearchType': SearchType };
        var data = JSON.stringify(data1);
        $.ajax({
            type: "POST",
            url: "/Export/CartingEntryDetails",
            data: data,
            contentType: "application/json; charset=utf-8",
            //success: function (data) {

            //    $("#example").empty();
            //    RepTableDataJson($("#example"), data, "Carting Entry Details", "CartingEntry_List");
            //    $("#global-loader").fadeOut("slow");
            //},
            success: function (data) {

                let rows = JSON.parse(data);

                // Build rows in correct order
                let finalRows = rows.map(r => {
                    return {

                        CartingNo: r.CartingNo,
                        SBNo: r.SBNo,
                        SBDate: r.SBDate,
                        SBQty: r.SBQty,
                        SBWeight: r.SBWeight,
                        VehicelNo: r.VehicelNo,
                        CartedQty: r.CartedQty,

                        TallyQty: `<input type='number' class='form-control tallyQty'
                            data-cartingno='${r.CartingNo}' data-sbno='${r.SBNo}' style='width:100px;'/>`,
                        TallyWeight: `<input type='number' class='form-control tallyWeight'
                            data-cartingno='${r.CartingNo}' data-sbno='${r.SBNo}' style='width:100px;'/>`,
                        // Insert Input Fields EXACTLY HERE
                        Area: `<input type='number' class='form-control tallyArea'
                            data-cartingno='${r.CartingNo}' data-sbno='${r.SBNo}' style='width:120px;'/>`,

                       
                        // Continue remaining SP columns
                        CartingDate: r.CartingDate,

                        Customer: r.Customer,
                        CHA: r.CHA,
                        CHAID: `<input type='hidden' class='hdnCHAID' value='${r.CHAID}' />`,
