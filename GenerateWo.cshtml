
@{
    ViewBag.Title = "ItemMaster";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}

<style>
    .table thead th, .text-wrap table thead th {
        background-color: #151517b5;
        color: white;
    }

    table.table-bordered.dataTable tbody th, table.table-bordered.dataTable tbody td {
        color: black;
        font-weight: 900 !important;
        font-size: 15px !important;
    }
    .hiderow {
        display: none;
    }
</style>
<script src="~/js/GetTableJsonwopaging.js"></script>
<div class=" content-area" id="DIvCompantMaster">
    <div class="page-header">

        <h4 class="page-title" id="New">SSR Work Order</h4>
        <ol class="breadcrumb" style="background-color: #FAFBFE">
            <li class="breadcrumb-item">
                <a onclick="ShowSummary();" id="ShowSummary" class="btn btn-josph btn-success" style="color:white;align-content:center;"><i class="fa fa-file-text" data-toggle="tooltip" data-placement="bottom" title="Summary" data-original-title="Back"></i>  </a>
            </li>
        </ol>
    </div>

    <div class="col-sm-12 col-lg-12">
        <div class="row">
            <div class="card">
               
                <div class="card-body">
                    
                    <div class="row">
                        <div class="col-lg-2 col-sm-12">
                            <div class="form-group">
                                <label class="form-label mandatory">Wo No</label>
                                <div class="row gutters-xs">
                                    <div class="col">
                                        <input ID="txtWoNo" type="text" placeholder="New" readonly="readonly" class="form-control" />
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-2 col-sm-12">
                            <div class="form-group">
                                <label class="form-label mandatory">Wo Date</label>
                                <div class="row gutters-xs">
                                    <div class="col">
                                        @Html.TextBox("txtWoDate", null, new { @class = "form-control form_datetime1", @id = "txtWoDate", name = "txtWoDate", @readonly = true, autocomplete = "on", @Value = DateTime.Now.ToString("dd MMM yyyy hh:mm") })

                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-2 col-sm-3">
                            <div class="form-group label-floating">

                                <div class="col">
                                    <label class="form-label">Wo Type</label>
                                    @Html.DropDownList("ddlWotype", (IEnumerable<SelectListItem>)ViewBag.ItemGroup, "--Select--", new { @class = "form-control form-control-lg", @id = "ddlWotype", name = "ddlWotype", autocomplete = "off", onblur = "SBNoEntry()" })
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-2 col-sm-3">
                            <div class="form-group label-floating">
                                <label class="form-label">Wo On</label>
                                @Html.DropDownList("ddlWoOn", new List<SelectListItem>
                                {

                                  new SelectListItem { Text = "SB No", Value = "SB No"},
                                new SelectListItem { Text = "Container", Value = "Container"},
                                  }, "Select", new { @class = "form-control form-control-lg", autocomplete = "off", @id = "ddlWoOn" , onblur = "ChangeSize()" })
                            </div>
                        </div>
                        <div class="col-lg-4 col-sm-12">
                            <div class="form-group">
                                <label class="form-label">Customer</label>

                                <div class="row gutters-xs">
                                    <div class="col">
                                        <input type="text" placeholder="Customer" class="form-control" id="ddlCustomer" />
                                        <input type="hidden" class="form-control" id="ddlCustomerId" />
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        
                        <div class="col-lg-4 col-sm-12">
                            <div class="form-group">
                                <label class="form-label">CHA</label>

                                <div class="row gutters-xs">
                                    <div class="col">
                                        <input type="text" placeholder="CHA" class="form-control" id="ddlCHA" />
                                        <input type="hidden" class="form-control" id="ddlCHAId" />
                                    </div>

                                </div>
                            </div>
                        </div>
                        <div class="col-lg-4 col-sm-12">
                            <div class="form-group">
                                <label class="form-label">Exporter</label>

                                <div class="row gutters-xs">
                                    <div class="col">
                                        <input type="text" placeholder="Exporter" class="form-control" id="ddlExporter" />
                                        <input type="hidden" class="form-control" id="ddlExporterId" />
                                    </div>

                                </div>
                            </div>
                        </div>
                        <div class="col-lg-4 col-sm-12">
                            <div class="form-group">
                                <label class="form-label">Forwarder</label>

                                <div class="row gutters-xs">
                                    <div class="col">
                                        <input type="text" placeholder="Forwarder" class="form-control" id="ddlForwarder" />
                                        <input type="hidden" class="form-control" id="ddlForwarderId" />
                                    </div>

                                </div>
                            </div>
                        </div>
                        <div class="col-lg-2 col-sm-2">
                            <div class="form-group">
                                <label class="form-label" id="lblName"></label>
                                @Html.TextBox("txtSBNoandContainerno", null, new { @class = "form-control", @id = "txtSBNoandContainerno", name = "txtSBNoandContainerno", autocomplete = "off" })
                            </div>
                        </div>
                        <div class="col-lg-2 col-sm-6" id="divSize">
                            <div class="form-group">
                                <label class="form-label">Size</label>
                                <div class="row gutters-xs">
                                    <div class="col">
                                        <select class="form-control form-control-lg" id="ddlsize">
                                            <option value="0">--Select--</option>
                                            <option value="20">20</option>
                                            <option value="40">40</option>
                                            <option value="45">45</option>

                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-6 col-sm-12">
                            <div class="form-group">
                                <label class="form-label">Item Desc</label>
                                <div class="row gutters-xs">
                                    <div class="col">
                                        <select id="txtItem" class="form-control form-control-lg" onchange="OnItemDesc();">
                                            <option value="">--Select--</option>
                                        </select>
                                        <input type="hidden" class="form-control" id="ddlItemID" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                   

                    <div class="row">
                        <div class="col-lg-2 col-sm-3">
                            <div class="form-group">
                                <label class="form-label mandatory">Tariff</label>
                                <div class="row gutters-xs">
                                    <div class="col">
                                        @Html.DropDownList("txtTariff", (IEnumerable<SelectListItem>)ViewBag.TariffSetting, "--Select--", new { @class = "form-control form-control-lg", @id = "txtTariff", name = "txtTariff", autocomplete = "off", onblur = "Entry()" })

                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-4 col-sm-12">
                            <div class="form-group">
                                <label class="form-label mandatory">GST Party Name</label>
                                <div class="row gutters-xs">
                                    <div class="col">
                                        <input id="txtGSTPartyName" type="text" class="form-control" readonly="readonly" />
                                        <input type="hidden" class="form-control" id="lblstatecode" />
                                        <input type="hidden" class="form-control" id="lblpartyid" />
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-1 col-xs-4">
                            <div class="form-group">
                                <label class="form-label mandatory" style="visibility:hidden">.</label>
                                <div class="row gutters-xs">
                                    <div class="col">
                                        <button class="btn btn-gradient-primary me-2" data-toggle="modal" data-target="#largeModal" onclick="OpenTariffDetails();"><i class="fa fa-search" aria-hidden="true"></i></button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-3 col-sm-12">
                            <div class="form-group">
                                <label class="form-label mandatory">GST No</label>
                                <div class="row gutters-xs">
                                    <div class="col">
                                        <input id="txtGSTNo" type="text" class="form-control" readonly="readonly" />
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-2 col-sm-2">
                            <div class="form-group">
                                <label class="form-label">Rate</label>
                                @Html.TextBox("txtRate", null, new { @class = "form-control", @id = "txtRate", name = "txtRate", autocomplete = "off", @readonly = "readonly" })
                            </div>
                        </div>
                        <div class="col-lg-2 col-sm-2">
                            <div class="form-group">
                                <label class="form-label">Additional Amount</label>
                                @Html.TextBox("txtAdditionalAmount", null, new { @class = "form-control", @id = "txtAdditionalAmount", name = "txtAdditionalAmount", autocomplete = "off" })
                            </div>
                        </div>
                        <div class="col-lg-2 col-sm-2">
                            <div class="form-group">
                                <label class="form-label">Qty</label>
                                @Html.TextBox("txtqty", null, new { @class = "form-control", @id = "txtqty", name = "txtqty", autocomplete = "off" })
                            </div>
                        </div>

                        <div class="col-md-1">
                            <label class="form-label">.</label>
                            <button class="btn btn-success float-right" id="Save" onclick="Add()" title="Save">Add</button>

                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12 col-lg-12">
                            <div>
                                @*<label class="form-label">Details </label>*@
                            </div>
                            <div class="table-responsive">
                                <table class="table table-striped table-bordered" id="example" style="width:100%">
                                    <thead>
                                        <tr>



                                            <th class="wd-5p sorting">SB No/Container No</th>
                                            <th class="wd-15p sorting">Size</th>
                                            <th class="wd-10p sorting">Item</th>
                                            <th class="wd-10p sorting">Rate</th>
                                            <th class="wd-10p sorting">Tariff</th>
                                            <th class="hiderow">GST Party Name</th>
                                            <th class="hiderow">GST No</th>
                                            <th class="wd-10p sorting">Additional Amount</th>
                                            <th class="wd-10p sorting">Qty</th>
                                            <th class="hiderow">ItemID</th>
                                            <th class="hiderow">TariffID</th>
                                            <th class="hiderow">GSTD</th>
                                        </tr>
                                    </thead>
                                </table>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <button class="btn btn-success float-right" id="Save" onclick="Save()" title="Save"><i class="fa fa-save"></i></button>

                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>
<div id="largeModal" class="modal fade">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content ">
            <div class=" content-area">
                <div class="modal-header pd-x-20">
                    <h4 class="page-title">GST Party Search</h4>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">×</span>
                    </button>
                </div>
                <div class="modal-body pd-20">
                    <div class="card-body hero-feature">
                        <div class="row">

                            <div class="col-lg-3 col-sm-12 col-xs-12">
                                <div class="form-group">
                                    <label class="form-label mandatory">Search</label>
                                    <div class="row gutters-xs">
                                        <div class="col">
                                            @Html.TextBox("TXtSearchOn", null, new { @class = "form-control", @id = "TXtSearchOn", name = "TXtSearchOn", autocomplete = "off", placeholder = "Search By Party Name or GST No" })
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-2 col-sm-12">
                                <div class="form-group" style="padding-top:26px;">
                                    <div class="row gutters-xs">
                                        <div class="col">
                                            <button class="btn btn-primary" id="btnSearch" type="button" onclick="GetDetailsForTariffSearch()"><i class="fe fe-search"></i></button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-lg-12 col-sm-12 col-xs-12">
                                <div class="table-responsive push scrolling-table-container">
                                    <table class="table table-bordered table-hover tbl-cart text-nowrap" id="example3" style="width:100%">
                                        <thead style="background-color: #8969eb;text-align: center;font-family: monospace;">
                                            <tr></tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div><!-- modal-dialog -->
</div>
<div class=" content-area" id="divsummary" style="display:none">
    <div class="page-header">
        <h4 class="page-title">
            Work Order Summary
        </h4>
        <ol class="breadcrumb" style="background-color: #FAFBFE">
            <li class="breadcrumb-item">
                <a onclick="Back();" class="btn btn-primary btn-success text-right" style="align-content:center;color:white"><i class="fa fa-arrow-left" data-placement="bottom" title="Add Work Order"></i> </a>
            </li>
        </ol>
    </div>
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <div class="form-horizontal">

                        <div class="row">

                            <div class="col-md-2 col-lg-2">
                                <div class="form-group label-floating">
                                    <label class="form-label">From</label>
                                    @Html.TextBox("FromDate", null, new { @id = "FromDate", @class = "form-control form_datetime1", @Value = DateTime.Now.AddDays(-1).ToString("dd MMM yyyy hh:mm") })
                                </div>
                            </div>
                            <div class="col-md-2 col-lg-2">
                                <div class="form-group label-floating">
                                    <label class="form-label">To</label>
                                    @Html.TextBox("ToDate", null, new { @id = "ToDate", @class = "form-control form_datetime1", @Value = DateTime.Now.ToString("dd MMM yyyy hh:mm") })
                                </div>
                            </div>

                            <div class="col-lg-3 col-sm-12">
                                <div class="form-group">
                                    <label class="form-label" style="visibility:hidden"> '</label>
                                    <div class="row gutters-xs">
                                        <div class="col">

                                            <button class="btn btn-primary" id="TripSearch" type="button" onclick="Showdetails()"><i class="fe fe-search"></i></button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-lg-12 col-sm-12">
                                <div class="table-responsive">
                                    <table id="example2" class="table table-bordered table-hover tbl-cart text-nowrap" style="width:100%">
                                        <thead>

                                            <tr></tr>
                                        </thead>

                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
 <script>
     function OpenTariffDetails() {

         $("#largeModal1").modal('show')
         GetDetailsForTariffSearch
     }
     function GetDetailsForTariffSearch() {
         $("#global-loader").fadeOut("slow");

         var Search = $("#TXtSearchOn").val();

         var data1 = { 'Search': Search };
         var data = JSON.stringify(data1);
         $.ajax({
             type: "POST",
             url: "/BookingEntry/GetDetailsForSearch",
             data: data,
             contentType: "application/json; charset=utf-8",
             success: function (data) {

                 $("#example3").empty();
                 RepTableDataJsonwopaging($("#example3"), data, "Voucher Details", "VoucherDetails_List");
                 $("#global-loader").fadeOut("slow");
             },
             error: function (response) {
                 alert(response.responseText);
                 $("#global-loader").fadeOut("slow");
             }
         })
     }
     function GetGSTName(GSTName, GSTIn_uniqID, state_Code, GSTID) {
         $("#txtGSTPartyName").val(GSTName);
         $("#txtGSTNo").val(GSTIn_uniqID);
         $("#lblstatecode").val(state_Code);
         $("#lblpartyid").val(GSTID);
         $("#largeModal").modal('hide');
     }

     $(document).ready(function () {
         AutomCom();
         ChangeSize();
     });


     function AutomCom() {
         debugger;
         $("#ddlCustomer").autocomplete({
             source: function (request, response) {
                 $.ajax({
                     url: "/BookingEntry/getCustomerName",
                     data: "{ 'prefixText': '" + request.term + "'}",
                     dataType: "json",
                     type: "POST",
                     contentType: "application/json; charset=utf-8",
                     success: function (data) {
                         //debugger;
                         response($.map(data, function (item) {
                             //debugger;
                             return {
                                 label: item.AGName,
                                 val: item.AGID,
                             };
                         }))
                     },
                     error: function (response) {
                         alert(response.responseText);
                     },
                     failure: function (response) {
                         alert(response.responseText);
                     }
                 })
             },
             select: function (e, i) {
                 //debugger;
                 $("#ddlCustomer").val(i.item.label);
                 $("#ddlCustomerId").val(i.item.val);
             },
             minLength: 1
         });
         $("#ddlCHA").autocomplete({
             source: function (request, response) {
                 $.ajax({
                     url: "/BookingEntry/getCHAName",
                     data: "{ 'prefixText': '" + request.term + "'}",
                     dataType: "json",
                     type: "POST",
                     contentType: "application/json; charset=utf-8",
                     success: function (data) {
                         //debugger;
                         response($.map(data, function (item) {
                             //debugger;
                             return {
                                 label: item.AGName,
                                 val: item.AGID,
                             };
                         }))
                     },
                     error: function (response) {
                         alert(response.responseText);
                     },
                     failure: function (response) {
                         alert(response.responseText);
                     }
                 })
             },
             select: function (e, i) {
                 //debugger;
                 $("#ddlCHA").val(i.item.label);
                 $("#ddlCHAId").val(i.item.val);
             },
             minLength: 1
         });

         $("#ddlExporter").autocomplete({
             source: function (request, response) {
                 $.ajax({
                     url: "/BookingEntry/getShipperName",
                     data: "{ 'prefixText': '" + request.term + "'}",
                     dataType: "json",
                     type: "POST",
                     contentType: "application/json; charset=utf-8",
                     success: function (data) {
                         //debugger;
                         response($.map(data, function (item) {
                             //debugger;
                             return {
                                 label: item.AGName,
                                 val: item.AGID,
                             };
                         }))
                     },
                     error: function (response) {
                         alert(response.responseText);
                     },
                     failure: function (response) {
                         alert(response.responseText);
                     }
                 })
             },
             select: function (e, i) {
                 //debugger;
                 $("#ddlExporter").val(i.item.label);
                 $("#ddlExporterId").val(i.item.val);
             },
             minLength: 1
         }) 

         $("#ddlForwarder").autocomplete({
             source: function (request, response) {
                 $.ajax({
                     url: "/BookingEntry/getFreightForwarder",
                     data: "{ 'prefixText': '" + request.term + "'}",
                     dataType: "json",
                     type: "POST",
                     contentType: "application/json; charset=utf-8",
                     success: function (data) {
                         //debugger;
                         response($.map(data, function (item) {
                             //debugger;
                             return {
                                 label: item.AGName,
                                 val: item.AGID,
                             };
                         }))
                     },
                     error: function (response) {
                         alert(response.responseText);
                     },
                     failure: function (response) {
                         alert(response.responseText);
                     }
                 })
             },
             select: function (e, i) {
                 //debugger;
                 $("#ddlForwarder").val(i.item.label);
                 $("#ddlForwarderId").val(i.item.val);
             },
             minLength: 1
         });
     };

 
     function ChangeSize() {
         
         var Search = $("#ddlWoOn").val();

         if (Search == "SB No") {
             $("#divSize").hide()
             
             $("#lblName").text('SB No')
         }
         else {
             $("#divSize").show()
             $("#lblName").text('Container No')
         }

     }

     function SBNoEntry() {
         $("#global-loader").fadeOut("slow");
      
         var Search = $("#ddlWotype").val();
         var data1 = {   'Search': Search };
         var data = JSON.stringify(data1);
         $.ajax({
             type: "POST",
             url: "/BookingEntry/SearchtrackerSCMTRSB",
             data: data,
             contentType: "application/json; charset=utf-8",
             success: function (data) {
                 debugger;


                 var select = $("#txtItem");

                 select.empty();
                 select.append($('<option/>', {
                     value: "",
                     text: "--Select--"
                 }));
                 for (var i = 0; i < data.length; i++) {
                     select.append($("<option></option>").val(data[i].Item).html(data[i].Item));

                 }
             },
             error: function (error) {
                 let str = error.responseText;
                 var a = str.indexOf("<title>") + 7;
                 var b = str.indexOf("</title>");
                 str = str.substring(a, b);
                 alert("Something went wrong: " + str);
             }
         })
     }

     function OnItemDesc() {
         $("#global-loader").fadeOut("slow");

         var select = $("#txtItem").val();
         var data1 = { 'Search': select };
         var data = JSON.stringify(data1);
         $.ajax({
             type: "POST",
             url: "/BookingEntry/SearchtrackerItemID",
             data: data,
             contentType: "application/json; charset=utf-8",
             success: function (data) {
                 debugger;
                 
                 $("#ddlItemID").val(data[0].ItemID)
               
             },
             error: function (error) {
                 let str = error.responseText;
                 var a = str.indexOf("<title>") + 7;
                 var b = str.indexOf("</title>");
                 str = str.substring(a, b);
                 alert("Something went wrong: " + str);
             }
         })
     }

     var storeAddedItem = [];
     function Add() {
         debugger;


         var element = {};
         element.SBNoandContainerno = $('#txtSBNoandContainerno').val();
         element.Item = $('#txtItem').val();
         element.Rate = $('#txtRate').val();
         element.qty = $('#txtqty').val();
         element.size = $('#ddlsize').val();
         element.ItemID = $('#ddlItemID').val();
         element.Tariff = $("#txtTariff option:selected").text();
         element.TariffID = $('#txtTariff').val();
         element.GSTPartyName = $('#txtGSTPartyName').val();
         element.partyid = $('#lblpartyid').val();

         element.GSTNo = $('#txtGSTNo').val();
         element.AdditionalAmount = $('#txtAdditionalAmount').val();


          
         if (element.Item == "") {
             alert("Please select Item.");
             return false;
         }
         if (element.Tariff == "") {
             alert("Please select Tariff.");
             return false;
         }
        

         storeAddedItem.push(element);
 
             $('#example').DataTable({
                 "destroy": true,
                 "bLengthChange": false,
                 "aaData": storeAddedItem,
                 "bPaginate": false,
                 "bInfo": false,
                 "paging": false,
                 "columns": [

                     { "data": "SBNoandContainerno" },
                     { "data": "size" },
                     { "data": "Item" },
                     { "data": "Rate" },
                     { "data": "Tariff" },

                     { "data": "GSTPartyName", "className": "hiderow" },
                     { "data": "GSTNo", "className": "hiderow" },
                     { "data": "AdditionalAmount" },
                    
                     { "data": "qty" },


                     { "data": "ItemID", "className": "hiderow" },
                     { "data": "TariffID", "className": "hiderow" },
                     { "data": "partyid", "className": "hiderow" },
                 ]
             });
         
     }
         function Save() {

      
