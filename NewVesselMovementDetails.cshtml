    $(function () {
        var currDate = new Date();
        $(".date").datetimepicker({
            autoclose: true,
            todayHighlight: true,
            format: 'dd M yyyy', // Changed to display only date
            language: "tr",
            changeMonth: true,
            changeYear: true,
            forceParse: true,
            pickTime: false,
            // endDate: currDate
        })
            .on('changeDate', function (e) {
                // Revalidate the date field
                // $('#eventForm').formValidation('revalidateField', 'date');
                $('.datetimepicker').hide();
            });

    });
    $(function () {
