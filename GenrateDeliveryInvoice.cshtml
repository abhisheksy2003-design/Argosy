    function SummaryList() {
        var fromdate = $("#TxtFromdate").val();
        var Todate = $("#TxtTodate").val();
        var data1 = { 'FromDate': fromdate, 'ToDate': Todate };
        var data = JSON.stringify(data1);

        $.ajax({
            type: 'POST',
            url: '/WorkOrder/FetchWorkOrderSummary',
            data: data,
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            async: true,
            success: function (jsonResult) {

                $("#example2").empty();
                RepTableDataJsonwopaging($("#example2"), jsonResult, "Voucher Details", "VoucherDetails_List");
            },
            error: function (errormessage) {
                alert(errormessage.responseText);
                $("#global-loader").fadeOut("slow");
            }
        });

    }

    function WorkOrderPrint(wono, workyear) {
        debugger;
        var data1 = { 'wono': wono, 'workyear': workyear };
        var data = JSON.stringify(data1);

        $.ajax({
            type: "POST",
            url: "/WorkOrder/WorkOrderPrint",
            data: data,
            contentType: "application/json; charset=utf-8",
            success: function (response) {
                var myWindow = window.open("", "MsgWindow");
                myWindow.close();
                var myWindow = window.open("", "MsgWindow");
                myWindow.document.write(response);

            },
            failure: function (response) {
                alert(response);
                alert(response.responseText);
            },
            error: function (response) {
                alert(response.responseText);
            }
        })
    }


    function WorkOrderCancel(WO_NO, Workyear) {
        var data1 = { 'wono': WO_NO, 'workyear': Workyear };
        var data = JSON.stringify(data1);
        var cmf = confirm("Sure to proceed?");

        if (cmf) {
            alert("Do you want to cancel this WorkOrder no " + WO_NO + " ?");
            $.ajax({
                url: "/WorkOrder/WorkOrderCancel",
                data: data,
                type: "POST",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (response) {
                    alert("Record Cancelled successfully!");
                    window.location.reload();
                    Search();
                },
                error: function (error) {
                    let str = error.responseText;
                    var a = str.indexOf("<title>") + 7;
                    var b = str.indexOf("</title>");
                    str = str.substring(a, b);
                    alert("Something went wrong: " + str);
                }
            });
        } else {
            alert("You pressed No!");
            return false;
        }
    }



