        //    if (checkbox.checked) {
        //        var pkg = $('.pkg', table.row(index).node()).val();
        //        var GPNo = $('.gpno', table.row(index).node()).val();
        //        var VehicleNo = $('.VehicleNo', table.row(index).node()).val();
        //        var EquipmentNo = $('.equipment-no', table.row(index).node()).val();

        //        SelectedData.push({
        //            'ContainerNo': row.ContainerNo,
        //            'IGMNo': row.IGMNo,
        //            'ItemNo': row.ItemNo,
        //            'Consignee': row.Consignee,
        //            'IGM_BLDate': row.IGM_BLDate,
        //            'I_Size': row.I_Size,
        //            'I_Wt': row.I_Wt,
        //            'Pkg': pkg,
        //            'JONo': row.JONo,
        //            'DestuffPkgs': $('.destuff-pkgs', table.row(index).node()).val(),
        //            'DestuffWeight': $('.destuff-weight', table.row(index).node()).val(),
        //            'EquipmentType': $('.equipment-type', table.row(index).node()).val(),
        //            'EquipmentNo': EquipmentNo,
        //            'GPNo': GPNo,
        //            'AddedOn': row.AddedOn
        //        });
        //    }
        //});

        if (tablearray.length == 0) {
            alert("Please select at least one container to generate WorkOrder!");
            return false;
        }

        var data1 = {
            'generatessr': GENERATESSR,
            'SelectedData': tablearray
        };

        var data = JSON.stringify(data1);

        return $.ajax({
            contentType: 'application/json; charset=utf-8',
            dataType: 'json',
            type: 'POST',
            url: "/WorkOrder/SaveWorkOrder",
            data: data,
            success: function (result) {

                alert(result);
                if (result == 'SUCCESS') {
                    window.location = "/WorkOrder/GenerateWorkOrder";
                } else {
                    alert("Save failed!");
                }
            },
            error: function () {
                alert("Error!");
