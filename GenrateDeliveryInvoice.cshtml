                    GENERATESSR.ItemNo = ItemNo;


                    tablearray.push({
                        'ContainerNo': ContainerNo, 'IGMNo': IGMNo, 'ItemNo': ItemNo,
                        'Size': I_Size, 'Weight': I_Wt, 'Qty': Pkg, 'JONo': JONo, 'DestuffPkgs': DestuffPkgs,
                        'DestuffWeight': DestuffWeight, 'EquipmentType': EquipmentType, 'EquipmentNo': EquipmentNo, 'Examine': Examine, 'GPNo': GPNo
                    })
