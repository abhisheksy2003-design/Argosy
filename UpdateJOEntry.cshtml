    <script>
        function ShowJODetails() {
    // read selected criteria
    var criteria = $('#ddlSearchCriteria').val();
        if (!criteria) {
            alert('Please select a Search Criteria.');
        return;
    }

        var searchValue = '';
        if (criteria === 'BLNo') {
            searchValue = $('#txtSearchBL').val();
        if (!searchValue || !searchValue.trim()) {
            alert('Please enter BL No.');
        return;
        }
    } else if (criteria === 'IGMNo') {
            searchValue = $('#txtSearchIGMNo').val();
        if (!searchValue || !searchValue.trim()) {
            alert('Please enter IGM No.');
        return;
        }
    } else {
            alert('Unsupported search criteria selected.');
        return;
    }

        var searchtext = $('#txtSearchItemNo').val();

        $.ajax({
            url: "/BookingEntry/FetchJODetails",
        type: "POST",
        contentType: "application/json; charset=utf-8",
        //  dataType: "json",
        //data: JSON.stringify(payload),
        data: JSON.stringify({
            SearchCriteria: criteria,
        SearchValue: searchValue.trim(),
        SearchText: searchtext,
        }),
        success: function (data) {
            if (!data || !data.JOList) {
            alert('No records found for the given criteria.');
        return;
            }

        $('#divBLForm :input').attr('disabled', false);

        $("#JONo").val(data.JOList.JONo);
        $("#JODate").val(data.JOList.JODateInString);

        $("#ddlAgent").val(data.JOList.AgentID);
        $("#shipperid").val(data.JOList.shipperid);
        $("#Chaid").val(data.JOList.Chaid);

        $("#txtViaNo").val(data.JOList.ViaNo);
        $("#ddlVessel").val(data.JOList.VesselID);
        $("#ddlPort").val(data.JOList.PortID);

        $("#txtBerthingDate").val(data.JOList.berthingDateInstring);

        $("#txtBLNo").val(data.JOList.BLNumber);
        $("#txtHouseBLNo").val(data.JOList.HouseBLNumber);

        $("#ddlSalesPerson").val(data.JOList.Sales_Person_Id);

        $("#txtIGMNo").val(data.JOList.IGMNo);

        $("#txtJoRemarks").val(data.JOList.Remarks);

        document.getElementById('lblCount').innerHTML = data.JOList.AttachmentCount || 0;
        $('#hdMode').val("");

        var JoNo = data.JOList.JONo;

        FetchContainerDetails(JoNo);
        },
        error: function (errormessage) {
            var msg = (errormessage && errormessage.responseText) ? errormessage.responseText : 'An error occurred while fetching details.';
        alert(msg);
        }
    });
}

    </script>

