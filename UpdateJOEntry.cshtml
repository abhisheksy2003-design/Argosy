<script>


    var containerTypeList = @Html.Raw(
        Json.Encode(
            ((IEnumerable<SelectListItem>)ViewBag.ContainerTypes)
            .Select(x => new { id = x.Value, text = x.Text })
        )
    );

     var cargoTypeList = @Html.Raw(Json.Encode(
        ((IEnumerable<SelectListItem>)ViewBag.CargoType)
        .Select(x => new { id = x.Value, text = x.Text })
    ));

    var sizeList = @Html.Raw(Json.Encode(
        ((IEnumerable<SelectListItem>)ViewBag.ContainerSize)
        .Select(x => new { id = x.Value, text = x.Text })
    ));

    var isoCodeList = @Html.Raw(Json.Encode(
        ((IEnumerable<SelectListItem>)ViewBag.ISOCodes)
        .Select(x => new { id = x.Value, text = x.Text })
    ));

    var commodityGroupList = @Html.Raw(Json.Encode(
        ((IEnumerable<SelectListItem>)ViewBag.CommodityGroup)
        .Select(x => new { id = x.Value, text = x.Text })
    ));
    var joTypeList = @Html.Raw(Json.Encode(
        ((IEnumerable<SelectListItem>)ViewBag.JoTypes)
        .Select(x => new { id = x.Value, text = x.Text })
    ));

    // FCL / LCL (static)
    var flList = [
        { id: "1", text: "FCL" },
        { id: "2", text: "LCL" }
    ];
    var PackingGroupList = [
        { id: "I", text: "I" },
        { id: "II", text: "II" },
        { id: "III", text: "III" }
    ];

    function renderDropdown(list, selectedId, cssClass, rowIndex) {

        var html = "<select class='form-select " + cssClass + "' data-row='" + rowIndex + "'>";
        html += "<option value=''>--Select--</option>";

        $.each(list, function (i, item) {
            var selected = (item.id == selectedId) ? "selected" : "";
            html += "<option value='" + item.id + "' " + selected + ">" + item.text + "</option>";
        });

        html += "</select>";
        return html;
    }

    function renderInput(value, cssClass, rowIndex, type = "text") {

        value = value == null ? "" : value;

        return "<input type='" + type + "' " +
            "class='form-control " + cssClass + "' " +
            "data-row='" + rowIndex + "' " +
            "value='" + value + "' />";
    }


</script>


    <Script>

    function FetchContainerDetails(jono) {
    // alert(jono)

    var data = JSON.stringify({
            'jono': jono
    });

        $.ajax({
            url: "/BookingEntry/FetchJOContainerDetails",
        data: data,
        type: "POST",
        contentType: "application/json; charset=utf-8",
        //  dataType: "json",
        success: function (data) {
            console.log(data);

            //-=======Display Total Container Details with Teus
            //try {
            //    DisplayContSize(data.Containerlist);
            //}
            //catch (ex) { }
            //-=======End Total Container Details with Teus

            $('#containerList').dataTable({
                "destroy": true,
                "bLengthChange": false,
                "aaData": data.Containerlist,
                "columns": [

                    { data: "ContainerNo" },//0
                    {
                        data: "ContainerTypeID",                        //1
                        render: function (data, type, row, meta) {
                            return renderDropdown(containerTypeList, data, "ddlContainerType", meta.row);
                        }
                    },

                    {
                        data: "Cargotypeid",                       //2
                        render: function (data, type, row, meta) {
                            return renderDropdown(cargoTypeList, data, "ddlCargoType", meta.row);
                        }
                    },
                    {
                        data: "Size",//3
                        render: function (data, type, row, meta) {
                            return renderDropdown(sizeList, data, "ddlSize", meta.row);
                        }
                    },
                    {
                        data: "FLID",//4
                        render: function (data, type, row, meta) {
                            return renderDropdown(flList, data, "ddlFL", meta.row);
                        }
                    },
                    {
                        data: "ISOCode",//5
                        render: function (data, type, row, meta) {
                            return renderDropdown(isoCodeList, data, "ddlISOCode", meta.row);
                        }
                    },
                    {
                        data: "Commodity_group_id",//6
                        render: function (data, type, row, meta) {
                            return renderDropdown(commodityGroupList, data, "ddlCommodityGroup", meta.row);
                        }
                    },
                    {
                        data: "JOTypeID",//7
                        render: function (data, type, row, meta) {
                            return renderDropdown(joTypeList, data, "ddlJoType", meta.row);
                        }
                    },
                    {
                        data: "Temp",                       //8
                        render: function (data, type, row, meta) {
                            return renderInput(data, "txtTemp", meta.row);
                        }
                    },
                    {
                        data: "Humidity",                       //9
                        render: function (data, type, row, meta) {
                            return renderInput(data, "txtHumidity", meta.row);
                        }
                    },
                    {
                        data: "Ventilation",                       //10
                        render: function (data, type, row, meta) {
                            return renderInput(data, "txtVentilation", meta.row);
                        }
                    },
                    {
                        data: "Class",                       //11
                        render: function (data, type, row, meta) {
                            return renderInput(data, "txtClass", meta.row);
                        }
                    },
                    {
                        data: "UNNo",                       //12
                        render: function (data, type, row, meta) {
                            return renderInput(data, "txtUNNo", meta.row);
                        }
                    },
                    {
                        data: "PackingGroup",                       //13
                        render: function (data, type, row, meta) {
                            return renderDropdown(PackingGroupList, data, "ddlPackingGroup", meta.row);
                        }
                    },
                    {
                        data: "OverWidth",                       //14
                        render: function (data, type, row, meta) {
                            return renderInput(data, "txtOverWidth", meta.row, "number");
                        }
                    },
                    {
                        data: "OverHeight",                       //15
                        render: function (data, type, row, meta) {
                            return renderInput(data, "txtOverHeight", meta.row, "number");
                        }
                    },
                    {
                        data: "OverLength",                       //16
                        render: function (data, type, row, meta) {
                            return renderInput(data, "txtOverLength", meta.row, "number");
                        }
                    }
                ]
            });

        },
        error: function (errormessage) {
            alert(errormessage.responseText);
        }
    });

}

        function showModal(JobNo) {

            $('#txtJobNoDoc').val(JobNo);
        $('#myModal').modal('show');
        FetchAttachmentTableData(JobNo);
}

        function closeModal() {
            $('#myModal').modal('hide');
}

        function UploadAttachment() {

    var fileInput = document.getElementById('jobOrderAttachment');
        var jobNo = $('#txtJobNoDoc').val();
        var docType = $('#ddlDocType').val();

        if (fileInput.files.length === 0) {
            Swal.fire("Please select a file.");
        return;
    }

        var formData = new FormData();
        formData.append('JobNo', jobNo);
        formData.append('DocType', docType);
        formData.append('UploadedFile', fileInput.files[0]);

        $.ajax({
            url: '/BookingEntry/UploadJobOrderDocument',
        type: 'POST',
        data: formData,
        contentType: false,
        processData: false,
        success: function (response) {
            if (response.success) {
            FetchAttachmentTableData(response.JoNo);
            } else {
            Swal.fire("Upload failed: " + response.message);
            }
        },
        error: function () {
            Swal.fire("Something went wrong while uploading.");
        }
    });
}

