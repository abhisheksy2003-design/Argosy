     function Save() {

    var EmptyDate = $("#txtEmptyDate").val();
    var SelectedData = [];
    var table = document.getElementById("example");


    if (table.rows.length <= 1) {
        alert("Please add at least one record.");
        return false;
    }

    var row;
    for (var i = 1; i < table.rows.length; i++) {

        row = table.rows[i];

        ContainerNo = row.cells[0].innerText;
        Size = row.cells[1].innerText;
        InDate = row.cells[3].innerText;
        TareWeight = row.cells[6].innerText;

        VehicelNo = row.cells[7].innerText;
        BkNo = row.cells[10].innerText;

        LineId = row.cells[11].innerText;
        CustomerId = row.cells[12].innerText;
        TransporterId = row.cells[13].innerText;
        TypeID = row.cells[15].innerText;

        AgentSeal = row.cells[16].innerText;
        ISOCodeID = row.cells[18].innerText;

        SelectedData.push({
            'ContainerNo': ContainerNo, 'Size': Size, 'InDate': InDate, 'TareWeight': TareWeight,
            'VehicelNo': VehicelNo, 'BkNo': BkNo, 'LineId': LineId, 'CustomerId': CustomerId,
            'TransporterId': TransporterId, 'TypeID': TypeID, 'AgentSeal': AgentSeal, 'ISOCodeID': ISOCodeID
        });
    }

    var data1 = {
        'Debitdata': SelectedData,
        'EmptyDate': EmptyDate
    };

    var data = JSON.stringify(data1);

    $.ajax({
        url: "/Export/SaveEmptyGate",
        data: data,
        type: "POST",
        contentType: "application/json; charset=utf-8",
        dataType: "json",
        success: function (data) {

            $('#btnSave').removeAttr('disabled', 'disabled');

            var array = data.split(',');
            var b = array[0];
            var c = array[1];

            alert(b);

            if (b == "Record saved successfully") {
                document.location = '@Url.Action("EmptyGateIn", "Export")';
            }
        },
        error: function (errormessage) {
            alert(errormessage.responseText);
        }
    });
    }
    function CancelGateINEntry(ID) {

        if (confirm("Are you sure you want to cancel this Gate In entry?")) {

            $.ajax({
                type: "POST",
                url: "/Export/CancelGateINEntry",
                data: { ID: ID },
                success: function (response) {

                    console.log("Server Response:", response);

                    if (response.status === "success") {
                        alert(response.message);
                        location.reload();
                    } else {
                        alert("Error: " + response.message);
                    }
                },
                error: function (xhr) {
                    alert("Error: " + (xhr.responseText || "Something went wrong"));
                }
            });
        }
    }


</script>