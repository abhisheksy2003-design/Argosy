
@{
    ViewBag.Title = "Empty Gate In";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}

<style>
    /*.table thead th, .text-wrap table thead th {
        background-color: #151517b5;
        color: white;
    }*/

    table.table-bordered.dataTable tbody th, table.table-bordered.dataTable tbody td {
        color: black;
        font-weight: 900 !important;
        font-size: 15px !important;
    }

    .hiderow {
        display: none;
    }
</style>
<script src="~/js/GetTableJsonwopaging.js"></script>
<div class=" content-area" id="DIvCompantMaster">
    <div class="page-header">
        <h4 class="page-title" id="New">Empty Gate In</h4>
        <div class="ibox-content text-right">
            <button type="button" class="btn btn-success" title="Summary list" onclick="ViewSummary();">Summary</button>
            @*<a onclick="GateInBack();" class="btn btn-primary me-2 text-right" style="align-content:center;color:white"><i class="fa fa-arrow-left" data-placement="bottom" title="Generate Job Order"></i> </a>*@

        </div>
    </div>

    <div class="col-sm-12 col-lg-12">
        <div class="row">
            <div class="card">
                <div class="card-body">
                    <div class="row">
                        <div class="col-lg-3 col-sm-12">
                            <div class="form-group">
                                <label class="form-label mandatory">Empty Date</label>
                                <div class="row gutters-xs">
                                    <div class="col">
                                        @Html.TextBox("txtEmptyDate", null, new { @class = "form-control form_datetime1", @id = "txtEmptyDate", name = "txtEmptyDate", autocomplete = "on", @Value = DateTime.Now.ToString("dd MMM yyyy hh:mm") })

                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-2 col-sm-3">
                            <div class="form-group">
                                <label class="form-label mandatory">Container No</label>
                                <div class="row gutters-xs">
                                    <div class="col">
                                        <input ID="txtContainerNo" type="text" placeholder="Container No" maxlength="11" class="form-control text-uppercase" onchange="checkveli();" />
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-2 col-sm-6" id="divSize">
                            <div class="form-group">
                                <label class="form-label">Size</label>
                                <div class="row gutters-xs">
                                    <div class="col">
                                        <select class="form-select" id="ddlsize">
                                            <option value="0">--Select--</option>
                                            <option value="20">20</option>
                                            <option value="40">40</option>
                                            <option value="45">45</option>

                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-2 col-sm-6">
                            <div class="form-group">
                                <label class="form-label">Type</label>
                                <div class="row gutters-xs">
                                    <div class="col">
                                        @Html.DropDownList("ddlType", (IEnumerable<SelectListItem>)ViewBag.ContainerTypeEntry, "--Select--", new { @class = "form-select", @id = "ddlType", name = "ddlType", autocomplete = "off" })
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-2 col-sm-3">
                            <div class="form-group">
                                <label class="form-label mandatory">Tare Weight</label>
                                <div class="row gutters-xs">
                                    <div class="col">
                                        <input ID="txtTareWeight" type="text" placeholder="Tare Weight" class="form-control" />
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-2 col-sm-12" style="display:none">
                            <div class="form-group">
                                <label class="form-label mandatory">SB Date</label>
                                <div class="row gutters-xs">
                                    <div class="col">
                                        @Html.TextBox("txtSBDate", null, new { @class = "form-control form_datetime1", @id = "txtSBDate", name = "txtSBDate", autocomplete = "on", @Value = DateTime.Now.ToString("dd MMM yyyy hh:mm") })

                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-lg-5 col-sm-12">
                            <div class="form-group">
                                <label class="form-label">Line</label>

                                <div class="row gutters-xs">
                                    <div class="col">
                                        <input type="text" placeholder="Line" class="form-control" id="ddlLine" />
                                        <input type="hidden" class="form-control" id="hdnLineId" />
                                    </div>

                                </div>
                            </div>
                        </div>
                        <div class="col-lg-5 col-sm-12" id="divCustomerName">
                            <div class="form-group">
                                <label class="form-label">Customer</label>

                                <div class="row gutters-xs">
                                    <div class="col">
                                        <input type="text" placeholder="Customer" class="form-control" id="ddlCustomer" />
                                        <input type="hidden" class="form-control" id="hdnCustomerId" />
                                    </div>

                                </div>
                            </div>
                        </div>


                    </div>
                    <div class="row">

                        <div class="col-lg-3 col-sm-3">
                            <div class="form-group">
                                <label class="form-label mandatory">Vehicle No</label>
                                <div class="row gutters-xs">
                                    <div class="col">
                                        <input ID="txtVehicelNo" type="text" placeholder="Vehicel No" class="form-control" />
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-3 col-sm-3">
                            <div class="form-group">
                                <label class="form-label mandatory">Agent Seal</label>
                                <div class="row gutters-xs">
                                    <div class="col">
                                        <input ID="txtAgentSeal" type="text" placeholder="Agent Seal" class="form-control" />
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-2 col-sm-12">
                            <div class="form-group">
                                <label class="form-label">ISO Code</label>
                                <div class="row gutters-xs">
                                    <div class="col">
                                        @Html.DropDownList("ddlISOCode", (IEnumerable<SelectListItem>)ViewBag.ISOCodes, "--Select--", new { @class = "form-select", @id = "ddlISOCode", name = "ddlISOCode", autocomplete = "off" })
                                    </div>

                                </div>
                            </div>
                        </div>
                        <div class="col-lg-4 col-sm-12">
                            <div class="form-group">
                                <label class="form-label">Transporter</label>

                                <div class="row gutters-xs">
                                    <div class="col">
                                        <input type="text" placeholder="Transporter" class="form-control" id="ddlTransporter" />
                                        <input type="hidden" class="form-control" id="hdnTransporterId" />
                                    </div>

                                </div>
                            </div>
                        </div>
                        <div class="col-lg-3 col-sm-6">
                            <div class="form-group">
                                <label class="form-label">Empty Yard</label>
                                <div class="row gutters-xs">
                                    <div class="col">
                                        @Html.DropDownList("ddlEmptyYard", (IEnumerable<SelectListItem>)ViewBag.Loaction, "--Select--", new { @class = "form-select", @id = "ddlEmptyYard", name = "ddlEmptyYard", autocomplete = "off" })
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-3 col-sm-12">
                            <div class="form-group">
                                <label class="form-label">BK No</label>

                                <div class="row gutters-xs">
                                    <div class="col">
                                        <input type="text" placeholder="" class="form-control" id="txtBkNo" />

                                    </div>

                                </div>
                            </div>
                        </div>
                        <div class="col-md-1 col-xs-4">
                            <div class="form-group">
                                <label class="form-label mandatory" style="visibility:hidden">.</label>
                                <div class="row gutters-xs">
                                    <div class="col">
                                        <button class="btn btn-primary me-2" id="btnAdd" onclick="return AddDetails();"><i class="fa fa-plus" aria-hidden="true"></i></button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">


                    </div>
                    <div class="row">
                        <div class="col-md-12 col-lg-12">
                            <div>
                                @*<label class="form-label">Details </label>*@
                            </div>
                            <div class="table-responsive">
                                <table class="table table-striped table-bordered" id="example" style="width:100%">
                                    <thead>
                                        <tr>



                                            <th class="wd-5p sorting">Container No</th>
                                            <th class="wd-15p sorting">Size</th>
                                            <th class="wd-10p sorting">Type</th>
                                            <th class="wd-10p sorting">In Date</th>
                                            <th class="wd-10p sorting">Line Name</th>
                                            <th class="wd-10p sorting">Customer Name</th>
                                            <th class="wd-10p sorting">Tare Weight</th>
                                            <th class="wd-10p sorting">Vehicel No</th>
                                            <th class="wd-10p sorting">Transporter</th>
                                            <th class="wd-10p sorting">Empty Yard</th>
                                            <th class="wd-10p sorting">BkNo</th>
                                            <th class="hiderow">LineId</th>
                                            <th class="hiderow">CustomerId</th>
                                            <th class="hiderow">TransporterId</th>
                                            <th class="hiderow">EmptyId</th>
                                            <th class="hiderow">TypeId</th>
                                            <th class="wd-10p sorting">Agent Seal</th>
                                            <th class="wd-10p sorting">ISO Code</th>
                                            <th class="hiderow">ISOCodeID</th>
                                        </tr>
                                    </thead>
                                </table>
                            </div>
                        </div>
                    </div>
                    <div class="row p-2">
                        <div class="col-md-3 col-xs-12">
                            <div class="d-flex align-items-center">

                                <!-- Save Button -->
                                <button class="btn btn-save px-4" id="btnSave" onclick="return Save(); " style="margin-right:10px">
                                     Save
                                </button>

                                <!-- Cancel Button -->
                                <button class="btn btn-cancel px-4" id="btnCancel" onclick="Cancel();">
                                    Cancel
                                </button>

                            </div>
                        </div>
                    </div>


                </div>
            </div>
        </div>
    </div>
</div>

<div class=" content-area" id="DivSummary" style="display:none">
    <div class="page-header">
        <h4 class="page-title">Empty Gate In Summary</h4>
        <div class="ibox-content  text-right">
            <a onclick="getBack();" class="btn btn-added" style="color:white;align-content:center;">   Add</a>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12 col-lg-12">
            <div class="card">
                <div class="card-body">

                    <div class="row">
                        <div class="col-lg-2 col-sm-12">
                            <div class="form-group">
                                <label class="form-label">From Date <span class="text-danger">*</span></label>
                                <div class="row gutters-xs">
                                    <div class="col">
                                        @Html.TextBox("txtFromdate", null, new
                                        {
                                            @class = "form-control form_datetime1 ",
                                       @id = "txtFromdate",
                                            autocomplete = "off",
                                            @Value = DateTime.Now.ToString("dd MMM yyyy 00:00")
                                        })
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-2 col-sm-12">
                            <div class="form-group">
                                <label class="form-label">To Date <span class="text-danger">*</span></label>
                                <div class="row gutters-xs">
                                    <div class="col">
                                        @Html.TextBox("txtTodate", null, new
                                        {
                                            @class = "form-control form_datetime1 ",
                                       @id = "txtTodate",
                                            autocomplete = "off",
                                            @Value = DateTime.Now.ToString("dd MMM yyyy 23:59")
                                        })
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-2 col-sm-12">
                            <div class="form-group">
                                <label class="form-label" style="visibility:hidden">.</label>
                                <div class="row gutters-xs">
                                    <div class="col-2">
                                        <button type="button" class="btn btn-icon btn-filters"
                                                title="Show Summary" id="btnShow" onclick="ShowSummary()">
                                            <i class="fa fa-search"></i>
                                        </button>
                                    </div>

                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="row">

                        <div class="table-responsive">
                            <table class="table table-bordered table-hover tbl-cart text-nowrap" id="tblGateInSummary"></table>
                        </div>
                    </div>


                </div>
            </div>
        </div>
    </div>
</div>


<script>

    function getBack() {
        $("#DIvCompantMaster").show();
        $("#DivSummary").hide();
    }

    function ViewSummary() {

        $("#DIvCompantMaster").hide();
        $("#DivSummary").show();
        ShowSummary();
    }


    function ShowSummary() {

        try {

            // Get values from input fields
            var fromDate = $("#txtFromdate").val();
            var toDate = $("#txtTodate").val();

            // Prepare data object
            var data = {
                fromDate: fromDate,
                toDate: toDate
            };
            //var data = {
            //    fromDate: formatDate($("#txtFromdate").val()),
            //    toDate: formatDate($("#txtTodate").val())
            //};


            $.ajax({
                url: "/Export/GetGateInSummary",
                data: JSON.stringify(data),
                type: "POST",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (response) {

                    RepTableDataJsonwopaging($("#tblGateInSummary"), response, "CreateSearch", "CreateSearch")
                },
                error: function (errormessage) {
                    alert("error");
                    alert(errormessage.responseText);
                }
            });

        } catch (ex) {

        }
    }


    function Cancel() {
        location.reload();
    }
    function checkveli() {
        debugger;
        var ContainerNo = $("#txtContainerNo").val();
        var data1 = {
            'ContainerNo': ContainerNo
        };
        var data = JSON.stringify(data1);
        $.ajax({
            url: "/Export/CheckCONTAINER_DIGIT",
            data: data,
            type: "POST",
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (data) {

                if (data != "false") {
                    checkAlready();
                } else {
                    alert('Please enter correct container no!');
                    $("#txtContainerNo").val('')
                    $("#txtContainerNo").focus();
                }
            },
            error: function (errormessage) {
                alert(errormessage.responseText);
            }
        });

    }
    function checkAlready() {
        debugger;
        var ContainerNo = $("#txtContainerNo").val();
        var data1 = {
            'ContainerNo': ContainerNo
        };
        var data = JSON.stringify(data1);
        $.ajax({
            url: "/Export/Checkemptyinvenotry",
            data: data,
            type: "POST",
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (data) {


                if (data != "0") {
                    alert('Container No Already Gate in');
                    $("#txtContainerNo").val('')
                    $("#txtContainerNo").focus();
                } else {

                }
            },
            error: function (errormessage) {
                alert(errormessage.responseText);
            }
        });
    }

    $(document).ready(function () {
        AutomCom();
        //ChangeSize();
    });
    function AutomCom() {
        debugger;
        $("#ddlCustomer").autocomplete({
            source: function (request, response) {
                $.ajax({
                    url: "/BookingEntry/getCustomerName",
                    data: "{ 'prefixText': '" + request.term + "'}",
                    dataType: "json",
                    type: "POST",
                    contentType: "application/json; charset=utf-8",
                    success: function (data) {
                        //debugger;
                        response($.map(data, function (item) {
                            //debugger;
                            return {
                                label: item.AGName,
                                val: item.AGID,
                            };
                        }))
                    },
                    error: function (response) {
                        alert(response.responseText);
                    },
                    failure: function (response) {
                        alert(response.responseText);
                    }
                })
            },
            select: function (e, i) {
                //debugger;
                $("#ddlCustomer").val(i.item.label);
                $("#hdnCustomerId").val(i.item.val);
            },
            minLength: 1
        });
        $("#ddlLine").autocomplete({
            source: function (request, response) {
                $.ajax({
                    url: "/Export/getLineName",
                    data: "{ 'prefixText': '" + request.term + "'}",
                    dataType: "json",
                    type: "POST",
                    contentType: "application/json; charset=utf-8",
                    success: function (data) {
                        //debugger;
                        response($.map(data, function (item) {
                            //debugger;
                            return {
                                label: item.AGName,
                                val: item.AGID,
                            };
                        }))
                    },
                    error: function (response) {
                        alert(response.responseText);
                    },
                    failure: function (response) {
                        alert(response.responseText);
                    }
                })
            },
            select: function (e, i) {
                //debugger;
                $("#ddlLine").val(i.item.label);
                $("#hdnLineId").val(i.item.val);
            },
            minLength: 1
        });
        $("#ddlTransporter").autocomplete({
            source: function (request, response) {
                $.ajax({
                    url: "/Export/getVendorName",
                    data: "{ 'prefixText': '" + request.term + "'}",
                    dataType: "json",
                    type: "POST",
                    contentType: "application/json; charset=utf-8",
                    success: function (data) {
                        //debugger;
                        response($.map(data, function (item) {
                            //debugger;
                            return {
                                label: item.AGName,
                                val: item.AGID,
                            };
                        }))
                    },
                    error: function (response) {
                        alert(response.responseText);
                    },
                    failure: function (response) {
                        alert(response.responseText);
                    }
                })
            },
            select: function (e, i) {
                //debugger;
                $("#ddlTransporter").val(i.item.label);
                $("#hdnTransporterId").val(i.item.val);
            },
            minLength: 1
        });
    };

    function AddDetails() {

        debugger;

        let customer = $("#ddlCustomer").val();
        let line = $("#ddlLine").val();


        if (customer !== "" && customer !== "0") {
            CheckName("Customer", customer);
            return;
        }


        if (line !== "" && line !== "0") {
            CheckName("Line", line);
            return;
        }


        alert("Please select Customer or Line.");
    }


    function CheckName(Type, Name) {

        var data = JSON.stringify({ Type: Type, Name: Name });

        $.ajax({
            url: "/BookingEntry/CheckName",
            data: data,
            type: "POST",
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (result) {

                if (result != "") {
                    alert(result);
                    return false;
                }

                Add();
            },
            error: function (error) {
                alert("Something went wrong.");
                console.log(error);
            }
        });
    }


    var ContainerDtl = [];
    var storeAddedItem = [];
    function Add() {
        debugger;
        var CTeus = 0;
        var STeus = 0;
        var isDuplicate = true;
        var element = {};
        element.ContainerNo = $('#txtContainerNo').val().toUpperCase();
        element.Size = $('#ddlsize').val();
        element.Type = $("#ddlType option:selected").text();
        element.InDate = $('#txtSBDate').val();
        element.LineName = $("#ddlLine").val();
        element.Customer = $('#ddlCustomer').val();
        element.TareWeight = $('#txtTareWeight').val();
        element.VehicelNo = $('#txtVehicelNo').val();
        element.Transporter = $('#ddlTransporter').val();
        element.EmptyYard = $("#ddlEmptyYard option:selected").text();
        element.BkNo = $('#txtBkNo').val();
        element.LineId = $('#hdnLineId').val();

        element.CustomerId = $('#hdnCustomerId').val();
        element.TransporterId = $('#hdnTransporterId').val();

        element.EmptyYardID = $('#ddlEmptyYard').val();
        element.TypeID = $('#ddlType').val();
        element.ISOCodeID = $('#ddlISOCode').val();
        element.ISOCode = $("#ddlISOCode option:selected").text();
        element.AgentSeal = $('#txtAgentSeal').val();

        if (element.ContainerNo === "") {
            alert("Please enter Container No.");
            $('#txtContainerNo').focus();
            return false;
        }

        if (element.Size === "" || element.Size === "0") {
            alert("Please select Size.");
            $('#ddlsize').focus();
            return false;
        }

        if (element.TypeID === "" || element.TypeID === "0") {
            alert("Please select Type.");
            $('#ddlType').focus();
            return false;
        }

        if (element.TareWeight === "") {
            alert("Please enter Tare Weight.");
            $('#txtTareWeight').focus();
            return false;
        }

        if (element.LineId === "" || element.LineId === "0") {
            alert("Please select Line.");
            $('#ddlLine').focus();
            return false;
        }

        if (element.CustomerId === "" || element.CustomerId === "0") {
            alert("Please select Customer.");
            $('#ddlCustomer').focus();
            return false;
        }
        if (element.TransporterId === "" || element.TransporterId === "0") {
            alert("Please select Transporter.");
            $('#ddlTransporter').focus();
            return false;
        }

        if (element.VehicelNo === "") {
            alert("Please enter Vehicle No.");
            $('#txtVehicelNo').focus();
            return false;
        }

        if (element.EmptyYardID === "" || element.EmptyYardID === "0") {
            alert("Please select Empty Yard.");
            $('#ddlEmptyYard').focus();
            return false;
        }
        var table2 = document.getElementById("example");
        var table1 = $('#example').DataTable();
        var row;
        if (table1.rows().count() > 0) {
            if (table2 != null) {
                if (table2.rows.length > 1) {


                    for (var i = 1; i < table2.rows.length; i++) {
                        row = table2.rows[i];
                        var Size = row.cells[1].innerText;
                        if (Size == "20") {
                            CTeus = parseInt(parseInt(CTeus) + 1);
                        }
                        else {
                            CTeus = parseInt(parseInt(CTeus) + 2);
                        }
                    }
                }
            }
        }

        var CType = $("#ddlType option:Selected").text();
        var Size = $("#ddlsize").val();
        if (Size == "20") {
            STeus = 1;
        }
        else {
            STeus = 2;
        }
        if (CType != "FR") {
            if (CTeus > 1) {
                alert('More than 2 Containers are not allowed.');
                return false;
            }
            else {
                if ((parseFloat(CTeus) + parseFloat(STeus)) > 2) {
                    alert('Invalid Size!');
                    return false
                }
            }
        }
        if (element.TareWeight == "") {
            alert("Please select Tare Weight.");
            event.preventDefault();
            $('#txtTareWeight').focus();
            return false;
        }
        if (element.LineId == 0) {
            alert("Please select Line Name.");

            event.preventDefault();
            $('#ddlLine').focus();
            return false;
        }
        if (element.CustomerId == 0) {
            alert("Please select Customer.");

            event.preventDefault();
            $('#ddlCustomer').focus();
            return false;
        }
        if (element.VehicelNo == "") {
            alert("Please select VehicelNo.");

            event.preventDefault();
            $('#txtVehicelNo').focus();
            return false;
        }
        if (element.EmptyYardID == 0) {
            alert("Please select Empty Yard.");

            event.preventDefault();
            $('#ddlEmptyYard').focus();
            return false;
        }


        var containerNos = $("#txtContainerNo").val();
        var table = document.getElementById("example");
        for (var i = 1; i < table.rows.length; i++) {
            row = table.rows[i];
            contain_No = row.cells[0].innerText;

            if (contain_No == containerNos) {
                isDuplicate = false;
            }
        }

        // storing container nos for validation
        ContainerDtl.push(containerNos);
        if (isDuplicate == false) {
            alert("Container is already added!");

        }

        if (isDuplicate) {
            storeAddedItem.push(element);
            $('#example').DataTable({
                "destroy": true,
                "bLengthChange": false,
                "aaData": storeAddedItem,
                "bPaginate": false,
