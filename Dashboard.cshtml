<script>
    function createGradient(ctx, color1, color2) {
        let gradient = ctx.createLinearGradient(0, 0, 0, 300);
        gradient.addColorStop(0, color1);
        gradient.addColorStop(1, color2);
        return gradient;
    }

    const whiteTextOptions = {
        maintainAspectRatio: false,
        responsive: true,
        scales: {
            x: {
                ticks: {
                    color: "white",
                    font: { size: 12 }
                },
                grid: {
                    color: "rgba(255,255,255,0.2)"
                }
            },
            y: {
                ticks: {
                    color: "white",
                    font: { size: 12 }
                },
                grid: {
                    color: "rgba(255,255,255,0.2)"
                },
                beginAtZero: true
            }
        },
        plugins: {
            legend: {
                labels: {
                    color: "white",
                    font: { size: 14 }
                }
            }
        }
    };

    // --- 1. Daily Import: Gate In ---
    let ctxGateIn = document.getElementById('chartGateInDaily').getContext('2d');
    new Chart(ctxGateIn, {
        type: 'bar',
        data: {
            labels: [
                @foreach(var item in ViewBag.GateInDaily)
                {
                    @:"'@item.Date.ToString("dd-MM-yyyy")',"
                }
            ],
            datasets: [{
                label: 'Gate In',
                data: [
                    @foreach(var item in ViewBag.GateInDaily)
                    {
                        @:@item.figure + ","
                    }
                ],
                backgroundColor: createGradient(ctxGateIn, "#00c9a7", "#92fe9d")
            }]
        },
        options: whiteTextOptions
    });

    // --- 2. Daily Import: Gate Out ---
    let ctxGateOut = document.getElementById('chartGateOutDaily').getContext('2d');
    new Chart(ctxGateOut, {
        type: 'bar',
        data: {
            labels: [
                @foreach(var item in ViewBag.GateOutDaily)
                {
                    @:"'@item.Date.ToString("dd-MM-yyyy")',"
                }
            ],
            datasets: [{
                label: 'Gate Out',
                data: [
                    @foreach(var item in ViewBag.GateOutDaily)
                    {
                        @:@item.figure + ","
                    }
                ],
                backgroundColor: createGradient(ctxGateOut, "#f7971e", "#ffd200")
            }]
        },
        options: whiteTextOptions
    });

    // --- 3. Daily Export: Empty In ---
    let ctxEmptyIn = document.getElementById('chartEmptyInDaily').getContext('2d');
    new Chart(ctxEmptyIn, {
        type: 'bar',
        data: {
            labels: [
                @foreach(var item in ViewBag.EmptyInDaily)
                {
                    @:"'@item.Date.ToString("dd-MM-yyyy")',"
                }
            ],
            datasets: [{
                label: 'Empty In',
                data: [
                    @foreach(var item in ViewBag.EmptyInDaily)
                    {
                        @:@item.figure + ","
                    }
                ],
                backgroundColor: createGradient(ctxEmptyIn, "#36d1dc", "#5b86e5")
            }]
        },
        options: whiteTextOptions
    });

    // --- 4. Daily Export: Loaded Out ---
    let ctxLoadedOut = document.getElementById('chartLoadedOutDaily').getContext('2d');
    new Chart(ctxLoadedOut, {
        type: 'bar',
        data: {
            labels: [
                @foreach(var item in ViewBag.LoadedOutDaily)
                {
                    @:"'@item.Date.ToString("dd-MM-yyyy")',"
                }
            ],
</script>


@*<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>*@

<script>
     $(document).ready(function () {
        loadCustomerCount();
    });

     function loadCustomerCount() {
$.ajax({
    url: '/Home/GetDashboardCards',  
    type: 'GET',                        
    success: function (res)
    {
        
        $("#Customer").text(res.Customer);
        $("#Impoter").text(res.Impoter);
        $("#CHA").text(res.CHA);
        $("#Exporter").text(res.Exporter);
        $("#TotalSalesPerson").text(res.TotalSalesPerson);
        $("#TotalJobs").text(res.TotalJobs);
        $("#GetIn").text(res.GetIn);
        $("#GetOut").text(res.GetOut);
        $("#Carting").text(res.Carting);
        $("#Stuffing").text(res.Stuffing);
        $("#Loadedout").text(res.Loadedout);
    },
    error: function (err) {
         
        console.error("Dashboard data load failed", err);
    }
});
}
</script>


 