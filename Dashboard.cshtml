<style>
    body {
        background-color: white !important;
    }
</style>
<style>
    .welcome-card {
        position: relative;
        background: #ffffff;
        border-radius: 18px;
        overflow: hidden;
        padding: 18px 22px;
    }

        /* CURVED SHAPE */
        .welcome-card::before {
            content: '';
            position: absolute;
            top: -60px;
            right: -80px;
            width: 280px;
            height: 280px;
            background: linear-gradient(135deg, #36d1dc, #5b86e5);
            border-radius: 50%;
            opacity: 0.15;
        }

    .welcome-flex {
        display: flex;
        align-items: center;
        justify-content: space-between;
        position: relative;
        z-index: 1;
    }

    .welcome-left {
        display: flex;
        gap: 14px;
        align-items: center;
    }

    .welcome-avatar {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        background: linear-gradient(135deg, #36d1dc, #5b86e5);
        padding: 2px;
    }

        .welcome-avatar img {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            background: #fff;
        }

    .welcome-text p {
        margin: 0;
        font-size: 12px;
        color: #666;
    }

    .welcome-text h4 {
        margin: 0;
        font-size: 16px;
        font-weight: 700;
        color: #111;
    }

    .welcome-title {
        margin-top: 6px;
        font-size: 18px;
        font-weight: 800;
        color: #1f2937;
    }

    .welcome-img img {
        width: 170px;
        margin-top: -10px;
    }

    @@media(max-width:768px) {
        .welcome-flex {
            flex-direction: column;
            align-items: flex-start;
        }

        .welcome-img img {
            width: 140px;
            margin-top: 10px;
        }
    }
</style>
<style>
    body {
        font-family: 'Segoe UI', sans-serif;
        background: linear-gradient(135deg, #eef2f7, #f9fbfd);
        padding: 10px;
    }

    .page-title {
        color: #222;
        margin-bottom: 10px;
    }

    .dashboard-card {
        border-radius: 18px;
        padding: 22px;
        cursor: pointer;
        position: relative;
        overflow: hidden;
        color: #fff;
        box-shadow: 0 15px 35px rgba(0,0,0,0.15);
        transition: all 0.4s ease;
    }

        .dashboard-card::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -50%;
            width: 200px;
            height: 200px;
            background: rgba(255,255,255,0.15);
            border-radius: 50%;
            transition: 0.5s;
        }

        .dashboard-card:hover::before {
            top: -20%;
            right: -20%;
        }

        .dashboard-card:hover {
            transform: translateY(-8px) scale(1.02);
            box-shadow: 0 25px 45px rgba(0,0,0,0.25);
        }

    .card-content {
        display: flex;
        align-items: center;
        gap: 18px;
    }

    .icon-circle {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        background: rgba(255,255,255,0.25);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 30px;
    }

    .card-text h4 {
        margin: 0;
        font-size: 24px;
        font-weight: 800;
    }

    .card-text span {
        font-size: 14px;
        opacity: 0.9;
        letter-spacing: 0.5px;
    }

    .gradient-primary {
        background: linear-gradient(135deg, #36d1dc, #5b86e5);
    }

    .gradient-cyan {
        background: linear-gradient(135deg, #00c6ff, #0072ff);
    }

    .gradient-pink {
        background: linear-gradient(135deg, #ff5f6d, #ffc371);
    }

    .gradient-orange {
        background: linear-gradient(135deg, #f7971e, #ffd200);
    }

    .gradient-success {
        background: linear-gradient(135deg, #00b09b, #96c93d);
    }
</style>
<style>
    .import-wrapper {
        position: relative;
    }

    .import-card {
        border-radius: 24px;
        padding: 30px;
        display: flex;
        align-items: center;
        gap: 22px;
        color: #fff;
        cursor: pointer;
        position: relative;
        overflow: hidden;
        backdrop-filter: blur(6px);
        box-shadow: 0 18px 40px rgba(0,0,0,0.18);
        transition: all 0.4s ease;
    }

        .import-card::after {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(120deg, rgba(255,255,255,0.15), transparent);
            opacity: 0;
            transition: 0.4s;
        }

        .import-card:hover::after {
            opacity: 1;
        }

        .import-card:hover {
            transform: translateY(-8px) scale(1.03);
            box-shadow: 0 28px 55px rgba(0,0,0,0.30);
        }

    .import-icon {
        height: 62px;
        width: 62px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 30px;
        background: rgba(255,255,255,0.25);
        box-shadow: inset 0 0 10px rgba(255,255,255,0.3);
    }

    .import-text h4 {
        margin: 0;
        font-size: 26px;
        font-weight: 800;
        letter-spacing: 0.5px;
    }

    .import-text span {
        font-size: 15px;
        opacity: 0.9;
        letter-spacing: 0.4px;
    }

    /* GRADIENT THEMES */
    .card-import-1 {
        background: linear-gradient(135deg, #5f72ff, #9b23ea);
    }

    .card-import-2 {
        background: linear-gradient(135deg, #00c6ff, #0072ff);
    }

    .card-import-3 {
        background: linear-gradient(135deg, #ff512f, #f09819);
    }
</style>

<style>
    .export-wrapper {
        position: relative;
    }

    .export-card {
        border-radius: 24px;
        padding: 28px;
        color: #fff;
        cursor: pointer;
        position: relative;
        overflow: hidden;
        box-shadow: 0 18px 40px rgba(0,0,0,0.18);
        transition: all 0.4s ease;
    }

        .export-card::before {
            content: '';
            position: absolute;
            inset: 0;
            background: radial-gradient(circle at top right, rgba(255,255,255,0.25), transparent 60%);
            opacity: 0;
            transition: 0.4s;
        }

        .export-card:hover::before {
            opacity: 1;
        }

        .export-card:hover {
            transform: translateY(-8px) scale(1.03);
            box-shadow: 0 28px 55px rgba(0,0,0,0.30);
        }

    .export-content {
        display: flex;
        align-items: center;
        gap: 20px;
    }

    .export-icon {
        width: 62px;
        height: 62px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(255,255,255,0.25);
        font-size: 30px;
        box-shadow: inset 0 0 12px rgba(255,255,255,0.35);
    }

    .export-text h4 {
        margin: 0;
        font-size: 26px;
        font-weight: 800;
        letter-spacing: 0.4px;
    }

    .export-text span {
        font-size: 15px;
        opacity: 0.9;
        letter-spacing: 0.4px;
    }

    /* GRADIENT THEMES */
    .export-orange {
        background: linear-gradient(135deg, #f7971e, #ffd200);
    }

    .export-danger {
        background: linear-gradient(135deg, #f54ea2, #ff7676);
    }

    .export-purple {
        background: linear-gradient(135deg, #8e2de2, #4a00e0);
    }

    .export-warning {
        background: linear-gradient(135deg, #f7971e, #ffb347);
    }
</style>


<h5 class="page-title mb-2" style="margin-top:-30px;">Dashboard</h5>

<div class="row mt-1">
    <div class="col-12">
        <div class="welcome-card">
            <div class="welcome-flex">

                <!-- LEFT -->
                <div>
                    <div class="welcome-left">
                        <div class="welcome-avatar">
                            <img src="~/assets/images/sprites/11.png" />
                        </div>
                        <div class="welcome-text">
                            <p>Dear User,</p>
                            <h4>
                                @if (Session["username"] != null)
                                {
                                    @Session["username"].ToString();
                                }
                                else
                                {
                                    <span>Guest</span>
                                }
                            </h4>
                        </div>
                    </div>

                    <div class="welcome-title">
                        Welcome to ARGOSY
                    </div>
                </div>

                <!-- RIGHT -->
                <div class="welcome-img">
                    <img src="~/assets/images/sprites/Container.png" />
                </div>

            </div>
        </div>
    </div>
</div>


<br />

<h5 class="page-title">Basic Details</h5>

