
@{ ViewBag.Title = "Package Master";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml"; }
<style>

    .required {
        content: "*";
        color: red;
        font: bold;
        font-size: small;
        padding-bottom: -50px;
        vertical-align: middle;
    }
</style>
<div class=" content-area overflow-hidden" id="divCreate">

    <div class="page-header">
        <div class="page-header-title">
            <h4 class="page-title">

                Package Master
            </h4>
        </div>
        <div class="page-header-breadcrumb">
            <button type="button" class="btn btn-primary waves-effect waves-light f-right d-inline-block md-trigger" onclick="Summary();" id="addlocallistbtn" data-modal="modal-13">
                Summary
            </button>
        </div>
    </div>

    <div class="page-body">

        <!-- Add Contact Start Model start-->
        <div class="card col-sm-12 col-lg-12">
            <div class="card-header">
                <h5>PACKAGE MASTER</h5>

                <div class="card-header-right">
                    <i class="icofont icofont-rounded-down"></i>
                    <i class="icofont icofont-refresh"></i>
                    <i class="icofont icofont-close-circled"></i>
                </div>
            </div>


            <div class="card-block col-sm-12 col-lg-12">
                <div class="row" style="display: none;">
                    <div class="col-lg-12 col-sm-12">
                        <div class="form-group">
                            <label class="form-label mandatory">Package ID<span class="required">*</span></label>
                            <div class="row gutters-xs">
                                <div class="col">
                                    <input id="CodeID" type="text" value="0" placeholder="New" readonly="readonly" class="form-control" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-lg-12 col-sm-12">
                        <div class="form-group">
                            <label class="form-label mandatory">Package Code<span class="required">*</span></label>
                            <div class="row gutters-xs">
                                <div class="col">
                                    <input id="Package" type="text" placeholder="Package Code" class="form-control" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-lg-12 col-sm-12">
                        <div class="form-group">
                            <label class="form-label mandatory">Package Desc<span class="required">*</span></label>
                            <div class="row gutters-xs">
                                <div class="col">
                                    <input id="PackageDesk" type="text" placeholder="Package Desc" class="form-control" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-lg-12 col-sm-12">
                        <div class="form-group">
                            <label class="custom-switch">
                                <input type="checkbox" name="custom-switch-checkbox" id="chkIsActive" value="true" checked="" class="custom-switch-input">
                                <span class="custom-switch-indicator"></span>
                                <span class="custom-switch-description">Is Active?</span>
                            </label>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <label class="form-label"></label>
                    <div class="row gutters-xs">
                        <div class="col">
                            @*<input type="submit" id="Save" name="save" value="Save" class="btn btn-success" />*@
                            <button id="btnSave" class="btn btn-save px-4" onclick="return SavePackage();">Save</button>
                            <input type="button" name="clear" value="Clear" class="btn btn-cancel px-4" onclick="Clear()" title="clear" id="clearValue" />
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<div class="content-area" id="divCreateSummary" style="display:none">

    <div class="page-header">
        <div class="page-header-title">
            <h4 class="page-title">
                Package Summary
            </h4>
        </div>
        <div class="page-header-breadcrumb">
            <button type="button" class="btn btn-primary waves-effect waves-light f-right d-inline-block md-trigger" onclick="Back();" id="addlocallistbtn" data-modal="modal-13">
                Add
            </button>
        </div>
    </div>

    <div class="page-body">

        <!-- Add Contact Start Model start-->
        <div class="card col-sm-12 col-lg-12">
            <div class="card-header">
                <h5>Package Summary</h5>

                <div class="card-header-right">
                    <i class="icofont icofont-rounded-down"></i>
                    <i class="icofont icofont-refresh"></i>
                    <i class="icofont icofont-close-circled"></i>
                </div>
            </div>


            <div class="card-block col-sm-12 col-lg-12">
                <div class="row">
                    <div class="col-lg-3 col-sm-12">
                        <div class="form-group">
                            <label class="form-label mandatory">Search</label>
                            <div class="row gutters-xs">
                                <div class="col">
                                    @*@Html.EditorFor(model => model.CHACode, new { htmlAttributes = new { @class = "form-control", @id = "chaCode", autocomplete = "off", maxlength = 20 } })*@
                                    @Html.TextBox("txtsearch", null, new { @class = "form-control ", @id = "txtsearch", name = "txtsearch", autocomplete = "on" })
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-3 col-sm-12">
                        <div class="form-group">
                            <label class="form-label" style="visibility:hidden"> '</label>
                            <div class="row gutters-xs">
                                <div class="col">
                                    <button class="btn btn-primary" id="btnShow" title="Show" data-toggle="tooltip" data-placement="bottom" onclick="ShowSSRSummary();"><i class="fa fa-search"></i></button>
                                    @*<button class="btn btn-success" title="Export To Excel" data-toggle="tooltip" data-placement="bottom" onclick="GetExcelFile()">Export</button>*@
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-lg-12 col-sm-12">
                        <div class="table-responsive">
                            <table class="table table-bordered table-hover tbl-cart text-nowrap" id="tblWorkOrderOpenList" style="width:100%;"></table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/js/GetTableJson.js"></script>
<script>
    function Back() {
        $("#divCreate").show();
        $("#divCreateSummary").hide();
    }

    function Summary() {
        $("#divCreate").hide();
        $("#divCreateSummary").show();
        ShowSSRSummary();
    }

    function Clear() {
        location.reload();
    }

    $("input").on('input', function () {
        $(this).val($(this).val().replace(/[^A-Za-z0-9_./ ]/g, ''));
    });

    function GetExcelFile() {
        window.location = "/Operation/ExportPackages";
    }
</script>

<script>
    function SavePackage() {
        var CodeID = $('#CodeID').val();
        var Package = $('#Package').val().trim();
        var PackageDesk = $('#PackageDesk').val().trim();

        // ✅ Correct validation
        if (Package === "" || PackageDesk === "") {
            alert("Package Code aur Package Desc required hai");
            return false;
        }

        var obj = {
            CodeID: parseInt(CodeID),
            Package: Package,
            PackageDesk: PackageDesk
        };

        $.ajax({
            type: "POST",
            url: "/Master/SavePackage",
            data: JSON.stringify(obj),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (res) {
                alert(res.Message);
                if (res.Status) {
                    $('#CodeID').val('0');
                    $('#Package').val('');
                    $('#PackageDesk').val('');
                    $('#chkIsActive').prop('checked', true);
                }
            },
            error: function (xhr) {
                alert("Error while saving");
            }
        });

        return false;
    }
</script>


<script>
    function ShowSSRSummary() {
        var search = document.getElementById('txtsearch').value;

        var data1 = { 'search': search };
        data = JSON.stringify(data1);

        $.ajax({
            url: "/Master/PackgesSummry",
            data: data,
            type: "POST",
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (data) {
                //alert(jsonResult)
                $("#reportTable").empty();
                RepTableDataJson($("#tblWorkOrderOpenList"), data, "ExpensesTypeMaster", "ExpensesTypeMaster")
                //  alert(jsonResult)
            },
            error: function (errormessage) {
                alert("error");
                alert(errormessage.responseText);
            }
        });


    }
</script>

<script>
    function Update(CodeID) {
        debugger;
        $("#divCreate").show();
        $("#divCreateSummary").hide();

         
        var data = JSON.stringify({ 'CodeID': CodeID });

        $.ajax({
            type: "POST",
            url: "/Master/FetchPacgesDetails",
            data: data,
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (response) {

                var data = JSON.parse(response); 

                if (data && data.length > 0) {
                    $("#CodeID").val(data[0].CodeID);
                    $("#Package").val(data[0].Package);
                    $("#PackageDesk").val(data[0].PackageDesk);
                }
            }
,
            error: function (xhr, status, error) {
                alert("Error: " + error);
            }
        });
    }
</script>