
<div>

    @model IEnumerable<MvcBondEntities.BusinessEntities.SalesPerson>



    <div class="page-header" style="margin-top:-10px;">
        <h4 class="page-title">Marketing Person List</h4>
        <div class="form-group">
            <label class="form-label"></label>
            <div class="row gutters-xs">
                <div class="col">
                    @*<button type="button" class="btn btn-icon btn-orange" name="gst" title="GST" id="gst"><i class="fa fa-google"></i></button>*@
                    @*<button type="button" class="btn btn-icon btn-teal" name="summarylist" title="Summary list" id="summarylist" onclick="ViewSummaryTrolley();"><i class="fa fa-file-text"></i></button>*@
                    <a onclick="window.location = '@Url.Action("SalesPersonMaster", "Master")' " class="btn btn-primary" style="align-content:center;color:white">Add</a>


                </div>
            </div>
        </div>
    </div>

    <div class="row" style="margin-top:-25px;">
        <div class="col-md-12 col-lg-12">
            <div class="card">
                <div class="card-body">

                    <div class="row">
                        <div class="col-md-12 col-lg-12">

                            <div class="table-responsive">
                                <table class="table table-bordered table-hover tbl-cart text-nowrap" id="tblsaleslist" style="width:100%">
                                    <thead>
                                        <tr>



                                            @*//<th>#</th>*@
                                            <th>Marketing ID</th>
                                            <th>Marketing Person Code</th>
                                            <th>Marketing Person Name</th>

                                            <th>Email ID</th>
                                            @*<th>IsActive</th>*@




                                        </tr>
                                    </thead>
                                    <tbody style="box-sizing :border-box;">
                                        @foreach (var d in Model)
                                        {
                                            <tr>

                                                <td style="display:none;"><button id=d.SalesPerson_ID1 onclick="Edit(@d.SalesPerson_ID1)" title="Edit" data-toggle="Edit" class="btn btn-primary"><i class="fa fa-edit"></i></button></td>
                                                <td>@Html.DisplayFor(m => d.SalesPerson_ID1)</td>
                                                <td>@Html.DisplayFor(m => d.SalesPerson_Code)</td>
                                                <td>@Html.DisplayFor(m => d.SalesPerson_Name)</td>
                                                <td>@Html.DisplayFor(m => d.EmailID)</td>
                                                @*<td>@Html.DisplayFor(m => d.IsActive)</td>*@


                                            </tr>


                                        }

                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
        $(document).ready(function () {
            $('#tblsaleslist').DataTable({
                "bLengthChange": false,
                "bInfo": false,
                "bPaginate": false,
                //"bFilter": false,
                "paging": false,
                "dom": 'Bfrtip',
                "buttons": [{
                    "extend": 'excel',
                    "title": 'MarketingPerson',
                    "filename": 'MarketingPerson'

                }
                ]
            });

        });

    function Edit(SalesPersonID) {
      //  alert(SalesPersonID);
        window.location = "/Master/SalesPersonMaster?SalesPerson_ID1=" + SalesPersonID;
    }

