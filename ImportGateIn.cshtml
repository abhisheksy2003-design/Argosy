    function UploadEIRAttachment() {

        var fileInput = document.getElementById('jobOrderAttachment');
        var jobNo = $('#txtJobNoDoc').val();
        var docType = $('#ddlDocType').val();

        if (fileInput.files.length === 0) {
            Swal.fire("Please select a file.");
            return;
        }

        var formData = new FormData();
        formData.append('JobNo', jobNo);
        formData.append('DocType', docType);
        formData.append('UploadedFile', fileInput.files[0]);

        $.ajax({
            url: '/BookingEntry/UploadJobOrderDocument',
            type: 'POST',
            data: formData,
            contentType: false,
            processData: false,
            success: function (response) {
                if (response.success) {
                    FetchAttachmentTableData(response.JoNo);
                } else {
                    Swal.fire("Upload failed: " + response.message);
                }
            },
            error: function () {
                Swal.fire("Something went wrong while uploading.");
            }
        });
    }
    var eirFiles = [];

    function previewEIRFiles(input) {

        eirFiles = Array.from(input.files);

        renderEIRPreview();
    }

    function renderEIRPreview() {

        var preview = $("#eirPreview");
        preview.html("");

        eirFiles.forEach(function (file, index) {

            var ext = file.name.split('.').pop().toLowerCase();
            var thumb = $("<div class='eir-thumb'></div>");

            var removeBtn = $("<div class='eir-remove'>×</div>");
            removeBtn.on("click", function (e) {
                e.stopPropagation();
                removeEIRFile(index);
            });

            thumb.append(removeBtn);

            if (ext === "jpg" || ext === "jpeg" || ext === "png") {

                var reader = new FileReader();
                reader.onload = function (e) {

                    var img = $("<img />");
                    img.attr("src", e.target.result);

                    img.on("click", function () {
                        openEIRModal(e.target.result, "image");
                    });

                    thumb.append(img);
                };
                reader.readAsDataURL(file);

            } else if (ext === "pdf") {

                var reader = new FileReader();
                reader.onload = function (e) {

                    var pdfDiv = $("<div class='eir-pdf'>PDF</div>");

                    pdfDiv.on("click", function () {
                        openEIRModal(e.target.result, "pdf");
                    });

                    thumb.append(pdfDiv);
                };
                reader.readAsDataURL(file);
            }

            preview.append(thumb);
        });
    }

    function removeEIRFile(index) {

        eirFiles.splice(index, 1);

        var dt = new DataTransfer();
        eirFiles.forEach(function (file) {
            dt.items.add(file);
        });

        document.getElementById("EIRFile").files = dt.files;

        renderEIRPreview();
    }

    function openEIRModal(src, type) {

        $("#eirModal").show();

        if (type === "image") {
            $("#eirModalImg").attr("src", src).show();
            $("#eirModalPdf").hide();
        } else if (type === "pdf") {
            $("#eirModalPdf").attr("src", src).show();
            $("#eirModalImg").hide();
        }
    }

    function closeEIRModal() {

        $("#eirModal").hide();

        $("#eirModalImg")
            .hide()
            .attr("src", "");

        $("#eirModalPdf")
            .hide()
            .attr("src", "");
    }


</script>