    function CargoTypeChange() {

        var cargotype = $("#ddlCargoType option:selected").text();


        if (cargotype === "REF") {
            $("#dvREF").show();
            $("#dvHAZ").hide();
            $("#dvOT").hide();
        }
        else if (cargotype === "REF-HAZ") {
            $("#dvREF").show();
            $("#dvHAZ").show();
            $("#dvOT").hide();

        }
        else if (cargotype === "HAZ" || cargotype === "TANK-HAZ" || cargotype === "OT IN GAUGE HAZ") {
            $("#dvREF").hide();
            $("#dvHAZ").show();
            $("#dvOT").hide();

        }
        else if (cargotype === "ODC-HAZ" || cargotype === "OT OUT GAUGE HAZ") {
            $("#dvREF").hide();
            $("#dvHAZ").show();
            $("#dvOT").show();

        }
        else if (cargotype === "ODC" || cargotype === "OT OUT GAUGE") {
            $("#dvREF").hide();
            $("#dvHAZ").hide();
            $("#dvOT").show();

        }
        else {
            $("#dvREF").hide();
            $("#dvHAZ").hide();
            $("#dvOT").hide();
        }

    }
