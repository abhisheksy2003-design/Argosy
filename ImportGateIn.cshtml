
@{
    ViewBag.Title = "ImportGateIn";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}

<style>
    .btn-blue {
        background-color: #0d6efd !important; /* Bootstrap Blue */
        border-color: #0d6efd !important;
        color: #fff !important;
    }

    .btn-clear-custom {
        background-color: #6c757d; /* Grey */
        color: #fff;
        padding: 13px 38px;
        border-radius: 4px;
        border: none;
        font-weight: 600;
    }

        .btn-clear-custom:hover {
            background-color: #5a6268;
        }

    .eir-modal {
        display: none;
        position: fixed;
        z-index: 9999;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.7);
    }

    .eir-modal-content {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        max-width: 90%;
        max-height: 90%;
        background: #fff;
        padding: 10px;
        border-radius: 6px;
    }

        .eir-modal-content img {
            max-width: 100%;
            max-height: 80vh;
        }

        .eir-modal-content iframe {
            width: 80vw;
            height: 80vh;
            border: none;
        }

    .eir-close {
        position: absolute;
        top: 15px;
        right: 25px;
        color: #fff;
        font-size: 30px;
        cursor: pointer;
    }

    .eir-preview {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        margin-top: 10px;
    }

    .eir-thumb {
        width: 110px;
        height: 110px;
        border: 1px solid #ddd;
        border-radius: 6px;
        position: relative;
        background: #f9f9f9;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .eir-remove {
        position: absolute;
        top: 4px;
        right: 4px;
        width: 20px;
        height: 20px;
        background: #e53935;
        color: #fff;
        font-size: 14px;
        border-radius: 50%;
        line-height: 20px;
        text-align: center;
        cursor: pointer;
        z-index: 2;
    }

    .eir-thumb img {
        max-width: 100%;
        max-height: 100%;
        border-radius: 4px;
    }

    .eir-pdf {
        font-size: 13px;
        color: #d32f2f;
        font-weight: 600;
    }

</style>

<script src="~/js/GetTableJson.js"></script>
