<script>
    function ContainerFetch() {
        var ContainerNo = $("#txtContainerNo").val();
        try {
            var data1 = { 'ContainerNo': ContainerNo };
            data = JSON.stringify(data1);
            $.ajax({
                url: "/BookingEntry/FetchdatContainer",
                data: data,
                type: "POST",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data) {
                    data = JSON.parse(data);


                    $("#ddlSize").val(data[0].ContainerSizeID);
                    $("#ddlCargoType").val(data[0].Cargotypeid);
                    $("#ddlISOCode").val(data[0].ISOCode);
                    $("#ddlContainerType").val(data[0].ContainerTypeID);
                    $("#txtTemperature").val(data[0].Temperature);
                    $("#txtHumidity").val(data[0].Humidity);
                    $("#txtVentilation").val(data[0].Ventilation);
                    $("#txtClass").val(data[0].Class);
                    $("#txtUNNo").val(data[0].UNNo);
                    $("#ddlPackingGroup").val(data[0].PackingGroup);
                    $("#txtOverLength").val(data[0].OverLength);
                    $("#txtOverWidth").val(data[0].OverWidth);
                    $("#txtOverHeight").val(data[0].OverHeight);


                    CargoTypeChange();

                },
                error: function (errormessage) {
                    alert("error");
                    alert(errormessage.responseText);
                }
            });

        } catch (ex) {

        }

    }


    function ManualUploadModel() {
        $('#ManualUploadDiv').modal('show');
    }

    function DownloadTemplate() {
        window.location = '@Url.Action("DownloadTemplate", "BookingEntry", new { fileName = "GateIN_Template.xlsx" })';
    }

    $(document).ready(function () {

        GetInPendingList();

    });
    function Clear() {
        //$("#ddlTransportName").val('');
        //$("#txtVehicleNo").val('');
        //$("#txtDriverName").val('');
        //$("#txtDriverNo").val('');
        //$("#txtRemarks").val('');
        location.reload();
        //Addbutton();

    }
    function GateInBack() {
        $("#divAwaitingSummary").show();
        $("#Divaddlocation").hide();
        $("#divGateInSummary").hide();


    }

    function GateInSummary() {
        $("#divAwaitingSummary").hide();
        $("#Divaddlocation").hide();
        $("#divGateInSummary").show();
        GetDetailsonLoad();

    }

    function Addbutton() {
        $("#divAwaitingSummary").hide();
        $("#Divaddlocation").show();

    }

    function GetDetails() {
