                                    <div class="row gutters-xs">
                                        <div class="col">
                                            @Html.TextBox("txtCfsiInvoiceDate", null, new { @class = "form-control  form_datetime1 ", @id = "txtCfsiInvoiceDate", name = "txtCfsiInvoiceDate", Value = DateTime.Now.ToString("dd MMM yyyy HH:mm"), autocomplete = "off" })
                                        </div>
                                    </div>
                                </div>
