                                            @Html.TextBox("txtCfsiInvoiceID", null, new { @class = "form-control", @id = "txtCfsiInvoiceID", name = "txtCfsiInvoiceID", autocomplete = "off" })
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-2 col-sm-12">
                                <div class="form-group">
