<div class=" content-area" id="DIvCompantMaster">
    <div class="page-header" style="margin-top:-5px;">
        <h4 class="page-title" id="New">Stuffing Entry</h4>
        <div class="form-group">
            <label class="form-label"></label>
            <div class="row gutters-xs">
                <div class="col">
                    <button type="button" class="btn btn-success" title="Summary list" onclick="ViewSummary();">Summary</button>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-12 col-lg-12" style="margin-top:-30px;">
        <div class="row">
            <div class="card">
                <div class="card-body">
                    <div class="row">
                        <div class="col-lg-2 col-sm-3">
                            <div class="form-group">
                                <label class="form-label mandatory">SB No</label>
                                <div class="row gutters-xs">
                                    <div class="col">
                                        <input ID="txtSBNo" type="text" placeholder="SB No" class="form-control" onchange="CheckSbNo();" />
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-2 col-sm-3">
                            <div class="form-group">
                                <label class="form-label mandatory">SB Qty</label>
                                <div class="row gutters-xs">
                                    <div class="col">
                                        <input ID="txtSBQty" type="text" placeholder="SB Qty" readonly="readonly" class="form-control" />
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-2 col-sm-12">
                            <div class="form-group">
                                <label class="form-label mandatory">SB Weight</label>
                                <div class="row gutters-xs">
                                    <div class="col">
                                        <input ID="txtSBWeight" type="text" placeholder="SB Weight" readonly="readonly" class="form-control" />

                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-2 col-sm-12">
                            <div class="form-group">
                                <label class="form-label mandatory">Carted Qty</label>
                                <div class="row gutters-xs">
                                    <div class="col">
                                        <input ID="txtCartedQty" type="text" placeholder="Carted Qty" readonly="readonly" class="form-control" />

                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-4 col-sm-12">
                            <div class="form-group">
                                <label class="form-label">Customer</label>

                                <div class="row gutters-xs">
                                    <div class="col">
                                        <input type="text" placeholder="Customer" readonly="readonly" class="form-control" id="txtCustomerSB" />

                                    </div>

                                </div>
                            </div>
                        </div>
                        <div class="col-lg-2 col-sm-12" style="display:none">
                            <div class="form-group">
                                <label class="form-label mandatory">sbentryID</label>
                                <div class="row gutters-xs">
                                    <div class="col">
                                        <input ID="txtsbentryID" type="text" placeholder="Carted Qty" readonly="readonly" class="form-control" />

                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-lg-2 col-sm-3">
                            <div class="form-group">
                                <label class="form-label mandatory">Container No</label>
                                <div class="row gutters-xs">
                                    <div class="col">
                                        <input ID="txtContainerNo" type="text" placeholder="Container No" maxlength="11" class="form-control text-uppercase" onchange="CheckContainerNo();" />
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-2 col-sm-3">
                            <div class="form-group">
                                <label class="form-label mandatory">Size</label>
                                <div class="row gutters-xs">
                                    <div class="col">
                                        <input ID="txtsize" type="text" placeholder="Size" readonly="readonly" class="form-control" />
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-2 col-sm-3">
                            <div class="form-group">
                                <label class="form-label mandatory">Type</label>
                                <div class="row gutters-xs">
                                    <div class="col">
                                        <input ID="txtType" type="text" placeholder="Type" readonly="readonly" class="form-control" />
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-2 col-sm-3">
                            <div class="form-group">
                                <label class="form-label mandatory">Tare Weight</label>
                                <div class="row gutters-xs">
                                    <div class="col">
                                        <input ID="txtTareWeight" type="text" placeholder="Tare Weight" readonly="readonly" class="form-control" />
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-2 col-sm-3" style="display:none">
                            <div class="form-group">
                                <label class="form-label mandatory">Gate In No</label>
                                <div class="row gutters-xs">
                                    <div class="col">
                                        <input ID="txtGateInNo" type="text" placeholder="Tare Weight" readonly="readonly" class="form-control" />
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-4 col-sm-12">
                            <div class="form-group">
                                <label class="form-label">Customer</label>

                                <div class="row gutters-xs">
                                    <div class="col">
                                        <input type="text" placeholder="Customer" readonly="readonly" class="form-control" id="txtCustomerIN" />

                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-lg-2 col-sm-3">
                            <div class="form-group">
                                <label class="form-label mandatory">Stuffed Qty</label>
                                <div class="row gutters-xs">
                                    <div class="col">
                                        <input ID="txtStuffedQty" type="text" placeholder="Stuffed Qty" class="form-control" OnChange="GetWeight()" />
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-2 col-sm-3">
                            <div class="form-group">
                                <label class="form-label mandatory">Stuffed Weight</label>
                                <div class="row gutters-xs">
                                    <div class="col">
                                        <input ID="txtStuffedWeight" type="text" placeholder="Stuffed Weight" class="form-control" />
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-3 col-sm-12">
                            <div class="form-group">
                                <label class="form-label mandatory">Stuffed Date</label>
                                <div class="row gutters-xs">
                                    <div class="col">
                                        @Html.TextBox("txtStuffedDate", null, new { @class = "form-control datetime1", @id = "txtStuffedDate", name = "txtStuffedDate", autocomplete = "on", @Value = DateTime.Now.ToString("dd MMM yyyy") })

                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-lg-2 col-sm-3">
                            <div class="form-group">
                                <label class="form-label mandatory">Custom Seal</label>
                                <div class="row gutters-xs">
                                    <div class="col">
                                        <input ID="txtCustomSeal" type="text" placeholder="Custom Seal" class="form-control" />
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-2 col-sm-3">
                            <div class="form-group">
                                <label class="form-label mandatory">Agent Seal</label>
                                <div class="row gutters-xs">
                                    <div class="col">
                                        <input ID="txtAgentSeal" type="text" placeholder="Agent Seal" class="form-control" />
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-3 col-sm-6">
                            <div class="form-group">
                                <label class="form-label">Cargo Type</label>
                                <div class="row gutters-xs">
                                    <div class="col">
                                        @Html.DropDownList("ddlCargoType", (IEnumerable<SelectListItem>)ViewBag.ExportEntry, "--Select--", new { @class = "form-select", @id = "ddlCargoType", name = "ddlCargoType", autocomplete = "off" })
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-3 col-sm-12">
                            <div class="form-group">
                                <label class="form-label mandatory">Stuffing  Equipment</label>
                                <div class="row gutters-xs">
                                    <div class="col">
                                        @Html.DropDownList("ddlCargingEquipment", (IEnumerable<SelectListItem>)ViewBag.Equipment, "--Select--", new { @class = "form-select", @id = "ddlCargingEquipment", name = "ddlCargingEquipment", autocomplete = "off" })
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-1 col-xs-4">
                            <div class="form-group">
                                <label class="form-label mandatory" style="visibility:hidden">.</label>
                                <div class="row gutters-xs">
                                    <div class="col">
                                        <button class="btn btn-primary me-2" id="btnAdd" onclick="return Add();"><i class="fa fa-plus" aria-hidden="true"></i></button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12 col-lg-12">
                            <div>
                                @*<label class="form-label">Details </label>*@
                            </div>
                            <div class="table-responsive">
                                <table class="table table-striped table-bordered" id="example" style="width:100%">
                                    <thead>
                                        <tr>



                                            <th class="wd-5p sorting">SB No</th>
                                            <th class="wd-15p sorting">Container No</th>
                                            <th class="wd-10p sorting">Stuffed Qty</th>
                                            <th class="wd-10p sorting">Stuffed Weight</th>
                                            <th class="wd-10p sorting">Stuffed Date</th>
                                            <th class="wd-10p sorting">Custom Seal</th>
                                            <th class="wd-10p sorting">Agent Seal</th>
                                            <th class="wd-10p sorting">Cargo Type</th>


                                            <th class="hiderow">CargoTypeID</th>

                                        </tr>
                                    </thead>
                                </table>
                            </div>
                        </div>
                    </div>
                    @*<div class="row p-1">
            <div class="col-md-1 col-xs-4">
                <div class="form-group">
                    <div class="row gutters-xs">
                        <div class="col">
                            <button class="btn btn-submit me-2" id="btnSave" onclick="return Save();"><i class="fa fa-floppy-o m-1" aria-hidden="true"></i>Save</button>
                            <button class="btn btn-danger" id="btnCancel" onclick="Cancel();">
                                Cancel
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>*@

                    <div class="row p-2">
                        <div class="col-md-3 col-xs-12">
                            <div class="d-flex align-items-center">

                                <!-- Save Button -->
                                <button class="btn btn-save px-4" id="btnSave" onclick="return Save(); " style="margin-right:10px">
                                     Save
                                </button>

                                <!-- Cancel Button -->
                                <button class="btn btn-cancel px-4" id="btnCancel" onclick="Cancel();">
                                     Cancel
                                </button>

                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>


<div class="col-lg-2 col-sm-3" style="display:none">
    <div class="form-group">
        <label class="form-label mandatory">Agent Seal</label>
        <div class="row gutters-xs">
            <div class="col">
                <input ID="TXTTotalQty" type="text" placeholder="Agent Seal" class="form-control" />
            </div>
        </div>
    </div>
</div>

<div class=" content-area" id="DivSummary" style="display:none">
    <div class="page-header">
        <h4 class="page-title">Stuffing Request Summary</h4>
        <div class="ibox-content  text-right">
            <a onclick="getBack();" class="btn btn-added" style="color:white;align-content:center;">   Add</a>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12 col-lg-12">
            <div class="card">
                <div class="card-body">

                    <div class="row">
                        <div class="col-lg-2 col-sm-12">
                            <div class="form-group">
                                <label class="form-label">From Date <span class="text-danger">*</span></label>
                                <div class="row gutters-xs">
                                    <div class="col">
                                        @Html.TextBox("txtFromdate", null, new
                                        {
                                            @class = "form-control form_datetime1 ",
                                       @id = "txtFromdate",
                                            autocomplete = "off",
                                            @Value = DateTime.Now.ToString("dd MMM yyyy 00:00")
                                        })
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-2 col-sm-12">
                            <div class="form-group">
                                <label class="form-label">To Date <span class="text-danger">*</span></label>
                                <div class="row gutters-xs">
                                    <div class="col">
                                        @Html.TextBox("txtTodate", null, new
                                        {
                                            @class = "form-control form_datetime1 ",
                                       @id = "txtTodate",
                                            autocomplete = "off",
                                            @Value = DateTime.Now.ToString("dd MMM yyyy 23:59")
                                        })
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-2 col-sm-12">
                            <div class="form-group">
                                <label class="form-label" style="visibility:hidden">.</label>
                                <div class="row gutters-xs">
                                    <div class="col-2">
                                        <button type="button" class="btn btn-icon btn-filters"
                                                title="Show Summary" id="btnShow" onclick="ShowSummary()">
                                            <i class="fa fa-search"></i>
                                        </button>
                                    </div>

                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="row">

                        <div class="table-responsive">
                            <table class="table table-bordered table-hover tbl-cart text-nowrap" id="tblStuffingReqSummary"></table>
                        </div>
                    </div>


                </div>
            </div>
        </div>
    </div>
</div>




<script>
    function Cancel() {
        location.reload();
    }

    function getBack() {
        $("#DIvCompantMaster").show();
        $("#DivSummary").hide();
    }

    function ViewSummary() {

        $("#DIvCompantMaster").hide();
        $("#DivSummary").show();
        ShowSummary();
    }


    function ShowSummary() {

        try {
            var fromDate = $("#txtFromdate").val();
            var toDate = $("#txtTodate").val();

            // Prepare data object
            var data = {
                fromDate: fromDate,
                toDate: toDate
            };
            $.ajax({
                url: "/Export/GetStuffingReqSummary",
                data: JSON.stringify(data),
                type: "POST",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (response) {

                    RepTableDataJsonwopaging($("#tblStuffingReqSummary"), response, "CreateSearch", "CreateSearch")
                },
                error: function (errormessage) {
                    alert("error");
                    alert(errormessage.responseText);
                }
            });

        } catch (ex) {

        }
    }

    function CheckContainerNo() {
        debugger;
        var ContainerNo = $("#txtContainerNo").val();
        var data1 = {
            'ContainerNo': ContainerNo
        };
        var data = JSON.stringify(data1);
        $.ajax({
            url: "/Export/Checkemptyinvenotry",
            data: data,
            type: "POST",
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (data) {


                if (data != "0") {
                    CheckContainerNoss()
                } else {
                    alert('ContainerNo not geta in');
                    $("#txtContainerNo").val('')
                    $("#txtContainerNo").focus();
                }
            },
            error: function (errormessage) {
                alert(errormessage.responseText);
            }
        });

    }
    function GetWeight() {
        debugger;
        var TotalQty = $("#txtSBQty").val();
        var TotalWeight = $("#txtSBWeight").val();

        var AllowQty = $("#txtStuffedQty").val();


        if (TotalWeight == "") {
            TotalWeight = 0;
        }


        if (parseFloat(TotalQty) < parseFloat(AllowQty)) {
            alert("Stuffed Qty is not greater then SB Qty!");
            $("#txtStuffedQty").val('');
            $("#txtStuffedQty").focus();
        }
        else {
            DelWeight = ((parseFloat(TotalWeight) / parseFloat(TotalQty)) * AllowQty);
            $("#txtStuffedWeight").val(DelWeight);

        }




    }
    function CheckSbNo() {
        var SbNumber = $("#txtSBNo").val();
        var data1 = {
            'SbNumber': SbNumber
        }
        var data = JSON.stringify(data1);

                    $.ajax({
                        url: "/Export/SBNumberStuffing",
                    data: data,
                    type: "POST",
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                        success: function (Data) {
                            if (Data != 0) {
                                $("#txtSBQty").val(Data[0].StuffedQty);
                                $("#txtSBWeight").val(Data[0].StuffedWeight);
                                $("#txtCartedQty").val(Data[0].CartedQty);
                                $("#txtCustomerSB").val(Data[0].CusName);
                                $("#txtsbentryID").val(Data[0].SbEntryID);
                                $("#ddlCargoType").val(Data[0].CargoTypeID);

                            }
                            else {
                                alert('Data not found');
                            }


                    },
                    error: function (errormessage) {
                    alert(errormessage.responseText);
                    }
                    })
    }
    function CheckContainerNoss() {
        var ContainerNo = $("#txtContainerNo").val();
        var data1 = {
            'ContainerNo': ContainerNo
        }
        var data = JSON.stringify(data1);

        $.ajax({
            url: "/Export/ContainerNoStuffing",
            data: data,
            type: "POST",
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (data) {
                $("#txtsize").val(data[0].Size);
                $("#txtType").val(data[0].ContainerType);
                $("#txtTareWeight").val(data[0].TareWeight);
                $("#txtCustomerIN").val(data[0].CusName);
                $("#txtGateInNo").val(data[0].GateInNo);
                $("#txtAgentSeal").val(data[0].AgentSeal);
            },
            error: function (errormessage) {
                alert(errormessage.responseText);
            }
        })
    }
    var storeAddedItem = [];
    var maxqty = 0;
    function Add() {
        debugger;


        var element = {};
        element.SBNo = $('#txtSBNo').val();
        element.ContainerNo = $('#txtContainerNo').val().toUpperCase();
        element.StuffedQty = $('#txtStuffedQty').val();
        element.StuffedWeight = $('#txtStuffedWeight').val();
        element.StuffedDate = $('#txtStuffedDate').val();
        element.CustomSeal = $('#txtCustomSeal').val();
        element.AgentSeal = $('#txtAgentSeal').val();
        element.CargoTypeID = $('#ddlCargoType').val();

        element.CargoType = $("#ddlCargoType option:selected").text();
        var TotalQty = $("#txtSBQty").val();
      var  checkSBNo = $('#txtSBNo').val();
        //var AllowQty = $("#txtStuffedQty").val();
        //var DelQty = $("#TXTTotalQty").val();
        //var maxqty = Number(DelQty) + Number(AllowQty);

        //if (parseFloat(TotalQty) < parseFloat(maxqty)) {
        //    alert("Allow Qty is not greater then total Qty!");
        //    return false;
        //}

        var table = document.getElementById("example");
        var table1 = $('#example').DataTable();
        var row;
        if (table1.rows().count() > 0) {
            if (table != null) {
                if (table.rows.length > 0) {
                    for (var i = 1; i < table.rows.length; i++) {



                        row = table.rows[i];

                        var AllowQty = $("#txtStuffedQty").val();

                        //gateInQty = row.cells[3].innerText;
                        gateInet = row.cells[2].innerText;
                        SbNos = row.cells[0].innerText;
                        if (SbNos == checkSBNo) {
                       maxqty = Number(maxqty) + Number(gateInet);
                        var values = Number(maxqty) + Number(AllowQty);

                            //if (parseFloat(TotalQty) < parseFloat(values)) {
                            //    alert("Allow Qty is not greater then total Qty!");
                            //    return false;
                            //}

                        }



                    }
                }
            }
        }
        storeAddedItem.push(element);


        $('#example').DataTable({
            "destroy": true,
            "bLengthChange": false,
            "aaData": storeAddedItem,
            "bPaginate": false,
            "bInfo": false,
            "paging": false,
            "columns": [

                { "data": "SBNo" },
                { "data": "ContainerNo" },
                { "data": "StuffedQty" },
                { "data": "StuffedWeight" },
                { "data": "StuffedDate" },

                { "data": "CustomSeal" },
                { "data": "AgentSeal" },
                { "data": "CargoType" },



                { "data": "CargoTypeID", "className": "hiderow" },


            ]
        });
        var table = document.getElementById("example");
        var row;



        var AmountTotal = 0;

        for (var i = 1; i < table.rows.length; i++) {
            row = table.rows[i];

            var Amount = row.cells[2].innerText;

            AmountTotal = Number(AmountTotal) + Number(Amount);
        }

        $("#TXTTotalQty").val(AmountTotal);

    }
       function Save() {

         debugger;

            var SelectedData = new Array();
            var tablearray = new Array();
           var GateInNo = $("#txtGateInNo").val();
           var sbentryID = $("#txtsbentryID").val();

            var table = document.getElementById("example");

            var row;
            for (var i = 1; i < table.rows.length; i++) {

                row = table.rows[i];
                SBNo = row.cells[0].innerText;
                ContainerNo = row.cells[1].innerText;
                StuffedQty = row.cells[2].innerText;
                StuffedWeight = row.cells[3].innerText;

                StuffedDate = row.cells[4].innerText;
                CustomSeal = row.cells[5].innerText;
                AgentSeal = row.cells[6].innerText;

                CargoTypeID = row.cells[8].innerText;

                SelectedData.push({
                    'SBNo': SBNo, 'ContainerNo': ContainerNo, 'StuffedQty': StuffedQty, 'StuffedWeight': StuffedWeight,
                    'StuffedDate': StuffedDate, 'CustomSeal': CustomSeal, 'AgentSeal': AgentSeal, 'CargoTypeID': CargoTypeID
                })
            }

            var data1 = {
                'Debitdata': SelectedData, 'GateInNo': GateInNo, 'sbentryID': sbentryID
            };
         var data = JSON.stringify(data1);

                          $.ajax({
                              url: "/Export/SaveStuffing",
                            data: data,
                            type: "POST",
                            contentType: "application/json; charset=utf-8",
                            dataType: "json",
                              success: function (data) {
                                  //alert(data);
                                  $('#btnSave').removeAttr('disabled', 'disabled');

                                  var array = data.split(',');
                                  var b = array[0];
                                  var c =  array[1] ;
                                  alert(b);
                                  if (b == "Record saved successfully") {
                                       //PrintWo(c )
                          document.location = '@Url.Action("Stuffing", "Export")';
                    }


                            },
                            error: function (errormessage) {
                                alert(errormessage.responseText);
                            }
                        });


    }
   
    function PrintStuffing(StuffingNo) {


        var data1 = { 'StuffingNo': StuffingNo };
        data = JSON.stringify(data1);

        $.ajax({
            url: '/Export/ExportPrintStuffing',
            type: 'Post',
            data: data,
            async: false,
            contentType: 'application/json; charset=utf-8',
            success: function (response) {

                var myWindow = window.open("", "MsgWindow1", 'width=' + screen.availWidth + ',height=' + screen.availHeight + ',resizable=no');
                myWindow.close();
                var myWindow = window.open("", "MsgWindow1", 'width=' + screen.availWidth + ',height=' + screen.availHeight + ',resizable=no');
                myWindow.document.write(response);
            },
            error: function (error) {
                let str = error.responseText;
                var a = str.indexOf("<title>") + 7;
                var b = str.indexOf("</title>");
                str = str.substring(a, b);
                alert("Something went wrong: " + str);
            }
        });
    };
    function CancelStuffing(ID) {

        if (confirm("Are you sure you want to cancel this stuffing entry?")) {

            $.ajax({
                type: "POST",
                url: "/Export/CancelStuffing",
                data: { ID: ID },
                success: function (response) {

                    if (response.status === "success") {
                        alert(response.message);
                        location.reload();
                    } else {
                        alert("Error: " + response.message);
                    }
                },
                error: function (xhr) {
                    alert("Error: " + (xhr.responseText || "Something went wrong"));
                }
            });
        }
    }


</script>