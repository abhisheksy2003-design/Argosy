@*@model TransportEntities.BusinessEntities.Horse*@
@{
    ViewBag.Title = "PortMaster";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}

<script src="~/js/GetTableJson.js"></script>
<style>
    /*.table thead th, .text-wrap table thead th {
        background-color: #151517b5;
        color: white;
    }*/

    table.table-bordered.dataTable tbody th, table.table-bordered.dataTable tbody td {
        color: black;
        font-weight: 900 !important;
        font-size: 15px !important;
    }

    .hiderow {
        display: none;
    }
</style>

<div id="DivaddPort">
    <div class="page-header">
        <h4 class="page-title">Port Master</h4>
        <div class="form-group">
            <label class="form-label"></label>
            <div class="row gutters-xs">
                <div class="col">
                    <a onclick="Viewsummary();" class="btn btn-added p-3 me-2 text-right" style="align-content:center;color:white"><i class="fa fa-file-text" data-placement="bottom" title=""></i> </a>


                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <div class="form-horizontal">
                        <div class="row">
                            <div class="col-lg-3 col-sm-12">
                                <div class="form-group">
                                    <label class="form-label mandatory">Port ID </label>
                                    <div class="row gutters-xs">
                                        <div class="col">
                                            <input ID="txtPortID" type="text" placeholder="New" readonly="readonly" class="form-control" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                       
                            <div class="col-lg-3 col-sm-12">
                                <div class="form-group">
                                    <label class="form-label mandatory">Port</label>
                                    <div class="row gutters-xs">
                                        <div class="col">
                                            <input ID="txtPort" type="text" placeholder="Port" class="form-control" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="row" style="display:none">
                        <div class="col-lg-2 col-xs-12">
                            <div class="form-group">
                                <label class="form-label mandatory" style="visibility:hidden">.</label>
                                <label class="custom-switch">
                                    <input type="checkbox" name="custom-switch-checkbox" id="chkIsActiveEdit" checked class="custom-switch-input">
                                    <span class="custom-switch-indicator"></span>
                                    <span class="custom-switch-description">Is Active?</span>
                                </label>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="form-label"></label>
                        <div class="row gutters-xs">
                            <div class="col">
                                @*<input type="submit" id="Save" name="save" value="Save" class="btn btn-success" />*@
                                <button id="btnSave" class="btn btn-submit p-2" onclick="return Save();">Save</button>
                                @*<button class="btn btn-secondary me-2" type="button" id="clear"><i class="fa fa-undo"></i></button>*@
                                <button type="button" class="btn btn-cancel" onclick="Clear()" name="clearProfile" title="clear" id="clearValue">Clear</button>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class=" content-area" id="DivShowPort" style="display:none">
    <div class="page-header">
        <h4 class="page-title">Port Details Summary</h4>
        <div class="ibox-content  text-right">

            <a onclick="getBack();" class="btn btn-added p-3 me-2" style="color:white;align-content:center;"><i class="fa fa-arrow-left" data-toggle="tooltip" data-placement="bottom" title="" data-original-title="Back"></i>  </a></li>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12 col-lg-12">
            <div class="card">
                <div class="card-body">
                    @*@Html.ActionLink("Export To Excel", "ExportToExcel", null, new { @class = "btn btn-success btn-md" })*@
                    <div class="row">
                        <div class="col-lg-12 col-sm-12">
                            <div class="table-responsive">
                                <table id="example2" class="table table-bordered table-hover tbl-cart text-nowrap" style="width:100%">
                                    <thead>

                                        <tr>

                                        </tr>
                                    </thead>

                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<script>
    function Clear() {

        Port.reload();

    }

    function Save() {


        var ID = $("#txtPortID").val();
            var Port = $('#txtPort').val();



            var PortMaster = {};
            //PortMaster.EntryDate = txtentryDate;
            PortMaster.PortName = Port;

        PortMaster.ID = ID;

                $.ajax({
                    url: "/Master/SavePortMaster",
                    data: '{PortMaster: ' + JSON.stringify(PortMaster) + '}',
                type: "POST",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                    success: function (data) {
                    if (data == "Port already present! please check")
                    {
                        alert(data);
                    }
                    else
                    {
                        alert("Port Save");
                        window.Port.href = '@Url.Action("PortMaster", "PortMaster")';
                    }


                },
                error: function (errormessage) {
                alert(errormessage.responseText);
                }
                });
        }


</script>

<script type="text/javascript">
    function getBack() {
        $("#DivaddPort").show();
        $("#DivShowPort").hide();
    }
   
</script>


<script type="text/javascript">

    function Viewsummary() {
        $("#DivaddPort").hide();
        $("#DivShowPort").show();


        $.ajax({
            type: 'POST',
            url: '/Master/AjaxGetPortDetails',
            //  data: data,
            // data: "",
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            async: true,
            success: function (jsonResult) {
                $("#example2").empty();
                RepTableDataJson($("#example2"), jsonResult, "Port Details", "PortDetails_List");
                $("#global-loader").fadeOut("slow");
            },
            error: function (errormessage) {
                alert(errormessage.responseText);
                $("#global-loader").fadeOut("slow");
            }
        });
    }


    function EditPortDetails1(PortID) {
        $("#DivaddPort").show();
        $("#DivShowPort").hide();

        var data1 = { 'PortID': PortID };
        var data = JSON.stringify(data1);

        $.ajax({
            type: 'POST',
            url: '/Master/GetPortDetails',
            data: data,
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (data) {

                $('#txtPort').val(data[0].Port);
                $('#ddlDistancegroup').val(data[0].DistanceGroupID);
                $('#ddlPortList').val(data[0].PortGroupID);
                $('#txtOnWayKM').val(data[0].OnWayKM);
                $('#txtTwoWayKM').val(data[0].TwoWayKM);
                $('#txtPortID').val(data[0].ID);
            },
            error: function (errormessage) {
                alert(errormessage.responseText);
                $("#global-loader").fadeOut("slow");
            }
        });
    }


</script>