    function formatDate(d) {
        return new Date(d).toISOString();  // gives yyyy-MM-ddTHH:mm:ss
    }



    function ShowSummary() {

        try {

            // Get values from input fields
            var fromDate = $("#txtFromdate").val();
            var toDate = $("#txtTodate").val();


            // Prepare data object
            var data = {
                fromDate: fromDate,
                toDate: toDate
            };
            //var data = {
            //    fromDate: formatDate($("#txtFromdate").val()),
            //    toDate: formatDate($("#txtTodate").val())
            //};


            $.ajax({
                url: "/Export/GetCartingEntrySummary",
                data: JSON.stringify(data),
                type: "POST",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (response) {

                    RepTableDataJsonwopaging($("#tblCartingEntrySummary"), response, "CreateSearch", "CreateSearch")
                },
                error: function (errormessage) {
                    alert("error");
                    alert(errormessage.responseText);
                }
            });

        } catch (ex) {

        }
    }


    function Cancel() {
        location.reload();
    }

    function EntryType() {
        var EntryType = $("#ddlEntryType").val();

        if (EntryType == "Dock-Stuff") {
            $("#divContainer").hide();
            $("#divSize").hide();
            $("#TypeII").hide();
            $("#divRemarks").hide();
        }
        if (EntryType == "On-Wheel") {
            $("#divContainer").show();
            $("#divSize").show();
            $("#TypeII").show();
            $("#divRemarks").show();

        }

    }
