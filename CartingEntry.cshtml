    function AutomCom() {
        debugger;
        $("#ddlCustomer").autocomplete({
            source: function (request, response) {
                $.ajax({
                    url: "/BookingEntry/getCustomerName",
                    data: "{ 'prefixText': '" + request.term + "'}",
                    dataType: "json",
                    type: "POST",
                    contentType: "application/json; charset=utf-8",
                    success: function (data) {
                        //debugger;
                        response($.map(data, function (item) {
                            //debugger;
                            return {
                                label: item.AGName,
                                val: item.AGID,
                            };
                        }))
                    },
                    error: function (response) {
                        alert(response.responseText);
                    },
                    failure: function (response) {
                        alert(response.responseText);
                    }
                })
            },
            select: function (e, i) {

                $("#ddlCustomer").val(i.item.label);
                $("#hdnCustomerId").val(i.item.val);
            },
            minLength: 1
        });
        $("#ddlExporter").autocomplete({
            source: function (request, response) {
                $.ajax({
                    url: "/BookingEntry/getExporterName",
                    data: "{ 'prefixText': '" + request.term + "'}",
                    dataType: "json",
                    type: "POST",
                    contentType: "application/json; charset=utf-8",
                    success: function (data) {

                        response($.map(data, function (item) {

                            return {
                                label: item.AGName,
                                val: item.AGID,
                            };
                        }))
                    },
                    error: function (response) {
                        alert(response.responseText);
                    },
                    failure: function (response) {
                        alert(response.responseText);
                    }
                })
            },
            select: function (e, i) {
                //debugger;
                $("#ddlExporter").val(i.item.label);
                $("#hdnExporterId").val(i.item.val);

                GetExporterAddress();
            },
            minLength: 1
        });
        $("#ddlCHA").autocomplete({
            source: function (request, response) {
                $.ajax({
                    url: "/BookingEntry/getCHAName",
                    data: "{ 'prefixText': '" + request.term + "'}",
                    dataType: "json",
                    type: "POST",
                    contentType: "application/json; charset=utf-8",
                    success: function (data) {
                        //debugger;
                        response($.map(data, function (item) {
                            //debugger;
                            return {
                                label: item.AGName,
                                val: item.AGID,
                            };
                        }))
                    },
                    error: function (response) {
                        alert(response.responseText);
                    },
                    failure: function (response) {
                        alert(response.responseText);
                    }
                })
            },
            select: function (e, i) {
                //debugger;
                $("#ddlCHA").val(i.item.label);
                $("#hdnCHAId").val(i.item.val);
            },
            minLength: 1
        });

    };


