                $("#hdnCustomerId").val(data.CUSTOMERID);
                $("#ddlCargoType").val(data.CargoTypeID);
                $("#ddlCargingEquipment").val(data.CartingEquipmentID);
                $("#txtTemperature").val(data.Temp);
                $("#txtHumidity").val(data.Humidity);
