    function AddDetails() {
        debugger;

        var AGName = $("#ddlCustomer").val();

        // --- Customer Validation ---
        if (AGName === "" || AGName === "0" || AGName == null) {
            alert("Please select Customer.");
            $("#ddlCustomer").focus();
            return false;
        }

        // If Customer has value → CheckName call
        if (AGName !== "") {
            var Name = $("#ddlCustomer").val();
            var Type = 'Customer';
            CheckName(Type, Name);
            return false;
        }

        // --- CHA Validation ---
        var CHAName = $("#ddlCHA").val();

        if (CHAName === "" || CHAName === "0" || CHAName == null) {
            alert("Please select CHA.");
            $("#ddlCHA").focus();
            return false;
        }

        // If CHA has value → CheckName call
        if (CHAName !== "") {
            var Name = $("#ddlCHA").val();
            var Type = 'CHA';
            CheckName(Type, Name);
            return false;
        }
    }

    function CheckName(Type, Name) {


        var data1 = { 'Type': Type, 'Name': Name };
        var data = JSON.stringify(data1);

        $.ajax({
            url: "/BookingEntry/CheckName",
            data: data,
            type: "POST",
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (Data) {


                if (Data != "") {
                    alert(Data);
                    return false;
                }
                else {
                    var id = parseInt($("#txtID").val());

                    if (id > 0) {
                        AddforEdit();
                    } else {
                        Add();
                    }

                }


            },
            error: function (error) {
                let str = error.responseText;
                var a = str.indexOf("<title>") + 7;
                var b = str.indexOf("</title>");
                str = str.substring(a, b);
                alert("Something went wrong: " + str);
            }
        });
    }


function Save() {

    debugger;

    var entryType = $("#ddlEntryType").val();
    var customerid = $("#ddlCustomer").val();
    var entryId = $("#txtID").val();

    if (entryType === "" || entryType === "0" || entryType == null) {
        alert("Please select Entry Type.");
        $("#ddlEntryType").focus();
        return false;
    } if (customerid === "" || customerid === "0" || customerid == null) {
        alert("Please select Customer.");
        $("#ddlCustomer").focus();
        return false;
    }

    var table = document.getElementById("example");

    if (table.rows.length <= 1) {
        alert("At least one record is required.");
        return false;
    }

    var SelectedData = [];

    for (var i = 1; i < table.rows.length; i++) {

        var row = table.rows[i];

        SelectedData.push({
            'SBNo': row.cells[0].innerText,
            'SBDate': row.cells[1].innerText,
            'SBQty': row.cells[2].innerText,
            'SBWeight': row.cells[3].innerText,
            'PODID': row.cells[4].innerText,
            'FPDID': row.cells[5].innerText,
            'VehicelNo': row.cells[6].innerText,
            'CartedQty': row.cells[7].innerText,
            'CartingDate': row.cells[8].innerText,
            'CargoDescrition': row.cells[11].innerText,

            'CHAID': row.cells[14].innerText,
            'CUSTOMERID': row.cells[15].innerText,
            'CargoTypeID': row.cells[16].innerText,
            'EquipmentID': row.cells[17].innerText,
            'ContainerNo': row.cells[18].innerText,
            'size': row.cells[19].innerText,
            'Type': row.cells[20].innerText,
            'Remarks': row.cells[21].innerText,
            'EntryType': $("#ddlEntryType").val(),
            'UANNo': row.cells[22].innerText,
            'Class': row.cells[23].innerText,
            'PackingGroupID': row.cells[24].innerText,
            'PackageTypeID': row.cells[26].innerText,
            'Exporter': row.cells[28].innerText,
            'ExporterAddress': row.cells[29].innerText,
            'Consignee': row.cells[30].innerText,
            'ConsigneeAddress': row.cells[31].innerText,
            'POD': row.cells[32].innerText,
            'FPD': row.cells[33].innerText,
            'FOBValue': row.cells[34].innerText,
            'Temp': row.cells[35].innerText,
            'Humidity': row.cells[36].innerText,
            'Vent': row.cells[37].innerText,
        });
    }

    var data1 = { 'Debitdata': SelectedData, 'EntryType': entryType, 'EntryId': entryId };
    var data = JSON.stringify(data1);

    $.ajax({
        url: "/Export/SaveCarting",
        data: data,
        type: "POST",
        contentType: "application/json; charset=utf-8",
        dataType: "json",
        success: function (data) {
            $("#TripSearch").show();

            $('#btnSave').removeAttr('disabled', 'disabled');

            var array = data.split(',');
            var message = array[0];

            alert(message);

            if (message == "Record saved successfully") {
                document.location = '@Url.Action("CartingEntry", "Export")';
            }
        },
        error: function (errormessage) {
            alert(errormessage.responseText);
        }
    });

}




    function GetDetailsBySBNo() {

        var SBNo = $("#txtSBNo").val();
        var SBDate = $("#txtSBDate").val();

        if (SBNo == "" || SBNo == null) {
            alert("Please enter SB No.");
            $("#txtSBNo").focus();
            return;
        }

        $.ajax({
            url: "/Export/GetDetailsBySBNo",
            type: "GET",
            data: { SBNo: SBNo, SBDate: SBDate },
            success: function (data) {

                if (data == null) {
                    alert("No record found for this SB No.");
                    return;
                }

                alert("Already Entry done Today for this SB No");

                //$("#ddlEntryType").val(data.EntryType);
                //$("#txtSBNo").val(data.SBNo);
                //$("#txtSBDate").val(data.SBDate);
                $("#txtSBQty").val(data.SBQty);
