    }

    function CargoTypeChange() {

        var cargotype = $("#ddlCargoType option:selected").text();


        if (cargotype === "REF") {
            $("#dvREF").show();
            $("#dvHAZ").hide();
        }
        else if (cargotype === "HAZ") {
            $("#dvREF").hide();
            $("#dvHAZ").show();

        }
        else {
            $("#dvREF").hide();
            $("#dvHAZ").hide();
        }

    }


