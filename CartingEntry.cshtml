
@{
    ViewBag.Title = "SB Carting Details";
    Layout = "~/Views/Shared/_LayoutDashboard.cshtml";
}

<style>
    /*.table thead th, .text-wrap table thead th {
        background-color: #151517b5;
        color: white;
    }*/

    table.table-bordered.dataTable tbody th, table.table-bordered.dataTable tbody td {
        color: black;
        font-weight: 900 !important;
        font-size: 15px !important;
    }

    .hiderow {
        display: none;
    }
</style>
<script src="~/js/sweet-alert.js"></script>
<script src="~/js/GetTableJsonwopaging.js"></script>
<script src="~/js/GetTableJson.js"></script>
<div class=" content-area" id="DIvCompantMaster">
    <div class="page-header">
        <h4 class="page-title" id="New">Shipping Bill Carting Details</h4>
        <div class="form-group">
            <label class="form-label"></label>
            <div class="row gutters-xs">
                <div class="col">
                    <button type="button" class="btn btn-success" title="Summary list" onclick="ViewSummary();">Summary</button>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-12 col-lg-12" style="margin-top:-30px;">
        <div class="row">
            <div class="card">
                <div class="card-body">
                    <div class="row">
                        <div class="col-lg-2 col-sm-3">
                            <div class="form-group">
                                <label class="form-label mandatory">Entry Type</label>
                                <div class="row gutters-xs">
                                    <div class="col">
                                        <select class="form-select" id="ddlEntryType" onchange="EntryType()">
                                            <option value="0">--Select--</option>
                                            <option value="Dock-Stuff">Dock-Stuff</option>
                                            <option value="On-Wheel">On-Wheel</option>

                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-2 col-sm-3 ">
                            <div class="form-group">
                                <label class="form-label mandatory">SB No</label>
                                <div class="row gutters-xs">
                                    <div class="col">
                                        <input ID="txtSBNo" type="text" placeholder="New" class="form-control" />
                                        <input ID="txtID" type="hidden" class="form-control" value="0"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-2 col-sm-12">
                            <div class="form-group">
                                <label class="form-label mandatory">SB Date</label>
                                <div class="row gutters-xs">
                                    <div class="col">
                                        @Html.TextBox("txtSBDate", null, new { @class = "form-control datePicker1", @id = "txtSBDate", name = "txtSBDate", autocomplete = "on", @Value = DateTime.Now.ToString("dd MMM yyyy") })

                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-3 col-sm-12">
                            <div class="form-group">
                                <label class="form-label" style="visibility:hidden"> '</label>
                                <div class="row gutters-xs">
                                    <div class="col">

                                        <button class="btn btn-filters" id="TripSearch" type="button" onclick="GetDetailsBySBNo()"> <img src="/assets/images/icons/search-whites.svg" alt="img"></button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-lg-2 col-sm-12">
                            <div class="form-group">
                                <label class="form-label mandatory">SB Qty</label>
                                <div class="row gutters-xs">
                                    <div class="col">
                                        <input ID="txtSBQty" type="text" placeholder="SB Qty" class="form-control" />
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-2 col-sm-12">
                            <div class="form-group">
                                <label class="form-label mandatory">SB Weight</label>
                                <div class="row gutters-xs">
                                    <div class="col">
                                        <input ID="txtSBWeight" type="text" placeholder="SB Weight" class="form-control" />

                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-2 col-sm-12">
                            <div class="form-group label-floating">
                                <label class="form-label">Package Type</label>
                                @Html.DropDownList("ddlPkgType", (IEnumerable<SelectListItem>)ViewBag.PackageIGMList, "--Select--", new { @class = "form-select", @id = "ddlPkgType", name = "ddlPkgType", autocomplete = "off" })

                            </div>

                        </div>
                        <div class="col-lg-2 col-sm-12">
                            <div class="form-group">
                                <label class="form-label mandatory">Cargo Type</label>
                                <div class="row gutters-xs">
                                    <div class="col">
                                        @Html.DropDownList("ddlCargoType", (IEnumerable<SelectListItem>)ViewBag.ExportEntry, "--Select--", new { @class = "form-select", @id = "ddlCargoType", name = "ddlCargoType", autocomplete = "off", onchange = "CargoTypeChange()" })
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-4 col-sm-12">
                            <div class="form-group">
                                <label class="form-label">Cargo Descrition</label>

                                <div class="row gutters-xs">
                                    <div class="col">
                                        <input type="text" placeholder="Cargo Descrition" class="form-control" id="ddlCargoDescrition" />

                                    </div>

                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="row">
                        <div class="col-lg-6 col-sm-12">
                            <div class="form-group">
                                <label class="form-label">CHA</label>

                                <div class="row gutters-xs">
                                    <div class="col">
                                        <input type="text" placeholder="CHA" class="hdnCHAId form-control" id="ddlCHA" />
                                        <input type="hidden" class="form-control" id="hdnCHAId" />
                                    </div>

                                </div>
                            </div>
                        </div>
                        <div class="col-lg-6 col-sm-12" id="divCustomerName">
                            <div class="form-group">
                                <label class="form-label">Customer</label>

                                <div class="row gutters-xs">
                                    <div class="col">
                                        <input type="text" placeholder="Customer" class="form-control" id="ddlCustomer" />
                                        <input type="hidden" class="form-control" id="hdnCustomerId" />
                                    </div>

                                </div>
                            </div>
                        </div>

                    </div>
                    <div class="row">
                        <div class="col-lg-6 col-sm-12">
                            <div class="form-group">
                                <label class="form-label">Exporter</label>

                                <div class="row gutters-xs">

                                    <div class="col">
                                        <input type="text" placeholder="Exporter" class="form-control" id="ddlExporter" />
                                        <input type="hidden" class="form-control" id="hdnExporterId" />
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-6 col-sm-12">
                            <div class="form-group">
                                <label class="form-label">Exporter Address</label>

                                <div class="row gutters-xs">
                                    <div class="col">
                                        <input type="text" id="txtExporterAddress" placeholder="Exporter Address" class="form-control" />

                                    </div>

                                </div>
                            </div>
                        </div>



                    </div>
                    <div class="row">
                        <div class="col-lg-6 col-sm-12">
                            <div class="form-group">
                                <label class="form-label">Consignee</label>

                                <div class="row gutters-xs">
                                    <div class="col">
                                        <input type="text" placeholder="Consignee" class="form-control" id="txtConsignee" />

                                    </div>

                                </div>
                            </div>
                        </div>
                        <div class="col-lg-6 col-sm-12">
                            <div class="form-group">
                                <label class="form-label">Consignee Address</label>

                                <div class="row gutters-xs">
                                    <div class="col">
                                        <input type="text" placeholder="Consignee Address" class="form-control" id="txtConsigneeAddress" />

                                    </div>

                                </div>
                            </div>
                        </div>



                    </div>
                    <div class="row">
                        <div class="col-lg-3 col-sm-12">
                            <div class="form-group">
                                <label class="form-label mandatory">POD</label>
                                <div class="row gutters-xs">
                                    <div class="col">
                                        <input type="text" class="form-control" id="ddlPOL" />
                                        @*<input type="hidden" class="form-control" id="hdnPOLID" />*@
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-3 col-sm-12">
                            <div class="form-group">
                                <label class="form-label mandatory">FPD</label>
                                <div class="row gutters-xs">
                                    <div class="col">
                                        <input type="text" class="form-control" id="ddlFPD" />
                                        @*<input type="hidden" class="form-control" id="hdnFPDID" />*@
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-2 col-sm-12">
                            <div class="form-group">
                                <label class="form-label mandatory">FOB Value</label>
                                <div class="row gutters-xs">
                                    <div class="col">
                                        <input ID="txtFOBValue" type="text" placeholder="FOB Value" class="form-control" />

                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-2 col-sm-12" style="display:none">
                            <div class="form-group">
                                <label class="form-label mandatory">Vehicle No</label>
                                <div class="row gutters-xs">
                                    <div class="col">
                                        <input ID="txtVehicelNo" type="text" placeholder="Vehicel No" class="form-control" />
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-2 col-sm-12" style="display:none">
                            <div class="form-group">
                                <label class="form-label mandatory">Carted Qty</label>
                                <div class="row gutters-xs">
                                    <div class="col">
                                        <input ID="txtCartedQty" type="text" placeholder="Carted Qty" class="form-control" />

                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-2 col-sm-12" style="display:none">
                            <div class="form-group">
                                <label class="form-label mandatory">Carting Date</label>
                                <div class="row gutters-xs">
                                    <div class="col">
                                        @Html.TextBox("txtCartingDate", null, new { @class = "form-control datePicker1", @id = "txtCartingDate", name = "txtCartingDate", autocomplete = "on", @Value = DateTime.Now.ToString("dd MMM yyyy") })

                                    </div>
                                </div>
                            </div>
                        </div>


                        <div class="col-lg-3 col-sm-12" style="display:none">
                            <div class="form-group">
                                <label class="form-label mandatory">Carting Equipment</label>
                                <div class="row gutters-xs">
                                    <div class="col">
                                        @Html.DropDownList("ddlCargingEquipment", (IEnumerable<SelectListItem>)ViewBag.Equipment, "--Select--", new { @class = "form-select", @id = "ddlCargingEquipment", name = "ddlCargingEquipment", autocomplete = "off" })
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-2 col-sm-3" id="divContainer" style="display:none">
                            <div class="form-group">
                                <label class="form-label mandatory">Container No</label>
                                <div class="row gutters-xs">
                                    <div class="col">
                                        <input ID="txtContainerNo" type="text" placeholder="Container No" maxlength="11" class="form-control text-uppercase" />
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-2 col-sm-6" id="divSize" style="display:none">
                            <div class="form-group">
                                <label class="form-label">Size</label>
                                <div class="row gutters-xs">
                                    <div class="col">
                                        <select class="form-control form-control-lg" id="ddlsize">
                                            <option value="0">--Select--</option>
                                            <option value="20">20</option>
                                            <option value="40">40</option>
                                            <option value="45">45</option>

                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-2 col-sm-6" id="TypeII" style="display:none">
                            <div class="form-group">
                                <label class="form-label">Type</label>
                                <div class="row gutters-xs">
                                    <div class="col">
                                        @Html.DropDownList("ddlType", (IEnumerable<SelectListItem>)ViewBag.ContainerTypeEntry, "--Select--", new { @class = "form-control form-control-lg", @id = "ddlType", name = "ddlType", autocomplete = "off" })
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-5 col-sm-12" id="divRemarks" style="display:none">
                            <div class="form-group">
                                <label class="form-label">Remarks</label>

                                <div class="row gutters-xs">
                                    <div class="col">
                                        <input type="text" placeholder="Remarks" class="form-control" id="txtRemarks" />

                                    </div>

                                </div>
                            </div>
                        </div>
                        <div class="col-md-1 col-xs-4">
                            <div class="form-group">
                                <label class="form-label mandatory" style="visibility:hidden">.</label>
                                <div class="row gutters-xs">
                                    <div class="col">
                                        <button class="btn btn-primary me-2" id="btnAdd" onclick="return AddDetails();"><i class="fa fa-plus" aria-hidden="true"></i></button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row" id="dvHAZ" style="display:none;">
                            <div class="col-lg-2 col-sm-12">
                                <div class="form-group">
                                    <label class="form-label">Class</label>
                                    <div class="row gutters-xs">
                                        <div class="col">
                                            <input ID="txtClass" type="text" placeholder="Enter Class" class="form-control" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-2 col-sm-12">
                                <div class="form-group">
                                    <label class="form-label">UN NO</label>
                                    <div class="row gutters-xs">
                                        <div class="col">
                                            <input ID="txtUANNo" type="text" placeholder="Enter UAN No" class="form-control" />
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-lg-2 col-sm-12">
                                <div class="form-group">
                                    <label class="form-label">Packing Group</label>
                                    <div class="row gutters-xs">
                                        <div class="col">
                                            <select class="form-select" id="ddlPackingGroup">
                                                <option value="I" selected>I</option>
                                                <option value="II">II</option>
                                                <option value="III">III</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div id="dvREF" class="row" style="display:none;">
                            <div class="col-lg-2 col-sm-12">
                                <div class="form-group">
                                    <label class="form-label">Temp</label>
                                    <div class="row gutters-xs">
                                        <div class="col">
                                            <input ID="txtTemperature" type="text" placeholder="Enter Temperature" class="form-control" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-2 col-sm-12">
                                <div class="form-group">
                                    <label class="form-label">HUM</label>
                                    <div class="row gutters-xs">
                                        <div class="col">
                                            <input ID="txtHumidity" type="text" placeholder="Enter Humidity" class="form-control" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-2 col-sm-12">
                                <div class="form-group">
                                    <label class="form-label">Vent.</label>
                                    <div class="row gutters-xs">
                                        <div class="col">
                                            <input ID="txtVentilation" type="text" placeholder="Enter Ventilation" class="form-control" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                    <div class="row">
                        <div class="col-md-12 col-lg-12">
                            <div>
                                @*<label class="form-label">Details </label>*@
                            </div>
                            <div class="table-responsive">
                                <table class="table table-striped table-bordered" id="example" style="width:100%">
                                    <thead>
                                        <tr>



                                            <th class="wd-5p sorting">SB No</th>
                                            <th class="wd-15p sorting">SB Date</th>
                                            <th class="wd-10p sorting">SB Qty</th>
                                            <th class="wd-10p sorting">SB Weight</th>
                                            <th class="wd-10p sorting">POD</th>
                                            <th class="wd-10p sorting">FPD</th>
                                            <th class="hiderow">Vehicel No</th>
                                            <th class="hiderow">Carted Qty</th>
                                            <th class="hiderow">Carting Date</th>
                                            <th class="wd-10p sorting">CHA</th>
                                            <th class="wd-10p sorting">Customer</th>
                                            <th class="wd-10p sorting">Cargo Descrition</th>
                                            <th class="wd-10p sorting">Cargo Type</th>
                                            <th class="hiderow">Carting Equipment</th>

                                            <th class="hiderow">CHAId</th>
                                            <th class="hiderow">CustomerId</th>
                                            <th class="hiderow">CargoTypeID</th>
                                            <th class="hiderow">CartingEquipmentID</th>
                                            <th class="wd-10p sorting">Container No</th>
                                            <th class="wd-10p sorting">Size</th>
                                            <th class="wd-10p sorting">Type</th>
                                            <th class="wd-10p sorting">Remarks</th>
                                            <th class="wd-10p sorting">UN No</th>
                                            <th class="wd-10p sorting">Class</th>
                                            <th class="wd-10p sorting">Packing Group</th>
                                            <th class="wd-10p sorting">Package Type</th>
                                            <th class="hiderow">PackageTypeID</th>
                                            <th class="wd-10p sorting">Exporter</th>
                                            <th class="hiderow">ExporterID</th>
                                            <th class="wd-10p sorting">Exporter Address</th>
                                            <th class="wd-10p sorting">Consignee</th>
                                            <th class="wd-10p sorting">Consignee Address</th>
                                            <th class="hiderow">PODId</th>
                                            <th class="hiderow">FPDId</th>
                                            <th class="wd-10p sorting">FOBValue</th>
                                            <th class="wd-10p sorting">Temp</th>
                                            <th class="wd-10p sorting">Humidity</th>
                                            <th class="wd-10p sorting">Vent</th>
                                            <th class="wd-5p">Action</th>
                                        </tr>
                                    </thead>
                                </table>
                            </div>
                        </div>
                    </div>

                    <div class="row p-2">
                        <div class="col-md-3 col-xs-12">
                            <div class="d-flex align-items-center">

                                <!-- Save Button -->
                                <button class="btn btn-save px-4" id="btnSave" onclick="return Save(); " style="margin-right:10px">
                                    Save
                                </button>

                                <!-- Cancel Button -->
                                <button class="btn btn-cancel px-4" id="btnCancel" onclick="Cancel();">
                                    Cancel
                                </button>

                            </div>
                        </div>
                    </div>



                </div>
            </div>
        </div>
    </div>
</div>

<div class=" content-area" id="DivSummary" style="display:none">
    <div class="page-header">
        <h4 class="page-title">Carting Entry Summary</h4>
        <div class="ibox-content  text-right">
            <a onclick="getBack();" class="btn btn-added" style="color:white;align-content:center;">   Add</a>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12 col-lg-12">
            <div class="card">
                <div class="card-body">

                    <div class="row">
                        <div class="col-lg-2 col-sm-12">
                            <div class="form-group">
                                <label class="form-label">From Date <span class="text-danger">*</span></label>
                                <div class="row gutters-xs">
                                    <div class="col">
                                        @Html.TextBox("txtFromdate", null, new
                                        {
                                            @class = "form-control form_datetime1 ",
                                       @id = "txtFromdate",
                                            autocomplete = "off",
                                            @Value = DateTime.Now.ToString("dd MMM yyyy 00:00")
                                        })
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-2 col-sm-12">
                            <div class="form-group">
                                <label class="form-label">To Date <span class="text-danger">*</span></label>
                                <div class="row gutters-xs">
                                    <div class="col">
                                        @Html.TextBox("txtTodate", null, new
                                        {
                                            @class = "form-control form_datetime1 ",
                                       @id = "txtTodate",
                                            autocomplete = "off",
                                            @Value = DateTime.Now.ToString("dd MMM yyyy 23:59")
                                        })
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-2 col-sm-12">
                            <div class="form-group">
                                <label class="form-label" style="visibility:hidden">.</label>
                                <div class="row gutters-xs">
                                    <div class="col-2">
                                        <button type="button" class="btn btn-icon btn-filters"
                                                title="Show Summary" id="btnShow" onclick="ShowSummary()">
                                            <i class="fa fa-search"></i>
                                        </button>
                                    </div>

                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="row">

                        <div class="table-responsive">
                            <table class="table table-bordered table-hover tbl-cart text-nowrap" id="tblCartingEntrySummary"></table>
                        </div>
                    </div>


                </div>
            </div>
        </div>
    </div>
</div>

