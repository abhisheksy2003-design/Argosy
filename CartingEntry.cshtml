    function EditCartingEntry(id) {

        console.log("Edit ID:", id);
        $("#TripSearch").hide();

        $("#global-loader").fadeIn("slow");
        $("#DIvCompantMaster").show();
        $("#DivSummary").hide();
        //$("#txtID").value(id);

        $.ajax({
            type: "POST",
            url: "/Export/SBCartingEntryDetails",
            data: JSON.stringify({ id: id }),
            contentType: "application/json; charset=utf-8",
            success: function (data) {
                $("#btnSave").text("Update");
                let rows = JSON.parse(data);
                console.log("Edit Data:", rows);

                if (!rows || rows.length === 0) {
                    alert("No data found");
                    $("#global-loader").fadeOut("slow");
                    return;
                }

                let r = rows[0];

                /* ---------- BASIC ---------- */
                $("#txtID").val(r.ID);
                console.log(r.ID);
                $("#txtSBNo").val(r.SBNo);
                $("#txtSBQty").val(r.SBQty);
                $("#txtSBWeight").val(r.SBWeight);
                $("#txtFOBValue").val(r.FOBValue);

                if (r.SBDate) {
                    let d = new Date(r.SBDate);
                    $("#txtSBDate").val(d.toISOString().split("T")[0]);
                }

                /* ---------- DROPDOWNS ---------- */
                $("#ddlEntryType").val(r.EntryType).trigger("change");
                $("#ddlCargoType").val(r.CargoTypeID).trigger("change");
                $("#ddlPkgType").val(r.PackageTypeID).trigger("change");
                $("#ddlPackingGroup").val(r.PackingGroupID);

                /* ---------- TEXT / AUTOCOMPLETE ---------- */
                $("#ddlCHA").val(r.CHA);
                $("#hdnCHAId").val(r.CHAID);

                $("#ddlCustomer").val(r.Customer);
                $("#hdnCustomerId").val(r.CustomerID);
                $("#ddlExporter").val(r.Exporter);
                $("#hdnExporterId").val(r.ExporterID);
                $("#txtExporterAddress").val(r.ExporterAddress);
                $("#txtConsignee").val(r.Consignee);
                $("#txtConsigneeAddress").val(r.ConsigneeAddress);

                $("#ddlCargoDescrition").val(r.CargoDescrition);

                /* ---------- POD / FPD ---------- */
                $("#ddlPOL").val(r.POD);
                $("#ddlFPD").val(r.FPD);

                /* ---------- HIDDEN / OPTIONAL ---------- */
                $("#txtVehicelNo").val(r.VehicelNo);
                $("#txtCartedQty").val(r.CartedQty);
                $("#txtCartingDate").val(r.CartingDate);

                $("#txtContainerNo").val(r.ContainerNo);
                $("#ddlsize").val(r.Size);
                $("#ddlType").val(r.Type);
                $("#txtRemarks").val(r.Remarks);

                $("#txtUANNo").val(r.UANNo);
                $("#txtClass").val(r.Class);
                $("#txtTemperature").val(r.Temp);
                $("#txtHumidity").val(r.Humidity);
                $("#txtVentilation").val(r.Vent);

                /* ---------- MODE ---------- */
                $("#btnSave").show();
                $("#global-loader").fadeOut("slow");
            },
            error: function (err) {
                alert(err.responseText);
                $("#global-loader").fadeOut("slow");
            }
        });
    }

