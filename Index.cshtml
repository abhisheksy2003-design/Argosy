@{
    ViewBag.Title = "Login";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    /* 🌈 Perfect Radial Background */
    body {
        background-color: #f0f2f5; /* A very light grey background */
    }

    .radial-bg {
        width: 100%;
        min-height: 100vh;
        background: radial-gradient(circle at top left, #dce7ff, #eef2ff, #ffffff);
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 20px; /* Added padding for smaller screens */
    }

    .login-container {
        display: flex;
        width: 90%;
        max-width: 850px; /* Slightly wider */
        background: #fff;
        border-radius: 18px;
        box-shadow: 0px 4px 30px rgba(0, 0, 0, 0.08); /* Softer shadow */
        overflow: hidden;
    }

    /* Left Section */
    .login-left {
        flex: 1;
        padding: 40px 50px; /* More padding on sides */
        display: flex;
        flex-direction: column;
        justify-content: center; /* Center content vertically */
    }

    .logo {
        text-align: center;
        margin-bottom: 25px; /* More space below logo */
    }

        .logo img {
            width: 100px; /* Smaller logo */
            height: auto;
            opacity: 0.8; /* Slightly faded as in the reference image */
        }

    .title {
        font-size: 28px;
        font-weight: 700;
        text-align: center;
        margin-bottom: 8px; /* Less space below title */
        color: #333;
    }

    .subtitle {
        font-size: 15px;
        color: #555;
        text-align: center;
        margin-bottom: 30px; /* More space below subtitle */
    }

    .input-group {
        position: relative;
        margin-bottom: 20px;
    }

        .input-group i {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #999;
            font-size: 18px;
        }

    input[type="text"],
    input[type="password"] {
        width: 100%;
        padding: 12px 12px 12px 45px; /* Added left padding for icon */
        border: 1px solid #ddd;
        border-radius: 8px;
        font-size: 14px;
        color: #333;
        transition: border-color 0.3s ease, box-shadow 0.3s ease;
    }

        input[type="text"]:focus,
        input[type="password"]:focus {
            border-color: #3646f5; /* Blue border on focus */
            outline: none;
            box-shadow: 0 0 0 2px rgba(54, 70, 245, 0.2); /* Focus glow */
        }

    .checkbox-group {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px; /* More space below checkbox/forgot */
        font-size: 13px;
    }

    .remember-me {
        display: flex;
        align-items: center;
        color: #555;
        font-weight: 500;
    }

        .remember-me input[type="checkbox"] {
            width: auto;
            margin-right: 8px;
            margin-bottom: 0;
            accent-color: #3646f5; /* Blue color for the checkbox */
            transform: scale(1.1); /* Slightly larger checkbox */
        }

    .forgot a {
        color: #3646f5;
        text-decoration: none;
        font-weight: 500;
        transition: color 0.3s ease;
    }

        .forgot a:hover {
            color: #2e3fd9;
        }

    .login-btn {
        width: 100%;
        padding: 14px;
        background-color: #3646f5; /* Solid blue as per image */
        color: #fff;
        border: none;
        border-radius: 25px; /* More rounded */
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        transition: background-color 0.3s ease, box-shadow 0.3s ease;
        box-shadow: 0 4px 15px rgba(54, 70, 245, 0.3); /* Button shadow */
    }

        .login-btn:hover {
            background-color: #2e3fd9;
            box-shadow: 0 6px 20px rgba(54, 70, 245, 0.4);
        }

    /* Right section */
    .login-right {
        flex: 1;
        display: flex;
        justify-content: center;
        padding: 30px;
        border-top-right-radius: 18px;
        border-bottom-right-radius: 18px;
    }

        .login-right img {
            width: 100%;
            max-width: 320px; /* Slightly larger image */
            height: auto; /* Maintain aspect ratio */
            border-radius: 10px;
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1); /* Softer, larger shadow */
        }

    /* Media Queries */
    @@media(max-width: 900px) {
        .login-container {
            flex-direction: column;
            width: 95%; /* Slightly wider on small screens */
            max-width: 500px; /* Limit width for single column layout */
        }

        .login-right {
            border-radius: 0 0 18px 18px; /* Adjust border radius for bottom */
            padding: 20px;
        }

        .login-left {
            padding: 30px 30px; /* Adjust padding for smaller screens */
        }
    }

    @@media(max-width: 500px) {
        .login-left {
            padding: 25px 20px;
        }

        .title {
            font-size: 24px;
        }

        .subtitle {
            font-size: 13px;
        }

        .login-btn {
            padding: 12px;
            font-size: 15px;
        }
    }
</style>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

<div class="radial-bg">
    <div class="login-container">
        <div class="login-left">
            <div class="logo">
                <img src="~/assets/images/sprites/Logo.jpg" style="width:330px; height:auto;" />

            </div>
            <div class="title">Welcome User!</div>
            <div class="subtitle">Please enter login details below</div>
            <form onsubmit="LoginSubmit(event)">
                <div class="input-group">
                    <i class="fas fa-user"></i>
                    <input type="text" id="username" placeholder="Enter Username" required>
                </div>
                <div class="input-group">
                    <i class="fas fa-lock"></i>
                    <input type="password" id="password" placeholder="Enter Password" required>
                </div>
                <div class="checkbox-group">
                    <label class="remember-me">
                        <input type="checkbox" checked> Remember Me
                    </label>
                    <div class="forgot">
                        <a href="#">Forgot Password?</a>
                    </div>
                </div>
                <button type="submit" class="login-btn">LOGIN</button>
            </form>
        </div>
        <div class="login-right">
            <img src="~/assets/images/import.jpg" alt="Login Illustration">
        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>

<script>
    function LoginSubmit(event) {
        event.preventDefault();

        const username = $("#username").val().trim();
        const password = $("#password").val().trim();

        if (!username || !password) {
            Swal.fire({
                toast: true,
                position: 'top-end',
                icon: 'error',
                title: 'Username or Password cannot be empty',
                showConfirmButton: false,
                timer: 2000
            });
            return;
        }

        const data = JSON.stringify({ username, password });

        $.ajax({
            type: "POST",
            url: "/Home/SubmitLogin",
            data: data,
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (response) {
                if (response === "Wrong Username or Password") {

                    Swal.fire({
                        toast: true,
                        position: 'top-end',
                        icon: 'error',
                        title: 'Username or Password is wrong',
                        showConfirmButton: false,
                        timer: 2000
                    });

                } else {

                    Swal.fire({
                        toast: true,
                        position: 'top-end',
                        icon: 'success',
                        title: 'Login Successful!',
                        showConfirmButton: false,
                        timer: 1500
                    }).then(() => {
                        window.location.href = '@Url.Action("Dashboard", "Home")';
                    });
                }
            },
            error: function (err) {
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: 'error',
                    title: err.responseText,
                    showConfirmButton: false,
                    timer: 2000
                });
            }
        });
    }
</script>