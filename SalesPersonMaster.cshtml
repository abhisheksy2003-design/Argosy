        })

    function Save1() {
        debugger
        var SalesPerson_ID1 = $("#SalesPerson_ID1").val();
        if (SalesPerson_ID1 == 'NEW') {
            SalesPerson_ID1 = 0;
        }
        //var SPID = document.getElementById('txtSPCode').value;
        var SPCode = document.getElementById('txtSPCode').value;
        var SPName = document.getElementById('txtSPName').value;
       var Email = document.getElementById('txtEmailIDBank').value;
        var chkIsActive = document.getElementById('chkIsActivee').value;

        if (SPCode == "") {
            document.getElementById("txtSPCode").style.borderColor = "red";
            alert('Please Enter Sales Person Code...')
            event.preventDefault();
            return;
        }

        if (SPName == "") {
            document.getElementById("txtSPName").style.borderColor = "red";
            alert('Please Enter Sales Person Name...')
            event.preventDefault();
            return;
        }


        if (Email == "") {
            document.getElementById("txtEmailIDBank").style.borderColor = "red";
            alert('Please Enter Email...')
            event.preventDefault();
            return;
        }
        if ($('#chkIsActivee').is(":checked")) {
            chkIsActive = true;
        }
        else {
            chkIsActive = false;
        }
        var elements = {};
        elements.SalesPerson_ID1 = SalesPerson_ID1;
        elements.SalesPerson_Code = SPCode;
        elements.SalesPerson_Name = SPName;
        elements.EmailID = Email;
        elements.IsActive = chkIsActive;


        var data = { 'elements': elements };
        data = JSON.stringify(data);
        $.ajax({
            url: "/Master/SaveSalesPersonMaster",
            data: data,
            type: "POST",
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (result) {
            alert('Record saved successfully')
            window.location.href = '@Url.Action("SalesPersonMaster", "Master")';
            },
            error: function (errormessage) {
            alert(errormessage.responseText);
            }
        });
  }

    function ViewSummary() {


        $.ajax({
            url: "/Master/SalesPersonSummary",
            type: "POST",
            data: '',
            contentType: "application/json; charset=utf-8",
            //dataType: "json",
            success: function (response) {
                $("#add").hide();
                $('#summaryList').html(response);

                $('#summaryList').show();
            }
        });



        }
