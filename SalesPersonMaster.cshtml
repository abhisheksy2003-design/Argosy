<div class=" content-area" id="add">
    <div class="page-header" style="margin-top:-13px;">
        <h4>Marketing Person Entry</h4>
        <div class="form-group">
            <label class="form-label"></label>
            <div class="row gutters-xs">
                <div class="col">
                    <button type="button" class="btn btn-added"  id="summarylist" onclick="ViewSummary();">
                       Summary
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="page-body" style="margin-top:-25px;">
        <div class="card col-sm-12 col-lg-12">
            <div class="card-body">
                <div class="row">
                    <div class="col-lg-6 col-sm-12">
                        <div class="form-group">
                            <label class="form-label mandatory">New </label>
                            <div class="row gutters-xs">
                                <div class="col">
                                    <input ID="SalesPerson_ID1" type="text" placeholder="New" readonly="readonly" class="form-control" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-6 col-sm-12">
                        <div class="form-group required">
                            <label class="form-label mandatory">Marketing Person Code</label>
                            <div class="row gutters-xs">
                                <div class="col">
                                    <input id="txtSPCode" placeholder="Enter Marketing Person Code" type="text" class="form-control" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>



                <div class="row">
                    <div class="col-lg-6 col-sm-12">
                        <div class="form-group required">
                            <label class="form-label mandatory">Marketing Person Name</label>
                            <div class="row gutters-xs">
                                <div class="col">
                                    <input id="txtSPName" placeholder="Enter Marketing Person Name" type="text" class="form-control" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-6 col-sm-12">
                        <div class="form-group">
                            <label class="form-label mandatory">Email</label>
                            <div class="row gutters-xs">
                                <div class="col">
                                    @*@Html.EditorFor(model => model.CHACode, new { htmlAttributes = new { @class = "form-control", @id = "chaCode", autocomplete = "off", maxlength = 20 } })*@
                                    <input id="txtEmailIDBank" placeholder="Enter Email ID" type="email" class="form-control" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="row m-2">
                        <div class="col-lg-12 col-xs-12">
                            <div class="form-group">
                                <label class="custom-switch">
                                    <input type="checkbox" name="custom-switch-checkbox" id="chkIsActivee" class="custom-switch-input">
                                    <span class="custom-switch-indicator"></span>
                                    <span class="custom-switch-description">Is Active?</span>
                                </label>
                            </div>
                        </div>
                    </div>
                                 <div class="col d-flex gap-2">
                                    <button class="btn btn-save px-4" id="btnSaveDriver" onclick="Save1();">Save</button>
                                    <button class="btn btn-cancel px-4" type="button" id="clear" onclick="window.location.reload();">
                                        Clear
                                    </button>

                                </div>
                       
                </div>
            </div>
            
                     

                    </div>
                </div>
            </div>

            <div id="summaryList"></div>
            <script>
        $(document).ready(function () {
            var SalesPerson_ID1 = @ViewBag.SalesPerson_ID1;
            var PersonCode = '@ViewBag.SalesPerson_Code';
            var PersonName = '@ViewBag.SalesPerson_Name';
            var EmailID = '@ViewBag.EmailID';

            if (@ViewBag.IsEdit == 1) {

                $("#txtSPCode").val(PersonCode);
                $("#txtSPName").val(PersonName);
                $("#txtEmailIDBank").val(EmailID);
                $("#SalesPerson_ID1").val(SalesPerson_ID1);

                $('#txtSPCode').prop('readonly', true);
                $('#txtSPName').prop('readonly', true);

            }
