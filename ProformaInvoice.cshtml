        var Invoicedate = $("#txtInvoicedate").val();
        var partyid = $("#lblpartyid").val();
        var lblTaxID = $("#ddlGST").val();
        var lblTotal = $("#lblTotal").text();
        var lblCGST = $("#lblCGST").text();
        var lblSGST = $("#lblSGST").text();
        var lblIGST = $("#lblIGST").text();
        var lblAllTotal = $("#lblAllTotal").text();

        var CustomerId = $("#ddlCustomerId").val();
        var CHAId = $("#ddlCHAId").val();
        var ExporterId = $("#ddlExporterId").val();
        var ForwarderId = $("#ddlForwarderId").val();
        
        var data1 = {
            'Invoicedate': Invoicedate, 'partyid': partyid, 'lblTaxID': lblTaxID, 'lblTotal': lblTotal, 'lblCGST': lblCGST, 'lblSGST': lblSGST, 'lblIGST': lblIGST,
            'lblAllTotal': lblAllTotal, 'CustomerId': CustomerId, 'CHAId': CHAId, 'ExporterId': ExporterId, 'ForwarderId': ForwarderId
        };
        var data = JSON.stringify(data1);
                  $.ajax({
                      url: "/BookingEntry/SaveInvoice",
                            data: data,
                            type: "POST",
                            contentType: "application/json; charset=utf-8",
                            dataType: "json",
                              success: function (data) {
                                  //alert(data);
                                 
                                  alert('record saved');

                                  document.location = '@Url.Action("ProformaInvoice", "BookingEntry")';

                            },
                            error: function (errormessage) {
                                alert(errormessage.responseText);
                            }
                        });
    }
    function PrintInvoice(InvoiceNo) {


        var data1 = { 'InvoiceNo': InvoiceNo };
        data = JSON.stringify(data1);

        $.ajax({
            url: '/BookingEntry/PerformaPrint',
            type: 'Post',
            data: data,
            async: false,
            contentType: 'application/json; charset=utf-8',
            success: function (response) {

                var myWindow = window.open("", "MsgWindow1", 'width=' + screen.availWidth + ',height=' + screen.availHeight + ',resizable=no');
                myWindow.close();
                var myWindow = window.open("", "MsgWindow1", 'width=' + screen.availWidth + ',height=' + screen.availHeight + ',resizable=no');
                myWindow.document.write(response);
            },
            error: function (error) {
                let str = error.responseText;
                var a = str.indexOf("<title>") + 7;
                var b = str.indexOf("</title>");
                str = str.substring(a, b);
                alert("Something went wrong: " + str);
            }
        });
    };
    function SumbitInvoice(InvoiceNo, WorkYear, AssessNo) {
        $("#global-loader").fadeOut("slow");

        let text = WorkYear;
        let result = text.trim();

        var data1 = { 'InvoiceNo': InvoiceNo, 'WorkYear': result, 'AssessNo': AssessNo};
        var data = JSON.stringify(data1);
        $.ajax({
            type: "POST",
            url: "/BookingEntry/FinalSaveInvoice",
            data: data,
            contentType: "application/json; charset=utf-8",
            success: function (data) {

                if (data != 0) {
                    alert('record saved');
                    Showdetails();
                }
               
            },
            error: function (response) {
                alert(response.responseText);
                $("#global-loader").fadeOut("slow");
            }
        })
    }
</script>