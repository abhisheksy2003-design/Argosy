    function SearchOn() {

        var Search = $("#ddlSearchOn").val();

        // hide all first
        $("#divIGMNO").hide();
        $("#divitemNo").hide();
        $("#divContainer").hide(); // correct div

        if (Search == "IGM-Item No") {
            $("#divIGMNO").show();
            $("#divitemNo").show();
        }
        else if (Search == "Container") {
            $("#lblSingle").text("Container No");
            $("#txtContainerNo").attr("placeholder", "Container No");
            $("#divContainer").show();
        }
        else if (Search == "BOENo") {
            $("#lblSingle").text("BOE No");
            $("#txtContainerNo").attr("placeholder", "BOE No");
            $("#divContainer").show();
        }
        else if (Search == "BLNumber") {
            $("#lblSingle").text("BL Number");
            $("#txtContainerNo").attr("placeholder", "BL Number");
            $("#divContainer").show();
        }
    }


