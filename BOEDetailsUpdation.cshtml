        function Save() {


         debugger;
         ///ddlentryType


            var AutoID = $("#txthdnAutoID").val() || 0;
             var CHA = $("#ddlCHAId").val();
            var BOENo = $("#txtBOENo").val();
            var BOEDate = $("#txtBOEDate").val();
            var ValidDate = $("#txtValidDate").val();
            var CHAName = $("#ddlCHA").val();

            var DeliveryType = $("#ddlDeliveryType").val();
            var RMS = $("#ddlRMS").val();
            var ScanType = $("#ddlScanType").val();
            var Remarks = $("#txtRemarks").val();
            var Examination = $("#txtExamination").val();

            if (BOENo == "") {
                alert("Please add BOENo.");
                 return false;
            }
            if (CHAName == "") {
                 alert("Please select CHA.");
                 return false;
            }

            //if (DeliveryType == "") {
            //    alert("Please select  Delivery Type");
            //    return false;
            //}
            if (RMS == "") {
                alert("Please select RMS.");
                return false;
            }
            //if (ScanType == "") {
            //    alert("Please select Scan Type.");
            //    return false;
            //}
            var SelectedData = new Array();
            var tablearray = new Array();

            var table = document.getElementById("example2");

            var row;
            for (var i = 1; i < table.rows.length; i++) {

                row = table.rows[i];
                IgmNo = row.cells[0].innerText;
                ItemNo = row.cells[1].innerText;
                Jono = row.cells[2].innerText;
                ContainerNo = row.cells[3].innerText;

                Size = row.cells[4].innerText;
                qty = row.cells[5].innerText;
                Weight = row.cells[6].innerText;


                let ScanTypeSelect = row.cells[7].querySelector('select');
                ScanType = ScanTypeSelect.value;
                let DeliveryTypeSelect = row.cells[8].querySelector('select');
                ContainerDeliveryType = DeliveryTypeSelect.value;
                let ExaminationInput = row.cells[9].querySelector('input');
                Examination = ExaminationInput.value;


                SelectedData.push({
                    'IgmNo': IgmNo, 'ItemNo': ItemNo, 'Jono': Jono, 'ContainerNo': ContainerNo,
                    'Size': Size, 'qty': qty, 'Weight': Weight, 'ScanType': ScanType, 'Examination': Examination, 'DeliveryType': ContainerDeliveryType
                })
            }

            var data1 = {
                'Debitdata': SelectedData, 'AutoID':AutoID,'CHA': CHA,  'BOENo': BOENo, 'BOEDate': BOEDate, 'ValidDate': ValidDate, 'DeliveryType': DeliveryType,
                'RMS': RMS, 'ScanType': ScanType,  'Remarks': Remarks
            };
         var data = JSON.stringify(data1);

                          $.ajax({
                              url: "/BookingEntry/SaveBoeDetails",
                            data: data,
                            type: "POST",
                            contentType: "application/json; charset=utf-8",
                            dataType: "json",
                              success: function (data) {
                                  //alert(data);
                                  $('#btnSave').removeAttr('disabled', 'disabled');


                                  alert(data);

                          document.location = '@Url.Action("BOEDetailsUpdation", "BookingEntry")';


                            },
                            error: function (errormessage) {
                                alert(errormessage.responseText);
                            }
                        });


    }

    function EditBoeDetails(AutoID) {
        debugger;

        $("#Divaddlocation").show();
        $("#DivSummary").hide();

        var data = {
            AutoID: AutoID
        };

        $.ajax({
            url: "/BookingEntry/GetBoeDetailsForEdit",
            type: "POST",
            data: JSON.stringify(data),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (response) {

                var result = JSON.parse(response);

                if (result.length > 0) {

                    var d = result[0];

                    $("#txtBOENo").val(d.BOENo);
                    $("#txthdnAutoID").val(d.AutoID);
                    $("#txtBOEDate").val(formatDate(d.BOEDate));
                    $("#txtValidDate").val(formatDate(d.ValidDate));

                    $("#txtIGMNo").val(d.IGMNo);
                    $("#txtItemNo").val(d.ItemNo);
                    $("#txtContainerNo").val(d.ContainerNo);

                    $("#txtBLNumber").val(d.BLNumber);

                    $("#ddlCHA").val(d.CHAName);
                    $("#ddlCHAId").val(d.CHAID);
                    $("#ddlDeliveryType").val(d.DeliveryType);
                    if (d.RMS === 1 || d.RMS === "1") {
                        $("#ddlRMS").val("1");
                    }
                    else if (d.RMS === 0 || d.RMS === "0") {
                        $("#ddlRMS").val("0");
                    }
                    else {
                        $("#ddlRMS").val("Select");
                    }

                    $("#txtRemarks").val(d.Remarks);

                    $("#ddlSearchOn").val("Container");
                    ShowConIgm();
                }

            },
            error: function (err) {
                alert(err.responseText);
            }
        });
    }

    function formatDate(dateValue) {

        if (!dateValue) return "";

        var date = new Date(dateValue);
        var day = ("0" + date.getDate()).slice(-2);
        var month = ("0" + (date.getMonth() + 1)).slice(-2);
        var year = date.getFullYear();

        return year + "-" + month + "-" + day;
    }

</script>
