<script>

    function ContainerNumberValidation() {
        var pass1 = document.getElementById('ContainerNo');
        //alert(pass1)
        var containerNoVal;
        if (pass1.value.length != 11) {
            alert("Required 11 digits Container No.")
            $("#ContainerNo").removeClass("form-control is-valid state-valid")
            $("#ContainerNo").addClass("form-control is-invalid state-invalid")
            return false;
        }
        else {
            var ContainerNo = $("#ContainerNo").val()
            $.ajax({
                type: 'POST',
                url: '/BookingEntry/ContainerNoValidation',
                data: '{ContainerNo: ' + JSON.stringify(ContainerNo) + '}',
                //data: JSON.stringify(formData),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                async: false,
                success: function (data) {
                    //   alert(JSON.stringify(data))
                    if (JSON.stringify(data) == "false") {
                        // alert("hi")
                        // $("#ContainerNo").val("")
                        $("#ContainerNo").removeClass("form-control is-valid state-valid")
                        $("#ContainerNo").addClass("form-control is-invalid state-invalid")
                        $("#txtContainerNo").val("");
                        containerNoVal = false;
                        //  alert(containerNoVal)
                    }
                    else {
                        $("#ContainerNo").removeClass("form-control is-invalid state-invalid")
                        $("#ContainerNo").addClass("form-control is-valid state-valid")
                        containerNoVal = true;
                    }
                },
                error: function (errormessage) {
                    alert(errormessage.responseText);
                }


            });

            return containerNoVal;
        }
    }

    function CheckDuplicateAndSave() {
        var hdnFileCount = $('#hdnFileCount').val();
        if (hdnFileCount > 0) {
            Swal.fire("Warning", "Manual Container not allowed while download IGM File.", "warning");
            return;
        }

        var containerNo = $("#ContainerNo").val();
        if (containerNo == '' || containerNo.length != 11) {
            Swal.fire("Invalid", "Container No must be 11 characters!", "warning");
            return;
        }

        if (!ContainerNumberValidation()) {
            if (!confirm('Container No Seems to be wrong! Do you want to re-check?')) {
                return;
            }
        }

        if ($("#ddlSize").val() == '') {
            Swal.fire("Warning", "Please select Size.", "warning");
            return;
        }
        if ($("#ddlFL").val() == '') {
            Swal.fire("Warning", "Please select FCL/LCL.", "warning");
            return;
        }
        if ($("#ddlISOCode").val() == '') {
            Swal.fire("Warning", "Please select ISO Code.", "warning");
            return;
        }
        if ($("#ddlCargotype").val() == '') {
            Swal.fire("Warning", "Please select Cargo Type.", "warning");
            return;
        }
        if ($("#ddlCommoditygroup").val() == '') {
            Swal.fire("Warning", "Please select Commodity Group.", "warning");
            return;
        }
        if ($("#ddlJoType").val() == '') {
            Swal.fire("Warning", "Please select Job Order Type.", "warning");
            return;
        }

        var containerNoUpper = containerNo.toUpperCase();
        var data1 = { 'ContainerNo': containerNoUpper };
        var data = JSON.stringify(data1);

        $.ajax({
            type: "POST",
            url: "/BookingEntry/CheckDuplicateContainer",
            data: data,
            contentType: "application/json; charset=utf-8",
            success: function (result) {
                if (typeof result === "string") result = JSON.parse(result);

                if (result == '0') {
                    AddContainerDetailsInTbl();
                } else {
                    Swal.fire("Duplicate", "Container No is already exist", "error");
                }
            },
            error: function () {
                Swal.fire("Error", "Something went wrong while checking container.", "error");
            }
        });
    }

