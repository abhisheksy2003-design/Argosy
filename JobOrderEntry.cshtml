    }
    .file-preview-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.85);
        z-index: 99999; /* 🔥 sabse upar */
        display: none;
        align-items: center;
        justify-content: center;
    }

        .file-preview-overlay img,
        .file-preview-overlay iframe {
            max-width: 90%;
            max-height: 90%;
            background: #fff;
        }

        .file-preview-overlay iframe {
            width: 90%;
            height: 90%;
            border: none;
        }

