                //$('#btnImport').removeAttr('disabled');

            }
        }
    });

    function FetchJobOrderExcelDataByUserID() {
        $.ajax({
            url: '/BookingEntry/GetExportJobOrderExcelDataByUserID',
            type: 'GET',
            success: function (data) {
                if (data && data.length > 0) {
                    $("#containerList").empty();
                    try {
                        DisplayContSize(data);
                    }
                    catch (ex) { }
                    RepTableDataJson($("#containerList"), data, "Container Details", "ContainerDetails_List");
                    //-=======Display Total Container Details with Teus

                }
            },
            error: function (xhr, status, error) {
                console.error("Fetch failed", error);
            }
        });
    }


    function UploadJobOrderExcel() {
        const fileInput = document.getElementById("fileInput");
        const selectedFile = fileInput.files[0];

        if (!selectedFile) {
            Swal.fire({
                icon: 'warning',
                title: 'No File Selected',
                text: 'Please select an Excel file.'
            });
            return;
        }

        const formData = new FormData();
        formData.append("excelFile", selectedFile);

        $.ajax({
            url: '/BookingEntry/UploadJobOrderExcel',
            type: 'POST',
            data: formData,
            contentType: false,
            processData: false,
            success: function (response) {
                if (response.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Success',
                        text: response.message
                    }).then(() => {

                        FetchJobOrderExcelDataByUserID();
                    });
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: response.message
                    });
                }
            },
            error: function (xhr, status, error) {
                console.error("Upload failed", error);
                Swal.fire({
                    icon: 'error',
                    title: 'Upload Failed',
                    text: 'Something went wrong while uploading the file.'
                });
            }
        });
    }

    function DisplayContSize(table) {
        debugger;
        //var Count20Size = document.getElementById('Count20Size');
        //var Count40Size = document.getElementById('Count40Size');
        //var Count45Size = document.getElementById('Count45Size');
        //var TotalTeus = document.getElementById('TotalTeus');
        var totCount20 = 0;
        var totCount40 = 0;
        var totCount45 = 0;
        var totTeus = 0;

        try {
            $.each(table, function (k, v) {
                //debugger;
                if (v.Size != '') {
                    if (v.Size == '20') {
                        totCount20 = totCount20 + 1;
                    }
                    else if (v.Size == '40') {
                        totCount40 = totCount40 + 1;
                    }
                    else if (v.Size == '45') {
                        totCount45 = totCount45 + 1;
                    }

                    if (v.Size == '40' || v.Size == '45') {
                        totTeus = totTeus + 2;
                    }
                    else {
                        totTeus = totTeus + 1;
                    }
                }
            });

            $('#Count20Size').val(totCount20);
            $('#Count40Size').val(totCount40);
            $('#Count45Size').val(totCount45);
            $('#TotalTeus').val(totTeus);
        }
        catch (ex) { }
    };

    var jobOrderFiles = [];

function previewJobOrderFiles(input) {

    jobOrderFiles = Array.from(input.files);
    renderJobOrderPreview();
}

function renderJobOrderPreview() {

    var preview = $("#jobOrderPreview");
    preview.html("");

    jobOrderFiles.forEach(function (file, index) {

        var ext = file.name.split('.').pop().toLowerCase();
        var thumb = $("<div class='eir-thumb'></div>");

        var removeBtn = $("<div class='eir-remove'>×</div>");
        removeBtn.on("click", function (e) {
            e.stopPropagation();
            removeJobOrderFile(index);
        });

        thumb.append(removeBtn);

        // IMAGE
        if (["jpg", "jpeg", "png"].includes(ext)) {

            var reader = new FileReader();
            reader.onload = function (e) {

                var img = $("<img />");
                img.attr("src", e.target.result);

                img.on("click", function () {
                    openPreviewModal(e.target.result, "image");
                });

                thumb.append(img);
            };
            reader.readAsDataURL(file);
        }
        // PDF
        else if (ext === "pdf") {

            var reader = new FileReader();
            reader.onload = function (e) {

                var pdfDiv = $("<div class='eir-pdf'>PDF</div>");
                pdfDiv.on("click", function () {
                    openPreviewModal(e.target.result, "pdf");
                });

                thumb.append(pdfDiv);
            };
            reader.readAsDataURL(file);
        }

        preview.append(thumb);
    });
}

function removeJobOrderFile(index) {

    jobOrderFiles.splice(index, 1);

    var dt = new DataTransfer();
    jobOrderFiles.forEach(f => dt.items.add(f));

    document.getElementById("jobOrderAttachment").files = dt.files;

    renderJobOrderPreview();
}
function openPreviewModal(src, type) {

    $("#overlayImg").hide();
    $("#overlayPdf").hide();

    if (type === "image") {
        $("#overlayImg").attr("src", src).show();
    } else {
        $("#overlayPdf").attr("src", src).show();
    }

    $("#filePreviewOverlay").fadeIn();
}
function closeFilePreview() {

    $("#filePreviewOverlay").fadeOut();
    $("#overlayImg").attr("src", "");
    $("#overlayPdf").attr("src", "");
}

