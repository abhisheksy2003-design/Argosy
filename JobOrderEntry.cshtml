<Script>
    function showModal(JobNo) {

        $('#txtJobNoDoc').val(JobNo);
        $('#myModal').modal('show');
        FetchAttachmentTableData(JobNo);
    }

    function closeModal() {
        $('#myModal').modal('hide');
    }
    function CargoTypeChange() {

        var cargotype = $("#ddlCargotype option:selected")
            .text()
            .trim()
            .toUpperCase();

        console.log("Cargo Type:", cargotype);

        if (cargotype === "REF") {
            $("#dvREF").show();
            $("#dvHAZ").hide();
            $("#dvOT").hide();
        }
        else if (cargotype === "REF-HAZ") {
            $("#dvREF").show();
            $("#dvHAZ").show();
            $("#dvOT").hide();
        }
        else if (cargotype === "HAZ" || cargotype === "TANK-HAZ" || cargotype === "OT IN GAUGE HAZ") {
            $("#dvREF").hide();
            $("#dvHAZ").show();
            $("#dvOT").hide();
        }
        else if (cargotype === "ODC-HAZ" || cargotype === "OT OUT GAUGE HAZ") {
            $("#dvREF").hide();
            $("#dvHAZ").show();
            $("#dvOT").show();
        }
        else if (cargotype === "ODC" || cargotype === "OT OUT GAUGE") {
            $("#dvREF").hide();
            $("#dvHAZ").hide();
            $("#dvOT").show();
        }
        else {
            $("#dvREF").hide();
            $("#dvHAZ").hide();
            $("#dvOT").hide();
        }
    }

    function UploadAttachment() {

    var fileInput = document.getElementById('jobOrderAttachment');
    var jobNo = $('#txtJobNoDoc').val();
    var docType = $('#ddlDocType').val();

    if (fileInput.files.length === 0) {
        Swal.fire("Warning", "Please select a file.", "warning");
        return;
    }

    var formData = new FormData();
    formData.append('JobNo', jobNo);
    formData.append('DocType', docType);
    formData.append('UploadedFile', fileInput.files[0]);

    $.ajax({
        url: '/BookingEntry/UploadJobOrderDocument',
        type: 'POST',
        data: formData,
        contentType: false,
        processData: false,
        success: function (response) {

            if (response.success === true) {

                Swal.fire({
                    icon: 'success',
                    title: 'Upload Successful',
                    text: 'File uploaded successfully',
                    timer: 2000,
                    showConfirmButton: false
                });

                // Table refresh
                FetchAttachmentTableData(response.JoNo);

                // File input reset
                $('#jobOrderAttachment').val('');

            } else {
                Swal.fire("Error", response.message || "Upload failed", "error");
            }
        },
        error: function () {
            Swal.fire("Error", "Something went wrong while uploading.", "error");
        }
    });
}


    function DowloadAttachment(id, jobNo) {

        window.location.href =
            "/BookingEntry/DownloadJobOrderAttachment?id=" + id + "&jobNo=" + jobNo;
    }


    function FetchAttachmentTableData(JoNo) {

        data1 = { 'JoNo': JoNo };
        data = JSON.stringify(data1);

        $.ajax({
            type: 'POST',
            url: '/BookingEntry/FetchAttachmentTableData',
            data: data,
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            async: true,
            success: function (jsonResult) {

                $("#tblJobOrderAttachments").empty();
                RepTableDataJson($("#tblJobOrderAttachments"), jsonResult, "Voucher Details", "VoucherDetails_List");
            },
            error: function (errormessage) {
                alert(errormessage.responseText);
                $("#global-loader").fadeOut("slow");
            }
        });

    }

</Script>

