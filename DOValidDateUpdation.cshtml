                            };
                        }))
                    },
                    error: function (response) {
                        alert(response.responseText);
                    },
                    failure: function (response) {
                        alert(response.responseText);
                    }
                })
            },
            select: function (e, i) {
                //debugger;
                $("#ddlShippingLine").val(i.item.label);
                $("#ddlLineId").val(i.item.val);
            },
            minLength: 1
        });

    };

    function SearchOn() {

        var Search = $("#ddlSearchOn").val();

        // hide all first
        $("#divIGMNO").hide();
        $("#divitemNo").hide();
        $("#divSingle").hide();

        if (Search == "IGM-Item No") {
            $("#divIGMNO").show();
            $("#divitemNo").show();
            $("#divContainer").hide();

        }
        else if (Search == "Container") {
            $("#lblSingle").text("Container No");
            $("#txtSingle").attr("placeholder", "Container No");
            $("#divContainer").show();
        }
        else if (Search == "BOENo") {
            $("#lblSingle").text("BOE No");
            $("#txtSingle").attr("placeholder", "BOE No");
            $("#divContainer").show();
        }
        else if (Search == "BLNumber") {
            $("#lblSingle").text("BL Number");
            $("#txtSingle").attr("placeholder", "BL Number");
            $("#divContainer").show();
        }
        else if (Search == "Select")
        {
            $("#divIGMNO").hide()
            $("#divitemNo").hide()
            $("#divContainer").hide()
        }
    }

