    function AutomCom() {
        debugger;

        $("#ddlCHA1").autocomplete({
            source: function (request, response) {
                $.ajax({
                    url: "/BookingEntry/getCHAName",
                    data: "{ 'prefixText': '" + request.term + "'}",
                    dataType: "json",
                    type: "POST",
                    contentType: "application/json; charset=utf-8",
                    success: function (data) {
                        //debugger;
                        response($.map(data, function (item) {
                            //debugger;
                            return {
                                label: item.AGName,
                                val: item.AGID,
                            };
                        }))
                    },
                    error: function (response) {
                        alert(response.responseText);
                    },
                    failure: function (response) {
                        alert(response.responseText);
                    }
                })
            },
            select: function (e, i) {
                //debugger;
                $("#ddlCHA").val(i.item.label);
                $("#ddlCHAId").val(i.item.val);
            },
            minLength: 1
        });

    };

    function AutoShipLine() {
        debugger;

        $("#ddlShippingLine1").autocomplete({
            source: function (request, response) {
                $.ajax({
                    url: "/BookingEntry/getShippingLine",
                    data: "{ 'prefixText': '" + request.term + "'}",
                    dataType: "json",
                    type: "POST",
                    contentType: "application/json; charset=utf-8",
