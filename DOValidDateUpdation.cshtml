    function ShowConIgm() {

        GetDODetails();

        $("#global-loader").fadeOut("slow");

        var IGMNo = $("#txtIGMNo").val();
        var ItemNo = $("#txtItemNo").val();
        var ContainerNo = $("#txtContainerNo").val();
        var data1 = { 'IGMNo': IGMNo, 'ItemNo': ItemNo, 'ContainerNo': ContainerNo };
        var data = JSON.stringify(data1);
        $.ajax({
            type: "POST",
            url: "/BookingEntry/GetDetailsDODateCon",
            data: data,
            contentType: "application/json; charset=utf-8",
            success: function (data) {

                $("#example2").empty();
                RepTableDataJsonwopaging($("#example2"), data, "Voucher Details", "VoucherDetails_List");

                $("#global-loader").fadeOut("slow");
            },
            error: function (response) {
                alert(response.responseText);
                $("#global-loader").fadeOut("slow");
            }
        })
    }

    function GetDODetails() {

        $("#global-loader").fadeOut("slow");

        var IGMNo = $("#txtIGMNo").val();
        var ItemNo = $("#txtItemNo").val();
        var ContainerNo = $("#txtContainerNo").val();
        var data1 = { 'IGMNo': IGMNo, 'ItemNo': ItemNo, 'ContainerNo': ContainerNo };
        var data = JSON.stringify(data1);
        $.ajax({
            type: "POST",
            url: "/BookingEntry/GetDetailsDODate",
            data: data,
            contentType: "application/json; charset=utf-8",
            success: function (data) {
                console.log(data);
                $("#txtBLNumber").val(data.BLNumber);
                $("#ddlShippingLine").val(data.SLID);
                $("#txtBOENo").val(data.BOENo);
                $("#txtBOEDate").val(data.BOEDate);

                //let boeDate = new Date(data.BOEDate).toISOString().split("T")[0];
                //$("#txtBOEDate").val(boeDate).prop("readonly", true);

                $("#ddlCHA").val(data.CHAName);
                //$("#ddlDeliveryType").val(data.DeliveryType);
                //$("#ddlRMS").val(data.RMS);
                $("#txtRemarks").val(data.Remarks);


                $("#global-loader").fadeOut("slow");
            },
            error: function (response) {
                alert(response.responseText);
                $("#global-loader").fadeOut("slow");
            }
        })
    }


    function UpdateValidDate() {
        
        var ValidDate = $("#txtValidDate").val();
        //let date = new Date(ValidDate);
        //let formatted = date.toISOString().slice(0, 10);
        var SelectedData = [];

        var table = document.getElementById("example2");

        for (var i = 1; i < table.rows.length; i++) {

            var row = table.rows[i];

            //var IgmNo = row.cells[0].innerText.trim();
            //var ItemNo = row.cells[1].innerText.trim();
            var Jono = row.cells[2].innerText.trim();
            var ContainerNo = row.cells[3].innerText.trim();

            SelectedData.push({
                //'IgmNo': IgmNo,
                //'ItemNo': ItemNo,
                'Jono': Jono,
                'ContainerNo': ContainerNo
            });
        }

        var data1 = {
            'Debitdata': SelectedData,
            'ValidDate': ValidDate
        };

        $.ajax({
            url: "/BookingEntry/UpdateValidDate",
            type: "POST",
            data: JSON.stringify(data1),
            contentType: "application/json",
            success: function (data) {
                alert(data);
            },
            error: function (err) {
                alert(err.responseText);
            }
        });
    }



