<script>
    var pkgTypeList = [];

    @foreach (var item in (IEnumerable<SelectListItem>)ViewBag.PackageIGMList)
    {
        <text>
            pkgTypeList.push({
                value: '@item.Value',
                text: '@item.Text'
            });
        </text>
    }

    function buildPkgTypeDropdown(selectedValue) {
        var html = '<select class="form-select ddlPkgType">';
        html += '<option value="">--Select--</option>';

        $.each(pkgTypeList, function (i, item) {
            var selected = (item.value == selectedValue) ? 'selected' : '';
            html += '<option value="' + item.value + '" ' + selected + '>' + item.text + '</option>';
        });

        html += '</select>';
        return html;
    }
</script>


